{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "web/sites/default/files/**",
      "web/sites/default/files/styles/**",
      ".git/**"
    ]
  },
  "permission": {
    "edit": "allow",
    "bash": "allow"
  }
}
