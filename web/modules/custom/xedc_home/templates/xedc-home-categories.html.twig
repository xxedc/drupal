{#
  图片分类标签：只显示术语名称，不显示内容数量。
  cat.url 为术语别名（Pathauto）。
  手机端默认两行，超出由 home-hero.js 在右侧显示「更多」；PC 始终全部展示。
#}
{% if categories %}
{{ attach_library('xedc/home') }}
<section class="xedc-section xedc-tax" data-xedc-tax aria-label="图片分类">
  <div class="xedc-tax__list">
    {% for cat in categories %}
      <a class="xedc-tax__chip" href="{{ cat.url }}">{{ cat.name }}</a>
    {% endfor %}
  </div>
  <button type="button" class="xedc-tax__more" aria-expanded="false">更多</button>
</section>
{% endif %}
