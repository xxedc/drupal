<div class="xt xt-index" data-xt-index>
  <nav class="xt-crumb" aria-label="面包屑">
    <ol>
      <li><a href="{{ home_url }}">首页</a></li>
      <li aria-current="page">标签</li>
    </ol>
  </nav>

  <header class="xt-head">
    <div>
      <h1 class="xt-title">全部标签</h1>
      <p class="xt-sub">共 <b>{{ total_tags }}</b> 个标签，<b>{{ total_items }}</b> 组内容</p>
    </div>
  </header>

  <div class="xt-toolbar">
    <label class="xt-search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" placeholder="搜索标签" autocomplete="off" aria-label="搜索标签">
    </label>
    <div class="xt-seg" role="group" aria-label="排序">
      <button type="button" class="is-active" data-sort="hot">热门</button>
      <button type="button" data-sort="new">最新</button>
      <button type="button" data-sort="name">名称</button>
    </div>
  </div>

  <ul class="xt-tags">
    {% for t in tags %}
      <li data-name="{{ t.name|lower }}" data-count="{{ t.count }}" data-latest="{{ t.latest }}">
        <a class="xt-tag" href="{{ t.url }}">
          <span class="xt-tag-row">
            <span class="xt-tag-name"><i>#</i>{{ t.name }}</span>
            <span class="xt-tag-count">{{ t.count }}</span>
          </span>
          <span class="xt-bar"><i style="width: {{ t.pct }}%"></i></span>
        </a>
      </li>
    {% endfor %}
  </ul>

  <div class="xt-more-wrap" hidden><button type="button" class="xt-more"></button></div>

  <div class="xt-empty" hidden>没有匹配的标签，换个关键词试试</div>
</div>
