/**
 * Implements hook_form_node_form_alter().
 */
function xedc_member_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $current_user = \Drupal::currentUser();
  if ($current_user->hasPermission('administer nodes')) {
    return;
  }
  if (!\Drupal::moduleHandler()->moduleExists('content_moderation')) {
    return;
  }
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\Core\Entity\EntityFormInterface) {
    return;
  }
  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || !in_array($node->bundle(), FavoriteManager::ALLOWED_BUNDLES, TRUE)) {
    return;
  }

  foreach (['advanced', 'options', 'status', 'uid', 'created', 'revision_log', 'path', 'menu', 'field_views', 'field_published_at', 'field_show_cover'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }

  $weights = [
    'photo' => [
      'title' => 0,
      'field_images' => 10,
      'field_cover_image' => 20,
      'field_summary' => 30,
      'field_categories' => 40,
      'field_tags' => 50,
      'field_model' => 60,
      'moderation_state' => 80,
    ],
    'video' => [
      'title' => 0,
      'field_video_file' => 10,
      'field_video_cover' => 20,
      'field_body' => 30,
      'field_categories' => 40,
      'field_tags' => 50,
      'field_video_url' => 60,
      'field_duration' => 70,
      'moderation_state' => 80,
    ],
    'article' => [
      'title' => 0,
      'field_cover' => 10,
      'field_summary' => 20,
      'field_body' => 30,
      'field_categories' => 40,
      'field_tags' => 50,
      'field_author' => 60,
      'field_source' => 70,
      'field_source_url' => 80,
      'moderation_state' => 90,
    ],
  ];
  foreach ($weights[$node->bundle()] as $field_name => $weight) {
    if (isset($form[$field_name])) {
      $form[$field_name]['#weight'] = $weight;
    }
  }
  if (isset($form['actions'])) {
    $form['actions']['#weight'] = 100;
  }

  $own_only = xedc_member_media_library_is_restricted() ? t('仅显示自己上传的文件') : '';
  $media_hints = [
    'field_images' => $own_only,
    'field_cover_image' => $own_only !== '' ? t('可选封面。@hint', ['@hint' => $own_only]) : t('可选封面'),
    'field_video_file' => $own_only !== '' ? t('支持 MP4。@hint', ['@hint' => $own_only]) : t('支持 MP4'),
    'field_video_cover' => $own_only !== '' ? t('可选封面。@hint', ['@hint' => $own_only]) : t('可选封面'),
    'field_cover' => $own_only !== '' ? t('可选封面。@hint', ['@hint' => $own_only]) : t('可选封面'),
  ];
  foreach ($media_hints as $field_name => $hint) {
    if (isset($form[$field_name]['widget']) && is_array($form[$field_name]['widget'])) {
      xedc_member_prepare_media_widget($form[$field_name]['widget'], (string) $hint);
    }
  }
  if (isset($form['field_video_url']['widget'][0])) {
    $form['field_video_url']['widget'][0]['#description'] = t('可选');
  }
  if (isset($form['field_duration']['widget'][0])) {
    $form['field_duration']['widget'][0]['#description'] = t('可选，单位为秒');
  }
  if (isset($form['field_body'])) {
    xedc_member_simplify_text_format($form['field_body']);
  }
  if (isset($form['moderation_state'])) {
    xedc_member_translate_moderation_widget($form['moderation_state'], $node->isNew());
  }
  $form['#after_build'][] = 'xedc_member_submission_moderation_default';

  $form['#attributes']['class'][] = 'xm-submission-form';
  $form['#attributes']['class'][] = 'xm-submission-form--' . $node->bundle();
  $form['#attached']['library'][] = 'xedc_member/member';
}

/**
 * Limits the media library picker copy and explains whose files are listed.
 */
function xedc_member_prepare_media_widget(array &$widget, string $hint): void {
  $widget['#attributes']['class'][] = 'xm-media-widget';
  if (isset($widget['#field_prefix']['empty_selection'])) {
    $widget['#field_prefix']['empty_selection']['#markup'] = t('还没有选择文件。');
    $widget['#field_prefix']['empty_selection']['#prefix'] = '<p class="xm-media-empty">';
    $widget['#field_prefix']['empty_selection']['#suffix'] = '</p>';
  }
  if (isset($widget['open_button'])) {
    $widget['open_button']['#value'] = t('添加媒体');
    $widget['open_button']['#attributes']['class'][] = 'xm-media-open';
  }
  if (isset($widget['#field_prefix']['weight_toggle']['#value'])) {
    $widget['#field_prefix']['weight_toggle']['#value'] = t('调整顺序');
  }
  if (isset($widget['selection']) && is_array($widget['selection'])) {
    foreach ($widget['selection'] as &$item) {
      if (is_array($item) && isset($item['remove_button'])) {
        $item['remove_button']['#value'] = t('移除');
      }
    }
    unset($item);
  }
  $widget['#description'] = $hint;
}

/**
 * Hides the long text-format help under member submission fields.
 */
function xedc_member_simplify_text_format(array &$element): void {
  if (isset($element['format']) && is_array($element['format'])) {
    foreach (['guidelines', 'help'] as $key) {
      if (isset($element['format'][$key])) {
        $element['format'][$key]['#access'] = FALSE;
      }
    }
    if (isset($element['format']['format']['#title'])) {
      $element['format']['format']['#title'] = t('文本格式');
    }
  }
  foreach ($element as $key => &$child) {
    if ((!is_int($key) && !(is_string($key) && !str_starts_with($key, '#'))) || !is_array($child)) {
      continue;
    }
    xedc_member_simplify_text_format($child);
  }
}

/**
 * Replaces the English moderation widget labels on member submission forms.
 */
function xedc_member_translate_moderation_widget(array &$element, bool $is_new): void {
  if (isset($element['current']['#title'])) {
    $element['current']['#title'] = t('当前状态');
  }
  if (isset($element['state']['#title'])) {
    $element['state']['#title'] = $is_new ? t('保存为') : t('变更为');
    $element['state']['#description'] = $is_new
      ? t('提交后进入待审核，也可以先保存为草稿。')
      : t('可先保存草稿。');
  }
  if (isset($element['#title']) && (isset($element['current']) || isset($element['state']))) {
    $element['#title'] = t('审核状态');
  }
  elseif (isset($element['#title']) && !isset($element['current']) && !isset($element['state'])) {
    $title = trim((string) $element['#title']);
    if ($title !== '' && preg_match('/moderation state|^state$|^save as$|^change to$|^current state$/i', $title)) {
      $element['#title'] = t('审核状态');
    }
  }
  foreach ($element as $key => &$child) {
    if ((!is_int($key) && !(is_string($key) && !str_starts_with($key, '#'))) || !is_array($child)) {
      continue;
    }
    xedc_member_translate_moderation_widget($child, $is_new);
  }
}

/**
 * Defaults a new member submission to needs-review.
 */
function xedc_member_submission_moderation_default(array $form, FormStateInterface $form_state): array {
  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer nodes') || $account->hasPermission('use xedc_editorial transition publish')) {
    return $form;
  }
  $input = $form_state->getUserInput();
  if ($form_state->isSubmitted() || isset($input['moderation_state'])) {
    return $form;
  }
  $state = &$form['moderation_state']['widget'][0]['state'];
  if (!is_array($state) || empty($state['#options']['needs_review'])) {
    return $form;
  }
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof \Drupal\Core\Entity\EntityFormInterface) {
    return $form;
  }
  $node = $form_object->getEntity();
  if (!$node instanceof NodeInterface || !$node->isNew()) {
    return $form;
  }
  $state['#default_value'] = 'needs_review';
  $state['#value'] = 'needs_review';
  return $form;
}

/**
 * Implements hook_node_presave().
 *
 * Members can save a draft or submit for review. They cannot publish.
 */
function xedc_member_node_presave(NodeInterface $node): void {
  if (!in_array($node->bundle(), FavoriteManager::ALLOWED_BUNDLES, TRUE) || !$node->hasField('moderation_state')) {
    return;
  }
  $account = \Drupal::currentUser();
  // Cron and other anonymous saves must not rewrite an existing state.
  if ($account->isAnonymous() || $account->hasPermission('administer nodes') || $account->hasPermission('use xedc_editorial transition publish')) {
    return;
  }
  if ((string) $node->get('moderation_state')->value === 'published') {
    $node->set('moderation_state', 'needs_review');
  }
}

/**
 * Implements hook_form_alter() for member media forms and comment notices.
 */
function xedc_member_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $media_forms = [
    'media_image_add_form',
    'media_image_edit_form',
    'media_video_add_form',
    'media_video_edit_form',
  ];
  if (in_array($form_id, $media_forms, TRUE) && !\Drupal::currentUser()->hasPermission('administer media')) {
    foreach (['status', 'uid', 'created', 'revision', 'revision_log_message', 'path', 'menu'] as $key) {
      if (isset($form[$key])) {
        $form[$key]['#access'] = FALSE;
      }
    }
    if (in_array($form_id, ['media_video_add_form', 'media_video_edit_form'], TRUE) && isset($form['field_media_video_file']['widget'][0])) {
      $form['field_media_video_file']['widget'][0]['#element_validate'][] = 'xedc_member_validate_video_mime';
    }
  }
  if (xedc_member_should_quiet_status()) {
    xedc_member_attach_status_drop($form);
  }
  if ($form_id === 'media_library_add_form_upload') {
    if (isset($form['container']['upload']['#title'])) {
      $form['container']['upload']['#title'] = t('上传文件');
    }
    if (xedc_member_media_library_is_restricted()) {
      $form['xedc_media_hint'] = [
        '#type' => 'html_tag',
        '#tag' => 'p',
        '#value' => t('仅显示自己上传的文件'),
        '#attributes' => ['class' => ['xm-media-hint']],
        '#weight' => -50,
      ];
    }
    $extensions = $form['container']['upload']['#upload_validators']['FileExtension']['extensions'] ?? '';
    if (is_string($extensions) && str_contains($extensions, 'mp4') && !\Drupal::currentUser()->hasPermission('administer media')) {
      $form['container']['upload']['#element_validate'][] = 'xedc_member_validate_video_mime';
    }
  }
}

/**
 * Validates that an uploaded MP4 file really contains MP4 video data.
 */
function xedc_member_validate_video_mime(array &$element, FormStateInterface $form_state) {
  $value = $element['#value'] ?? [];
  $fids = [];
  if (is_array($value) && isset($value['fids']) && is_array($value['fids'])) {
    $fids = $value['fids'];
  }
  elseif (is_array($value)) {
    $fids = $value;
  }
  foreach ($fids as $fid) {
    if (!is_numeric($fid) || (int) $fid <= 0) {
      continue;
    }
    $file = \Drupal\file\Entity\File::load((int) $fid);
    if (!$file) {
      continue;
    }
    $realpath = \Drupal::service('file_system')->realpath($file->getFileUri());
    if (!$realpath || !is_readable($realpath)) {
      continue;
    }
    try {
      $mime = (new \finfo(FILEINFO_MIME_TYPE))->file($realpath) ?: '';
    }
    catch (\Throwable $e) {
      continue;
    }
    if ($mime === '' || $mime === 'application/octet-stream' || str_starts_with($mime, 'video/') || $mime === 'application/mp4') {
      continue;
    }
    $form_state->setError($element, t('请上传 MP4 视频。'));
    return;
  }
}

/**
 * Implements hook_form_user_form_alter().
 */
function xedc_member_form_user_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if (\Drupal::routeMatch()->getRouteName() !== 'xedc_member.security') {
    return;
  }

  // Keep only the email/password parts of the core account form on this page.
  $form['account']['name']['#access'] = FALSE;
  foreach (['timezone', 'language', 'user_picture', 'roles', 'path', 'contact', 'matomo', 'field_xedc_nickname', 'field_xedc_bio'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
  if (isset($form['account']['mail'])) {
    $form['account']['mail']['#weight'] = 0;
    $form['account']['mail']['#title'] = t('邮箱');
    $form['account']['mail']['#description'] = t('不会公开');
  }
  if (isset($form['account']['current_pass'])) {
    $form['account']['current_pass']['#weight'] = 10;
    $form['account']['current_pass']['#title'] = t('当前密码');
    $form['account']['current_pass']['#description'] = t('修改邮箱或密码时填写');
  }
  if (isset($form['account']['pass'])) {
    $form['account']['pass']['#weight'] = 20;
    $form['account']['pass']['#description'] = '';
    $form['account']['pass']['#after_build'][] = 'xedc_member_password_confirm_after_build';
  }
  if (isset($form['actions']['delete'])) {
    $form['actions']['delete']['#access'] = FALSE;
  }
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = t('保存');
    $form['actions']['submit']['#submit'][] = 'xedc_member_user_form_redirect';
  }
  $form['#after_build'][] = 'xedc_member_security_form_after_build';
  $form['#validate'][] = 'xedc_member_security_form_validate';
  $form['#attributes']['class'][] = 'xm-security-form';
}

/**
 * Hides tracking and other account sections after later alters have run.
 */
function xedc_member_security_form_after_build(array $form, FormStateInterface $form_state) {
  if (\Drupal::routeMatch()->getRouteName() !== 'xedc_member.security') {
    return $form;
  }
  foreach (['timezone', 'language', 'user_picture', 'roles', 'path', 'contact', 'matomo', 'field_xedc_nickname', 'field_xedc_bio'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
  foreach ($form as $key => &$element) {
    if (!is_array($element) || str_starts_with((string) $key, '#')) {
      continue;
    }
    $title = isset($element['#title']) ? (string) $element['#title'] : '';
    if ($title !== '' && preg_match('/matomo|piwik/i', $title)) {
      $element['#access'] = FALSE;
    }
  }
  return $form;
}

/**
 * Translates the password strength widget on the member security form.
 */
function xedc_member_password_confirm_after_build(array $element, FormStateInterface $form_state) {
  if (\Drupal::routeMatch()->getRouteName() !== 'xedc_member.security') {
    return $element;
  }
  if (isset($element['pass1'])) {
    $element['pass1']['#title'] = t('新密码');
    $element['pass1']['#description'] = t('留空则不修改');
  }
  if (isset($element['pass2'])) {
    $element['pass2']['#title'] = t('确认新密码');
  }
  $element['#element_validate'] = ['xedc_member_password_confirm_validate'];
  $existing = $element['#attached']['drupalSettings']['password'] ?? [];
  $element['#attached']['drupalSettings']['password'] = [
    'confirmTitle' => (string) t('两次密码是否一致：'),
    'confirmSuccess' => (string) t('一致'),
    'confirmFailure' => (string) t('不一致'),
    'strengthTitle' => '',
    'hasWeaknesses' => '',
    'tooShort' => (string) t('再长一些'),
    'addLowerCase' => (string) t('加入小写字母'),
    'addUpperCase' => (string) t('加入大写字母'),
    'addNumbers' => (string) t('加入数字'),
    'addPunctuation' => (string) t('加入标点'),
    'sameAsUsername' => (string) t('不要与用户名相同'),
    'weak' => (string) t('弱'),
    'fair' => (string) t('中'),
    'good' => (string) t('强'),
    'strong' => (string) t('强'),
  ] + $existing;
  return $element;
}

/**
 * Validates the member security password pair and keeps the stored value flat.
 */
function xedc_member_password_confirm_validate(array &$element, FormStateInterface $form_state, array &$complete_form) {
  $pass1 = trim((string) ($element['pass1']['#value'] ?? ''));
  $pass2 = trim((string) ($element['pass2']['#value'] ?? ''));
  if ($pass1 !== '' || $pass2 !== '') {
    if ($pass1 !== $pass2) {
      $form_state->setError($element, t('两次输入的新密码不一致。'));
    }
  }
  elseif (!empty($element['#required']) && $form_state->getUserInput()) {
    $form_state->setError($element, t('请填写新密码。'));
  }
  $form_state->setValueForElement($element['pass1'], NULL);
  $form_state->setValueForElement($element['pass2'], NULL);
  $form_state->setValueForElement($element, $pass1);
}

/**
 * Rewrites leftover English account-form errors on the security page.
 */
function xedc_member_security_form_validate(array &$form, FormStateInterface $form_state) {
  $errors = $form_state->getErrors();
  if (!$errors) {
    return;
  }
  $rebuilt = [];
  $changed = FALSE;
  foreach ($errors as $name => $message) {
    $text = trim(strip_tags((string) $message));
    if (preg_match('/current password is missing or incorrect/i', $text)) {
      $rebuilt[$name] = t('修改邮箱或密码需要填写正确的当前密码。');
      $changed = TRUE;
    }
    elseif (preg_match('/passwords do not match|password field is required/i', $text)) {
      $rebuilt[$name] = str_contains(strtolower($text), 'match')
        ? t('两次输入的新密码不一致。')
        : t('请填写新密码。');
      $changed = TRUE;
    }
    else {
      $rebuilt[$name] = $message;
    }
  }
  if (!$changed) {
    return;
  }
  $form_state->clearErrors();
  foreach ($rebuilt as $name => $message) {
    $form_state->setErrorByName($name, $message);
  }
}

/**
 * Redirects the embedded core account form back to the member center.
 */
function xedc_member_user_form_redirect(array &$form, FormStateInterface $form_state) {
  \Drupal::messenger()->deleteByType('status');
  $form_state->setRedirect('xedc_member.security');
}

/**
 * Drops success messages from submit buttons on frontend forms.
 */
function xedc_member_attach_status_drop(array &$form): void {
  // Keep this on the form. A button-level #submit replaces the form handler,
  // so the profile, favorite and history actions would never run.
  $form['#submit'][] = 'xedc_member_drop_status_message';
}

/**
 * Removes status messages after a successful frontend submit.
 */
function xedc_member_drop_status_message(array &$form, FormStateInterface $form_state): void {
  if ($form_state->hasAnyErrors()) {
    return;
  }
  \Drupal::messenger()->deleteByType('status');
}

/**
 * Whether frontend success banners should stay hidden.
 *
 * Password reset, registration and the contact form keep their status text,
 * because that text is the only confirmation those pages provide.
 */
function xedc_member_should_quiet_status(): bool {
  $route = (string) \Drupal::routeMatch()->getRouteName();
  if ($route === 'user.login' || $route === 'user.register' || $route === 'user.pass' || str_starts_with($route, 'user.reset')) {
    return FALSE;
  }
  if ($route === 'contact.site_page' || $route === 'entity.contact_form.canonical') {
    return FALSE;
  }
  $account = \Drupal::currentUser();
  $member_editor = $account->isAuthenticated()
    && !$account->hasPermission('administer nodes')
    && !$account->hasPermission('administer media');
  if ($member_editor && (
    str_starts_with($route, 'entity.node.')
    || str_starts_with($route, 'node.add')
    || str_starts_with($route, 'media_library.')
    || str_starts_with($route, 'entity.media.')
    || str_starts_with($route, 'entity.comment.')
  )) {
    return TRUE;
  }
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return FALSE;
  }
  return TRUE;
}

/**
 * Implements hook_preprocess_status_messages().
 */
function xedc_member_preprocess_status_messages(array &$variables): void {
  if (!xedc_member_should_quiet_status()) {
    return;
  }
  unset($variables['message_list']['status']);
}

/**
 * Implements hook_page_attachments().
 */
function xedc_member_page_attachments(array &$attachments): void {
  if (!xedc_member_should_quiet_status()) {
    return;
  }
  $attachments['#attached']['library'][] = 'xedc_member/quiet';
  $attachments['#cache']['contexts'][] = 'route';
  $attachments['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Implements hook_preprocess_page().
 */
function xedc_member_preprocess_page(array &$variables) {
  // The header switches login links and the account icon. The icon itself
  // varies by user and is a placeholder, so the page stays cacheable.
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';
  $variables['member_account_icon'] = [
    '#lazy_builder' => ['xedc_member.lazy_builders:accountIcon', []],
    '#create_placeholder' => TRUE,
  ];
  $variables['member_account_sheet'] = [
    '#lazy_builder' => ['xedc_member.lazy_builders:accountSheet', []],
    '#create_placeholder' => TRUE,
  ];
}

/**
 * Builds a small circular avatar URL for the site header.
 */
function xedc_member_avatar_url(int $uid): string {
  $user = User::load($uid);
  if (!$user || !$user->hasField('user_picture') || $user->get('user_picture')->isEmpty()) {
    return '';
  }
  $file = $user->get('user_picture')->entity;
  if (!$file instanceof FileInterface) {
    return '';
  }
  $uri = $file->getFileUri();
  $style = ImageStyle::load('thumbnail') ?: ImageStyle::load('max_325x325');
  if ($style) {
    return $style->buildUrl($uri);
  }
  return \Drupal::service('file_url_generator')->generateString($uri);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function xedc_member_form_user_login_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form['#submit'][] = 'xedc_member_user_login_redirect';
}

/**
 * Sends a successful login to the member center unless a destination is set.
 */
function xedc_member_user_login_redirect(array &$form, FormStateInterface $form_state) {
  $request = \Drupal::request();
  $destination = $request->query->get('destination') ?: $request->request->get('destination');
  if (is_string($destination) && $destination !== '') {
    $path = parse_url($destination, PHP_URL_PATH);
    $path = is_string($path) && $path !== '' ? $path : $destination;
    if (!preg_match('#^/user(?:/\d+)?/?$#', $path)) {
      return;
    }
  }
  $form_state->setRedirectUrl(Url::fromRoute('xedc_member.overview'));
}

/**
 * Implements hook_ENTITY_TYPE_insert() for path_alias.
 */
function xedc_member_path_alias_insert(EntityInterface $entity) {
  xedc_member_alias_cache_clear($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for path_alias.
 */
function xedc_member_path_alias_update(EntityInterface $entity) {
  xedc_member_alias_cache_clear($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for path_alias.
 */
function xedc_member_path_alias_delete(EntityInterface $entity) {
  xedc_member_alias_cache_clear($entity);
}

/**
 * Drops cached vanity paths when a user alias changes.
 */
function xedc_member_alias_cache_clear(EntityInterface $entity): void {
  $path = method_exists($entity, 'getPath') ? (string) $entity->getPath() : '';
  if (preg_match('#^/user/(\d+)$#', $path, $matches)) {
    Cache::invalidateTags(['user:' . $matches[1], 'xedc_member:aliases']);
  }
}

/**
 * Implements hook_preprocess_html().
 */
function xedc_member_preprocess_html(array &$variables) {
  $route = \Drupal::routeMatch()->getRouteName();
  if (xedc_member_should_quiet_status()) {
    $variables['attributes']['class'][] = 'xm-quiet-status';
  }
  if (is_string($route) && str_starts_with($route, 'xedc_member.')) {
    $variables['attributes']['class'][] = 'xm-page';
    if ($route === 'xedc_member.history_clear') {
      $variables['attributes']['class'][] = 'xm-page--confirm';
    }
  }
  $variables['#cache']['contexts'][] = 'route';
  $variables['#cache']['contexts'][] = 'user.permissions';
}

/**
 * Implements hook_page_attachments_alter().
 */
function xedc_member_page_attachments_alter(array &$attachments) {
  $route = \Drupal::routeMatch()->getRouteName();
  $private_routes = [
    'user.page',
    'user.edit',
    'entity.user.canonical',
    'entity.user.edit_form',
  ];
  $is_member = is_string($route) && str_starts_with($route, 'xedc_member.');
  if ($is_member || in_array($route, $private_routes, TRUE)) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [
          'name' => 'robots',
          'content' => 'noindex, nofollow, noarchive',
        ],
      ],
      'xedc_member_robots',
    ];
    $attachments['#cache']['contexts'][] = 'route';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function xedc_member_preprocess_node(array &$variables) {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  if (!in_array($node->bundle(), FavoriteManager::ALLOWED_BUNDLES, TRUE) || !$node->isPublished()) {
    return;
  }

  $variables['xedc_member_favorite'] = [
    '#lazy_builder' => ['xedc_member.lazy_builders:favorite', [(string) $node->id()]],
    '#create_placeholder' => TRUE,
  ];
  $variables['#attached']['library'][] = 'xedc_member/member';
  $variables['#cache']['tags'][] = 'node:' . $node->id();
}

/**
 * Implements hook_views_query_alter().
 *
 * Member submission pickers must not list media owned by other users.
 */
function xedc_member_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'media_library' || $view->current_display === 'page') {
    return;
  }
  $view->element['#cache']['contexts'][] = 'user';
  if (!xedc_member_media_library_is_restricted() || !method_exists($query, 'addWhere')) {
    return;
  }
  if (isset($view->display_handler)) {
    $view->display_handler->setOption('cache', [
      'type' => 'none',
      'options' => [],
    ]);
  }
  $query->addWhere(0, 'media_field_data.uid', (int) \Drupal::currentUser()->id(), '=');
}

/**
 * Whether the current account should only see media they uploaded.
 */
function xedc_member_media_library_is_restricted(): bool {
  $account = \Drupal::currentUser();
  if (!$account->isAuthenticated()) {
    return FALSE;
  }
  foreach ([
    'administer media',
    'administer nodes',
    'edit any media',
    'update any media',
    'edit any image media',
    'edit any video media',
  ] as $permission) {
    if ($account->hasPermission($permission)) {
      return FALSE;
    }
  }
  return TRUE;
}

/**
 * Implements hook_cron().
 */
function xedc_member_cron() {
  $deleted = \Drupal::service('xedc_member.history_manager')->purgeExpired();
  if ($deleted > 0) {
    \Drupal::logger('xedc_member')->notice('Purged @count expired browsing history rows.', [
      '@count' => $deleted,
    ]);
  }
}

/**
 * Implements hook_entity_delete().
 */
function xedc_member_entity_delete(EntityInterface $entity) {
  $favorite_manager = \Drupal::service('xedc_member.favorite_manager');
  $history_manager = \Drupal::service('xedc_member.history_manager');
  if ($entity->getEntityTypeId() === 'node') {
    $favorite_manager->deleteForEntity('node', (int) $entity->id());
    $history_manager->deleteForEntity('node', (int) $entity->id());
  }
  elseif ($entity->getEntityTypeId() === 'user') {
    $favorite_manager->deleteForUser((int) $entity->id());
    $history_manager->deleteForUser((int) $entity->id());
  }
}
