<header class="xm-head">
  <div>
    <h1 class="xm-title">会员中心</h1>
    <p class="xm-sub">欢迎回来，{{ account.name }}</p>
  </div>
  <a class="xm-btn xm-btn--primary" href="{{ urls.profile }}">编辑资料</a>
</header>

<div class="xm-stats">
  <a class="xm-stat" href="{{ urls.favorites }}">
    <b>{{ stats.favorites }}</b>
    <span>我的收藏</span>
  </a>
  <a class="xm-stat" href="{{ urls.comments }}">
    <b>{{ stats.comments }}</b>
    <span>我的评论</span>
  </a>
  <a class="xm-stat" href="{{ urls.submissions }}">
    <b>{{ stats.submissions }}</b>
    <span>我的投稿</span>
  </a>
  <a class="xm-stat" href="{{ urls.history }}">
    <b>{{ stats.history }}</b>
    <span>浏览历史</span>
  </a>
</div>

<section class="xm-panel">
  <div class="xm-panel__head">
    <h2>最近收藏</h2>
    <a href="{{ urls.favorites }}">查看全部</a>
  </div>

  {% if recent_favorites %}
    <div class="xm-grid">
      {% for card in recent_favorites %}
        {% include '@xedc_member/templates/xedc-member-card.html.twig' with {card: card} %}
      {% endfor %}
    </div>
  {% else %}
    <div class="xm-empty">
      <strong>还没有收藏内容</strong>
      <p>在美图、视频或文章详情页点击“收藏”，内容会出现在这里。</p>
      <div class="xm-empty__links">
        <a href="/meitu">看看美图</a>
        <a href="/video">看看视频</a>
        <a href="/articles">看看文章</a>
      </div>
    </div>
  {% endif %}
</section>
