<header class="xm-head">
  <div>
    <h1 class="xm-title">{{ '我的评论'|t }}</h1>
    <p class="xm-sub">{{ '共 @count 条评论'|t({'@count': total}) }}</p>
  </div>
</header>

{% if items %}
  <div class="xm-comment-list">
    {% for item in items %}
      <article class="xm-comment-card">
        <div class="xm-comment-card__head">
          <span class="xm-badge xm-badge--{{ item.status_id }}">{{ item.status_label }}</span>
          <time>{{ item.created }}</time>
        </div>
        <div class="xm-comment-card__body">{{ item.body }}</div>
        <div class="xm-comment-card__meta">
          {% if item.parent_url %}
            <a href="{{ item.parent_url }}">{{ item.parent_title }}</a>
          {% else %}
            <span>{{ item.parent_title }}</span>
          {% endif %}
          <span class="xm-comment-card__actions">
            {% if item.comment_url %}<a href="{{ item.comment_url }}">{{ '查看评论'|t }}</a>{% endif %}
            {% if item.edit_url %}<a href="{{ item.edit_url }}">{{ '编辑'|t }}</a>{% endif %}
          </span>
        </div>
      </article>
    {% endfor %}
  </div>
  {{ pager }}
{% else %}
  <div class="xm-empty">
    <strong>{{ empty }}</strong>
    <p>{{ '在内容页留言后，会出现在这里，也可以从这里回到原文。'|t }}</p>
    <div class="xm-empty__links">
      <a href="{{ path('view.image_gallery.page_1') }}">{{ '看看美图'|t }}</a>
      <a href="{{ path('view.video_list.page_1') }}">{{ '看看视频'|t }}</a>
      <a href="{{ path('view.article_list.page_1') }}">{{ '看看文章'|t }}</a>
    </div>
  </div>
{% endif %}
