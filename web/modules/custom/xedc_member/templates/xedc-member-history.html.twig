<header class="xm-head">
  <div>
    <h1 class="xm-title">{{ '浏览历史'|t }}</h1>
    <p class="xm-sub">{{ '共 @count 条记录'|t({'@count': total}) }}</p>
  </div>
  {% if total %}
    <a class="xm-btn xm-btn--danger" href="{{ urls.history_clear }}">{{ '清空历史'|t }}</a>
  {% endif %}
</header>

{% if not enabled %}
  <div class="xm-notice">
    <strong>{{ '浏览历史记录已关闭'|t }}</strong>
    <span>{{ '关闭后不会记录新的浏览行为。已有记录仍会保留，可以在这里删除单条记录或清空全部。'|t }}</span>
    <a href="{{ urls.security }}">{{ '去开启'|t }}</a>
  </div>
{% endif %}

<nav class="xm-tabs" aria-label="{{ '浏览历史筛选'|t }}">
  {% for filter in filters %}
    <a href="{{ filter.url }}" class="xm-tab{% if filter.active %} is-active{% endif %}"{% if filter.active %} aria-current="page"{% endif %}>{{ filter.label }}</a>
  {% endfor %}
</nav>

{% if items %}
  <div class="xm-grid">
    {% for card in items %}
      {% include '@xedc_member/templates/xedc-member-card.html.twig' with {card: card} %}
    {% endfor %}
  </div>
  {% if pager %}
    <div class="xm-pager">{{ pager }}</div>
  {% endif %}
{% else %}
  <div class="xm-empty">
    <strong>{{ empty }}</strong>
    <p>{{ '打开美图、视频或文章后，浏览记录会自动出现在这里。'|t }}</p>
    <div class="xm-empty__links">
      <a href="{{ path('view.image_gallery.page_1') }}">{{ '看看美图'|t }}</a>
      <a href="{{ path('view.video_list.page_1') }}">{{ '看看视频'|t }}</a>
      <a href="{{ path('view.article_list.page_1') }}">{{ '看看文章'|t }}</a>
    </div>
  </div>
{% endif %}
