<div class="xm">
  <aside class="xm-side">
    <a class="xm-user" href="{{ urls.profile }}">
      <span class="xm-avatar">{% if avatar %}{{ avatar }}{% else %}{{ account.initial }}{% endif %}</span>
      <span class="xm-user-info">
        <strong class="xm-user-name">{{ account.name }}</strong>
        <span class="xm-user-mail">{{ account.mail }}</span>
        <span class="xm-user-since">加入于 {{ account.member_since }}</span>
      </span>
    </a>

    <nav class="xm-nav" aria-label="会员中心导航">
      {% for item in nav %}
        <a href="{{ item.url }}" class="xm-nav__item{% if item.key == active %} is-active{% endif %}"{% if item.key == active %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>

    <div class="xm-side-foot">
      <a href="{{ urls.profile }}">个人资料</a>
      <a href="{{ urls.security }}">账户安全</a>
      <a href="{{ urls.settings }}">账号设置</a>
      <a href="{{ urls.logout }}">退出登录</a>
    </div>
  </aside>

  <div class="xm-main">
    {{ content }}
  </div>
</div>
