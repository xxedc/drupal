<header class="xm-head">
  <div>
    <h1 class="xm-title">我的收藏</h1>
    <p class="xm-sub">共 {{ total }} 个收藏</p>
  </div>
</header>

<nav class="xm-tabs" aria-label="收藏筛选">
  {% for filter in filters %}
    <a href="{{ filter.url }}" class="xm-tab{% if filter.active %} is-active{% endif %}"{% if filter.active %} aria-current="page"{% endif %}>{{ filter.label }}</a>
  {% endfor %}
</nav>

{% if cards %}
  <div class="xm-grid">
    {% for card in cards %}
      {% include '@xedc_member/templates/xedc-member-card.html.twig' with {card: card} %}
    {% endfor %}
  </div>
  {{ pager }}
{% else %}
  <div class="xm-empty">
    <strong>{{ empty }}</strong>
    <p>打开内容详情页，点击“收藏”，之后可以在这里回看。</p>
    <div class="xm-empty__links">
      <a href="/meitu">看看美图</a>
      <a href="/video">看看视频</a>
      <a href="/articles">看看文章</a>
    </div>
  </div>
{% endif %}
