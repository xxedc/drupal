<header class="xm-head">
  <div>
    <h1 class="xm-title">{{ '我的投稿'|t }}</h1>
    <p class="xm-sub">{{ '共 @count 篇投稿'|t({'@count': total}) }}</p>
  </div>
</header>

{% if create_links %}
  <div class="xm-submit-actions">
    {% for link in create_links %}
      <a class="xm-btn xm-btn--primary" href="{{ link.url }}">{{ link.label }}</a>
    {% endfor %}
  </div>
{% endif %}

{% if items %}
  <div class="xm-submission-list">
    {% for item in items %}
      <article class="xm-submission-card">
        <div class="xm-submission-card__head">
          <span class="xm-badge xm-badge--{{ item.state_id }}">{{ item.state_label }}</span>
          <span class="xm-submission-card__type">{{ item.type_label }}</span>
          <time>{{ item.changed }}</time>
        </div>
        <h2 class="xm-submission-card__title">{{ item.title }}</h2>
        {% if item.review_note %}
          <div class="xm-review-note">
            <strong>{{ '审核意见'|t }}</strong>
            <p>{{ item.review_note }}</p>
          </div>
        {% endif %}
        {% if item.edit_url or item.view_url %}
          <div class="xm-submission-card__actions">
            {% if item.edit_url %}<a href="{{ item.edit_url }}">{{ '编辑 / 提交审核'|t }}</a>{% endif %}
            {% if item.view_url %}<a href="{{ item.view_url }}">{{ '查看已发布内容'|t }}</a>{% endif %}
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </div>
  {{ pager }}
{% else %}
  <div class="xm-empty">
    <strong>{{ empty }}</strong>
    <p>{{ '从上方选择一种内容开始写，可以先存成草稿。'|t }}</p>
    {% if create_links %}
      <div class="xm-empty__links">
        {% for link in create_links %}
          <a href="{{ link.url }}">{{ link.label }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
