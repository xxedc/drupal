<header class="xm-head">
  <div>
    <h1 class="xm-title">{{ '账户安全'|t }}</h1>
    <p class="xm-sub">{{ '修改邮箱或密码需要验证当前密码。'|t }}</p>
  </div>
</header>

<div class="xm-security">
  <section class="xm-panel">
    <h2 class="xm-security__label">{{ '账户信息'|t }}</h2>
    <dl class="xm-account">
      <div><dt>{{ '用户名'|t }}</dt><dd>{{ account.username }}</dd></div>
      <div><dt>{{ '邮箱'|t }}</dt><dd>{{ account.mail }}</dd></div>
      <div><dt>{{ '注册时间'|t }}</dt><dd>{{ account.member_since }}</dd></div>
      <div><dt>{{ '最近登录'|t }}</dt><dd>{{ account.last_login }}</dd></div>
    </dl>
    {{ form }}
  </section>

  <section class="xm-panel">
    <div class="xm-panel__head">
      <h2>{{ '浏览历史'|t }}</h2>
      <a href="{{ urls.history }}">{{ '查看记录'|t }}</a>
    </div>
    {{ history_form }}
  </section>

  <ul class="xm-links">
    <li>
      <a href="{{ urls.logout }}">
        <span><b>{{ '退出登录'|t }}</b><small>{{ '退出后需要重新登录'|t }}</small></span>
        <span class="xm-links__arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></svg></span>
      </a>
    </li>
  </ul>
</div>
