<?php

/**
 * @file
 * Scheduled publishing helpers for DcLili content.
 */

declare(strict_types=1);

use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\RevisionLogInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\node\NodeInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function xedc_scheduler_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (empty($form['publish_on']) || (isset($form['publish_on']['#access']) && $form['publish_on']['#access'] === FALSE)) {
    return;
  }
  if (isset($form['scheduler_settings'])) {
    $form['scheduler_settings']['#title'] = t('定时发布');
    $form['scheduler_settings']['#open'] = TRUE;
  }
  if (!isset($form['publish_on']['widget'][0]['value'])) {
    return;
  }

  $timezone = (string) (\Drupal::config('system.date')->get('timezone.default') ?: 'Asia/Shanghai');
  $zone = new DateTimeZone($timezone);
  $tomorrow = new DateTimeImmutable('tomorrow', $zone);
  // Scheduler stores a UTC unix timestamp. The datetime widget otherwise uses
  // the account timezone (admin is UTC), so a Shanghai clock time was saved
  // eight hours late and cron did not see it as due. Always edit this field
  // in the site timezone, matching the "明天" button.
  $widget = &$form['publish_on']['widget'][0]['value'];
  $widget['#date_timezone'] = $timezone;
  if (($widget['#default_value'] ?? NULL) instanceof \Drupal\Core\Datetime\DrupalDateTime) {
    $widget['#default_value']->setTimezone($zone);
  }
  $widget['#title'] = t('发布日期和时间');
  $widget['#description'] = t('点「明天」填入明天 08:00（网站时区 @timezone）。日期和时间都按网站时区计算，与账号时区无关。留空表示不定时。保存后在发布时间到达前，原文和译文都保持未发布；到点后由 cron 一并发布。', [
    '@timezone' => $timezone,
  ]);
  $entity = $form_state->getFormObject()->getEntity();
  $group = $form['publish_on']['#group'] ?? NULL;
  if ($entity instanceof ContentEntityInterface && !$entity->get('publish_on')->isEmpty() && is_string($group)) {
    $clock = (new DateTimeImmutable('@' . (int) $entity->get('publish_on')->value))
      ->setTimezone($zone)
      ->format('H:i');
    $form[$group]['#attached']['drupalSettings']['schedulerHideSecondsPublishOn'] = $clock;
  }
  $form['publish_on']['widget'][0]['tomorrow'] = [
    '#type' => 'inline_template',
    '#template' => '<button type="button" class="button button--small xedc-scheduler-tomorrow">{{ label }}</button>',
    '#context' => [
      'label' => t('明天'),
    ],
    '#weight' => 10,
  ];
  $form['#attached']['library'][] = 'xedc_scheduler/tomorrow';
  $form['#attached']['drupalSettings']['xedcScheduler'] = [
    'date' => $tomorrow->format('Y-m-d'),
    'time' => '08:00',
  ];
}

/**
 * Implements hook_module_implements_alter().
 *
 * Run after Scheduler and content moderation so a future publish_on cannot be
 * turned back into a published state later in the same save.
 */
function xedc_scheduler_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook === 'entity_presave' && isset($implementations['xedc_scheduler'])) {
    $group = $implementations['xedc_scheduler'];
    unset($implementations['xedc_scheduler']);
    $implementations['xedc_scheduler'] = $group;
  }
}

/**
 * Implements hook_entity_presave().
 *
 * A future schedule keeps every translation unpublished. A published
 * moderation state is put back to the workflow default (draft) so the editor
 * does not show the node as already published.
 */
function xedc_scheduler_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof NodeInterface || !$entity->hasField('publish_on')) {
    return;
  }
  if (!_xedc_scheduler_publishing_enabled($entity)) {
    return;
  }
  $schedule = _xedc_scheduler_effective_schedule($entity);
  if ($schedule <= \Drupal::time()->getRequestTime()) {
    return;
  }
  _xedc_scheduler_hold($entity, $schedule);
}

/**
 * Implements hook_scheduler_publish_process().
 *
 * Scheduler publishes one translation at a time and moderated nodes ignore
 * the core publish action. Publish every translation together, or hold a
 * translation whose source language is still waiting.
 */
function xedc_scheduler_scheduler_publish_process(EntityInterface $entity): int {
  if (!$entity instanceof NodeInterface || !$entity->hasField('publish_on')) {
    return 0;
  }
  $source = $entity->getUntranslated();
  $id = (string) $source->id();
  $handled = &drupal_static(__FUNCTION__, []);
  if (isset($handled[$id])) {
    return 1;
  }

  $now = \Drupal::time()->getRequestTime();
  $source_on = (int) ($source->get('publish_on')->value ?? 0);
  if ($entity->language()->getId() !== $source->language()->getId() && $source_on > $now) {
    _xedc_scheduler_hold($source, $source_on);
    try {
      $source->save();
    }
    catch (\Throwable $e) {
      \Drupal::logger('xedc_scheduler')->error('定时发布 @title 失败：@message', [
        '@title' => $source->label(),
        '@message' => $e->getMessage(),
      ]);
      return -1;
    }
    $handled[$id] = TRUE;
    return 1;
  }

  $result = _xedc_scheduler_publish_translations($source);
  if ($result === 1) {
    $handled[$id] = TRUE;
  }
  return $result;
}

/**
 * Whether this node bundle uses Scheduler publishing.
 */
function _xedc_scheduler_publishing_enabled(NodeInterface $node): bool {
  $enabled = \Drupal::service('scheduler.manager')->getEnabledTypes($node->getEntityTypeId(), 'publish');
  return in_array($node->bundle(), $enabled, TRUE);
}

/**
 * Timestamp that should hold this save, or 0 when nothing is pending.
 *
 * The source language wins while it still has a future time, so an older
 * translation schedule cannot publish the node early.
 */
function _xedc_scheduler_effective_schedule(NodeInterface $entity): int {
  $source = $entity->getUntranslated();
  $now = \Drupal::time()->getRequestTime();
  $source_on = (int) ($source->get('publish_on')->value ?? 0);
  $active_on = (int) ($entity->get('publish_on')->value ?? 0);
  if ($entity->language()->getId() !== $source->language()->getId() && $source_on > $now) {
    return $source_on;
  }
  return $active_on;
}

/**
 * Keeps the node and all translations unpublished until $schedule.
 */
function _xedc_scheduler_hold(NodeInterface $entity, int $schedule): void {
  $source = $entity->getUntranslated();
  if ($source->hasField('moderation_state') && \Drupal::moduleHandler()->moduleExists('content_moderation')) {
    $moderation_info = \Drupal::service('content_moderation.moderation_information');
    if ($moderation_info->isModeratedEntity($source)) {
      $plugin = $moderation_info->getWorkflowForEntity($source)->getTypePlugin();
      $current = (string) $source->get('moderation_state')->value;
      if ($current !== '' && $plugin->hasState($current) && $plugin->getState($current)->isPublishedState()) {
        $target = (string) ($plugin->getConfiguration()['default_moderation_state'] ?? 'draft');
        if ($plugin->hasState($target) && !$plugin->getState($target)->isPublishedState()) {
          $source->set('moderation_state', $target);
        }
      }
    }
  }
  foreach ($source->getTranslationLanguages() as $language) {
    $translation = $source->getTranslation($language->getId());
    $translation->setUnpublished();
    $translation->set('publish_on', $schedule);
    if (!$translation->isNew()) {
      $translation->setRevisionTranslationAffected(TRUE);
    }
  }
  $source->isDefaultRevision(TRUE);
}

/**
 * Publishes every translation of a node and clears publish_on.
 */
function _xedc_scheduler_publish_translations(NodeInterface $source): int {
  $moderated = FALSE;
  $plugin = NULL;
  $target = NULL;
  $current = '';
  if ($source->hasField('moderation_state') && \Drupal::moduleHandler()->moduleExists('content_moderation')) {
    $moderation_info = \Drupal::service('content_moderation.moderation_information');
    if ($moderation_info->isModeratedEntity($source)) {
      $moderated = TRUE;
      $plugin = $moderation_info->getWorkflowForEntity($source)->getTypePlugin();
      foreach ($plugin->getStates() as $state) {
        if ($state->isPublishedState()) {
          $target = $state->id();
          break;
        }
      }
      if ($target === NULL) {
        return 0;
      }
      $current = (string) $source->get('moderation_state')->value;
      if ($current !== $target && ($current === '' || !$plugin->hasState($current) || !$plugin->getState($current)->canTransitionTo($target))) {
        \Drupal::logger('xedc_scheduler')->error('无法定时发布 @title（@bundle @id）：状态「@state」不能转到已发布。', [
          '@title' => $source->label(),
          '@bundle' => $source->bundle(),
          '@id' => $source->id(),
          '@state' => $current,
        ]);
        return -1;
      }
    }
  }

  $account_switcher = NULL;
  if ($moderated) {
    $admin = _xedc_scheduler_publish_account();
    if (!$admin) {
      \Drupal::logger('xedc_scheduler')->error('找不到可执行发布转换的用户，已跳过 @title。', [
        '@title' => $source->label(),
      ]);
      return -1;
    }
    $account_switcher = \Drupal::service('account_switcher');
    $account_switcher->switchTo($admin);
  }

  try {
    foreach ($source->getTranslationLanguages() as $language) {
      $translation = $source->getTranslation($language->getId());
      $translation->set('publish_on', NULL);
      $translation->setPublished();
      if (!$translation->isNew()) {
        $translation->setRevisionTranslationAffected(TRUE);
      }
    }
    if ($moderated && $current !== $target) {
      $source->set('moderation_state', $target);
    }
    if ($source instanceof RevisionLogInterface) {
      $source->setRevisionLogMessage((string) new TranslatableMarkup('由定时发布自动发布。'));
      $source->setRevisionUserId((int) $source->getOwnerId());
      $source->setRevisionCreationTime(\Drupal::time()->getRequestTime());
    }
    $source->isDefaultRevision(TRUE);
    $source->save();
  }
  catch (\Throwable $e) {
    if ($moderated && $current !== '') {
      $source->set('moderation_state', $current);
    }
    \Drupal::logger('xedc_scheduler')->error('定时发布 @title 失败：@message', [
      '@title' => $source->label(),
      '@message' => $e->getMessage(),
    ]);
    return -1;
  }
  finally {
    if ($account_switcher) {
      $account_switcher->switchBack();
    }
  }
  return 1;
}

/**
 * Returns an active account that may apply moderation transitions during cron.
 */
function _xedc_scheduler_publish_account(): ?UserInterface {
  $storage = \Drupal::entityTypeManager()->getStorage('user');
  $account = $storage->load(1);
  if ($account instanceof UserInterface && $account->isActive()) {
    return $account;
  }
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('roles', 'administrator')
    ->condition('status', 1)
    ->range(0, 1)
    ->execute();
  $account = $ids ? $storage->load((int) reset($ids)) : NULL;
  return $account instanceof UserInterface && $account->isActive() ? $account : NULL;
}
