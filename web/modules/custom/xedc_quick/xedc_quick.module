<?php

/**
 * 返回一组媒体 ID 的原图总字节数（没有记录的返回 0）。
 */
function xedc_quick_original_size(array $mids): int {
  return \Drupal::service('xedc_quick.store')->originalSize($mids);
}

function xedc_quick_original_sizes(array $mids): array {
  return \Drupal::service('xedc_quick.store')->originalSizes($mids);
}

/**
 * Creates the hash and original-size tables once.
 *
 * Upload used to run CREATE TABLE on the request path. After the tables
 * exist, later requests only read a state flag.
 */
function xedc_quick_ensure_tables(): void {
  \Drupal::service('xedc_quick.store')->ensureTables();
}
