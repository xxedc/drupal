.xedc-meta{--m-fg:#18181b;--m-muted:#71717a;--m-border:#e4e4e7;--m-bg:#f4f4f5;--m-accent:#2563eb;margin:.75rem 0 1.25rem;font-size:.875rem;line-height:1.5;color:var(--m-muted)}
[data-bs-theme=dark] .xedc-meta{--m-fg:#fafafa;--m-muted:#a1a1aa;--m-border:#3f3f46;--m-bg:#27272a;--m-accent:#60a5fa}
.xedc-meta__stats{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem 1rem}
.xedc-meta__stat{display:inline-flex;align-items:center;gap:.35rem;font-size:.8125rem;color:var(--m-muted)}
.xedc-meta__stat svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
.xedc-meta__info{margin-top:.875rem;padding-top:.875rem;border-top:1px solid var(--m-border);display:grid;gap:.625rem}
.xedc-meta__row{display:flex;align-items:baseline;gap:.75rem}
.xedc-meta__label{flex:none;width:2rem;font-size:.8125rem;color:var(--m-muted)}
.xedc-meta__values{display:flex;flex-wrap:wrap;gap:.375rem}
.xedc-meta__model{display:inline-flex;align-items:center;padding:.125rem .625rem;border-radius:.375rem;background:var(--m-bg);color:var(--m-fg);font-size:.8125rem;font-weight:600;text-decoration:none;transition:background .15s}
.xedc-meta__tag{display:inline-flex;align-items:center;padding:.125rem .25rem;color:var(--m-accent);font-size:.8125rem;font-weight:500;text-decoration:none}
.xedc-meta__model:hover{background:var(--m-border);color:var(--m-fg)}
.xedc-meta__tag:hover{text-decoration:underline;color:var(--m-accent)}
@media(max-width:640px){.xedc-meta__stats{gap:.25rem .875rem}}

.img-detail__head{border-bottom:0!important;padding-bottom:0!important}
.img-detail__side > *:not(.img-detail__head){border-top:0!important}
.img-detail__side .comment-wrapper,.img-detail__side .comments,.img-detail__side form,.img-detail__side .field--name-field-comment{border-top:0!important}
