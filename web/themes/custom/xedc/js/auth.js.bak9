/* XEDC 登录弹窗：<dialog> + 同源 iframe（预加载，点击即显示） */
(function () {
  'use strict';

  var LOGIN_RE = /\/user\/login\/?$/;
  var STALE_MS = 20 * 60 * 1000;
  var inEmbed = window.self !== window.top;
  var dialog = null;
  var frame = null;
  var pendingDest = '';
  var loads = 0;
  var loadedUrl = '';
  var loadedAt = 0;

  if (inEmbed) {
    // 弹窗内的链接都在顶层窗口打开
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href]');
      if (a && a.getAttribute('href').charAt(0) !== '#') { a.target = '_top'; }
    }, true);
  }

  function embedUrl(a) {
    var u = new URL(a.href, location.href);
    var dest = u.searchParams.get('destination');
    if (!dest) {
      dest = location.pathname + location.search + location.hash;
      u.searchParams.set('destination', dest);
    }
    pendingDest = dest;
    u.searchParams.set('xedc_embed', '1');
    return u.toString();
  }

  function goBack() {
    var t;
    try { t = new URL(pendingDest || (location.pathname + location.search + location.hash), location.origin); }
    catch (err) { t = new URL(location.href); }
    if (t.origin !== location.origin) { t = new URL(location.href); }
    if (t.pathname + t.search === location.pathname + location.search) {
      if (t.hash) { location.hash = t.hash; }
      location.reload();
    } else {
      location.assign(t.toString());
    }
  }

  function setUrl(url) {
    loads = 0;
    loadedUrl = url;
    loadedAt = Date.now();
    frame.src = url;
  }

  function fit() {
    if (!dialog || !dialog.open) { return; }
    try {
      var body = frame.contentDocument && frame.contentDocument.body;
      if (!body) { return; }
      var h = Math.ceil(body.getBoundingClientRect().height);
      if (h > 120) { frame.style.height = Math.min(h, Math.floor(window.innerHeight * 0.92)) + 'px'; }
    } catch (err) {}
  }

  function build() {
    if (dialog) { return; }
    dialog = document.createElement('dialog');
    dialog.className = 'xedc-login-dialog';
    dialog.setAttribute('aria-label', '登录');

    var close = document.createElement('button');
    close.type = 'button';
    close.className = 'xedc-login-dialog__close';
    close.setAttribute('aria-label', '关闭');
    close.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';

    frame = document.createElement('iframe');
    frame.title = '登录';

    var done = document.createElement('div');
    done.className = 'xedc-login-dialog__done';
    done.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>登录成功</span>';

    dialog.appendChild(close);
    dialog.appendChild(frame);
    dialog.appendChild(done);
    document.body.appendChild(dialog);

    close.addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) { dialog.close(); } });
    dialog.addEventListener('close', function () {
      dialog.classList.remove('is-done');
      document.documentElement.classList.remove('xedc-dialog-open');
      // 关闭后在后台重置表单（清掉已输入的密码和错误提示），下次打开仍然是即时的
      if (loadedUrl) { setUrl(loadedUrl); }
    });
    frame.addEventListener('load', onFrameLoad);
  }

  function onFrameLoad() {
    var loc;
    try { loc = frame.contentWindow.location; } catch (err) { return; }
    if (!loc || loc.href === 'about:blank') { return; }
    loads++;
    var stillLogin = LOGIN_RE.test(loc.pathname) && /[?&]xedc_embed=1/.test(loc.search);
    if (!stillLogin) {
      if (dialog.open) {
        // 登录成功：iframe 只加载了一个轻量文件，这里显示成功状态后回到原页面
        dialog.classList.add('is-done');
        setTimeout(goBack, 350);
      } else {
        loads = 99; // 预加载页面已变化，下次打开时重新加载
      }
      return;
    }
    dialog.classList.remove('is-done');
    fit();
  }

  function open(url) {
    build();
    var reusable = loadedUrl === url && loads <= 1 && (Date.now() - loadedAt) < STALE_MS;
    dialog.classList.remove('is-done');
    document.documentElement.classList.add('xedc-dialog-open');
    if (!reusable) { frame.style.height = ''; setUrl(url); }
    dialog.showModal();
    if (reusable) { fit(); }
  }

  function supported() {
    return typeof HTMLDialogElement === 'function' && !inEmbed &&
      !document.body.classList.contains('xedc-auth-page');
  }

  function preload() {
    if (!supported()) { return; }
    if (navigator.connection && navigator.connection.saveData) { return; }
    var a = document.querySelector('a[href*="/user/login"]');
    if (!a) { return; }
    var u;
    try { u = new URL(a.href, location.href); } catch (err) { return; }
    if (u.origin !== location.origin || !LOGIN_RE.test(u.pathname)) { return; }
    build();
    setUrl(embedUrl(a));
  }

  window.addEventListener('load', function () {
    (window.requestIdleCallback || function (f) { setTimeout(f, 300); })(preload);
  });

  document.addEventListener('click', function (e) {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) { return; }
    if (!supported()) { return; }
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || a.hasAttribute('data-no-modal') || (a.target && a.target !== '_self')) { return; }
    var u;
    try { u = new URL(a.href, location.href); } catch (err) { return; }
    if (u.origin !== location.origin || !LOGIN_RE.test(u.pathname)) { return; }
    e.preventDefault();
    open(embedUrl(a));
  });
})();

/* 提交中：按钮显示转圈并防止重复提交 */
(function () {
  'use strict';
  document.addEventListener('submit', function (e) {
    var f = e.target;
    if (!f.classList || !f.classList.contains('xedc-auth')) { return; }
    if (f.classList.contains('is-submitting')) { e.preventDefault(); return; }
    f.classList.add('is-submitting');
    f.setAttribute('aria-busy', 'true');
  }, true);
  window.addEventListener('pageshow', function (e) {
    if (!e.persisted) { return; }
    document.querySelectorAll('form.xedc-auth.is-submitting').forEach(function (f) {
      f.classList.remove('is-submitting');
      f.removeAttribute('aria-busy');
    });
  });
})();

/* 去掉 Drupal 登录检查参数，避免被带进退出 / 登录后的跳转地址 */
(function () {
  'use strict';
  try {
    var u = new URL(location.href);
    if (u.searchParams.has('check_logged_in')) {
      u.searchParams.delete('check_logged_in');
      history.replaceState(null, '', u.pathname + u.search + u.hash);
    }
  } catch (err) {}
})();
