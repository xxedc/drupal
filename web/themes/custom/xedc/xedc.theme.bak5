<?php

/**
 * @file
 * Theme functions.
 */

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}

function _xedc_home_items_old($type, $field, $limit) {
  $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', $type)->condition('status', 1)
    ->sort('created', 'DESC')->range(0, $limit)->execute();
  $items = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($nids) as $n) {
    $url = '';
    if ($n->hasField($field) && !$n->get($field)->isEmpty()) {
      $e = $n->get($field)->entity;
      if ($e instanceof \Drupal\media\MediaInterface) {
        $e = $e->get('thumbnail')->entity;
      }
      if ($e instanceof \Drupal\file\FileInterface) {
        $s = \Drupal\image\Entity\ImageStyle::load('large');
        $url = $s ? $s->buildUrl($e->getFileUri()) : \Drupal::service('file_url_generator')->generateString($e->getFileUri());
      }
    }
    $items[] = [
      'title' => $n->label(),
      'url' => $n->toUrl()->toString(),
      'img' => $url,
      'date' => \Drupal::service('date.formatter')->format($n->getCreatedTime(), 'custom', 'm-d'),
    ];
  }
  return $items;
}

function xedc_preprocess_page(&$variables) {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['home_photos'] = _xedc_home_items('photo', 'field_cover_image', 5);
    $variables['home_videos'] = _xedc_home_items('video', 'field_video_cover', 8);
    $variables['home_articles'] = _xedc_home_items('article', 'field_cover', 6);
    $variables['page']['#cache']['tags'][] = 'node_list';
  }
}

function xedc_page_attachments_alter(array &$attachments) {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $attachments['#cache']['tags'][] = 'node_list';
  }
}

function xedc_form_views_exposed_form_alter(array &$form, $form_state, $form_id) {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'image_gallery') {
    return;
  }
  $q = \Drupal::request()->query;
  $cur = $q->get('cat');
  $sort = $q->get('sort_by') === 'totalcount' ? 'totalcount' : 'created';
  $mk = function ($cat, $s) {
    $query = [];
    if ($cat) { $query['cat'] = $cat; }
    if ($s !== 'created') { $query['sort_by'] = $s; }
    return \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $query])->toString();
  };
  $cats = [['t' => '全部', 'u' => $mk(NULL, $sort), 'a' => !$cur]];
  $st = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  foreach ($st->loadTree('photo_category') as $t) {
    $cats[] = ['t' => $t->name, 'u' => $mk($t->tid, $sort), 'a' => $cur == $t->tid];
  }
  $sorts = [
    ['t' => '最新', 'u' => $mk($cur, 'created'), 'a' => $sort === 'created'],
    ['t' => '最热', 'u' => $mk($cur, 'totalcount'), 'a' => $sort === 'totalcount'],
  ];
  $tpl = '<div class="photo-bar"><nav class="photo-tabs">{% for i in cats %}';
  $tpl .= '<a href="{{ i.u }}"{% if i.a %} class="is-active"{% endif %}>{{ i.t }}</a>{% endfor %}</nav>';
  $tpl .= '<nav class="photo-sorts">{% for i in sorts %}';
  $tpl .= '<a href="{{ i.u }}"{% if i.a %} class="is-active"{% endif %}>{{ i.t }}</a>{% endfor %}</nav></div>';
  $form['pills'] = ['#type' => 'inline_template', '#template' => $tpl,
    '#context' => ['cats' => $cats, 'sorts' => $sorts], '#weight' => -10];
  foreach (['cat', 'sort_by', 'sort_order', 'actions'] as $f) {
    if (isset($form[$f])) { $form[$f]['#attributes']['class'][] = 'photo-hide'; }
  }
  $form['#cache']['contexts'][] = 'url.query_args:cat';
  $form['#cache']['contexts'][] = 'url.query_args:sort_by';
}

function xedc_form_comment_form_alter(array &$form, $form_state, $form_id) {
  $form["actions"]["submit"]["#value"] = "发表评论";
  if (isset($form["actions"]["preview"])) { $form["actions"]["preview"]["#access"] = FALSE; }
  if (\Drupal::currentUser()->isAnonymous() && isset($form["field_comment_image"])) { $form["field_comment_image"]["#access"] = FALSE; }
}

function xedc_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'photo' || $variables['view_mode'] !== 'full') {
    return;
  }
  $st = \Drupal::entityTypeManager()->getStorage('node');
  $created = $node->getCreatedTime();
  $q = $st->getQuery()->accessCheck(TRUE)->condition('type', 'photo')->condition('status', 1);
  $prev = (clone $q)->condition('created', $created, '<')->sort('created', 'DESC')->range(0, 1)->execute();
  $next = (clone $q)->condition('created', $created, '>')->sort('created', 'ASC')->range(0, 1)->execute();
  $variables['nav_prev'] = $prev ? $st->load(reset($prev)) : NULL;
  $variables['nav_next'] = $next ? $st->load(reset($next)) : NULL;
  $ids = [];
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $tid = $node->get('field_categories')->target_id;
    $ids = (clone $q)->condition('nid', $node->id(), '<>')->condition('field_categories', $tid)->sort('created', 'DESC')->range(0, 4)->execute();
  }
  if (!$ids) {
    $ids = (clone $q)->condition('nid', $node->id(), '<>')->sort('created', 'DESC')->range(0, 4)->execute();
  }
  $variables['related'] = $ids ? $st->loadMultiple($ids) : [];
  $variables['#cache']['tags'][] = 'node_list:photo';
}
