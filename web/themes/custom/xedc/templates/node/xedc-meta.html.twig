{{ attach_library('xedc/meta') }}
{% set meta_part = part|default('all') %}
{% set show_stats = meta_part == 'all' or meta_part == 'stats' %}
{% set show_classify = meta_part == 'all' or meta_part == 'info' or meta_part == 'classify' %}
{% set show_tags = meta_part == 'all' or meta_part == 'info' or meta_part == 'tags' %}
{% if xedc_meta and (show_stats or (show_classify and (xedc_meta.categories or xedc_meta.models)) or (show_tags and xedc_meta.tags)) %}
<div class="xedc-meta">
  {% if show_stats %}
  <div class="xedc-meta__stats">
    <span class="xedc-meta__stat">
      <span class="xedc-meta__stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg></span>
      <span class="xedc-meta__stat-value">{{ '@count 张'|t({'@count': xedc_meta.count}) }}</span>
      <span class="xedc-meta__stat-label">{{ '图片数量'|t }}</span>
    </span>
    <span class="xedc-meta__stat">
      <span class="xedc-meta__stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><path d="M6 16h.01M10 16h.01"/></svg></span>
      <span class="xedc-meta__stat-value">{{ xedc_meta.size }}</span>
      <span class="xedc-meta__stat-label">{{ xedc_meta.size_label|default('原图总大小'|t) }}</span>
    </span>
    <span class="xedc-meta__stat">
      <span class="xedc-meta__stat-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
      <span class="xedc-meta__stat-value">{{ xedc_meta.date }}</span>
      <span class="xedc-meta__stat-label">{{ '发布时间'|t }}</span>
    </span>
  </div>
  {% endif %}
  {% if (show_classify and (xedc_meta.categories or xedc_meta.models)) or (show_tags and xedc_meta.tags) %}
  <div class="xedc-meta__info">
    {% if show_classify and xedc_meta.categories %}
    <div class="xedc-meta__line xedc-meta__line--categories">
      <div class="xedc-meta__group">
        <span class="xedc-meta__label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>{{ '分类：'|t }}</span>
        <span class="xedc-meta__values">{% for c in xedc_meta.categories %}<a class="xedc-meta__model" href="{{ c.url }}">{{ c.label }}</a>{% endfor %}</span>
      </div>
    </div>
    {% endif %}
    {% if show_classify and xedc_meta.models %}
    <div class="xedc-meta__line xedc-meta__line--models">
      <div class="xedc-meta__group">
        <span class="xedc-meta__label"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>{{ '人物：'|t }}</span>
        <span class="xedc-meta__values">{% for m in xedc_meta.models %}<a class="xedc-meta__model" href="{{ m.url }}">{{ m.label }}</a>{% endfor %}</span>
      </div>
    </div>
    {% endif %}
    {% if show_tags and xedc_meta.tags %}
    <div class="xedc-meta__line xedc-meta__line--tags">
      <div class="xedc-meta__group">
        <span class="xedc-meta__label"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1"/></svg>{{ '标签：'|t }}</span>
        <span class="xedc-meta__values">{% for t in xedc_meta.tags %}<a class="xedc-meta__tag" href="{{ t.url }}">#{{ t.label }}</a>{% endfor %}</span>
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endif %}
