{{ attach_library('xedc/meta') }}
{% if xedc_meta %}
<div class="xedc-meta">
  <div class="xedc-meta__stats">
    <span class="xedc-meta__stat"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>{{ xedc_meta.count }} 张</span>
    <span class="xedc-meta__stat"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/></svg>{{ xedc_meta.size }}</span>
    <span class="xedc-meta__stat"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>{{ xedc_meta.date }}</span>
  </div>
  {% if xedc_meta.categories or xedc_meta.models or xedc_meta.tags %}
  <div class="xedc-meta__info">
    {% if xedc_meta.categories %}
    <div class="xedc-meta__row">
      <span class="xedc-meta__label">分类：</span>
      <span class="xedc-meta__values">
        {% for c in xedc_meta.categories %}<a class="xedc-meta__model" href="{{ c.url }}">{{ c.label }}</a>{% endfor %}
      </span>
    </div>
    {% endif %}
    {% if xedc_meta.models %}
    <div class="xedc-meta__row">
      <span class="xedc-meta__label">名称：</span>
      <span class="xedc-meta__values">
        {% for m in xedc_meta.models %}<a class="xedc-meta__model" href="{{ m.url }}">{{ m.label }}</a>{% endfor %}
      </span>
    </div>
    {% endif %}
    {% if xedc_meta.tags %}
    <div class="xedc-meta__row">
      <span class="xedc-meta__label">标签：</span>
      <span class="xedc-meta__values">
        {% for t in xedc_meta.tags %}<a class="xedc-meta__tag" href="{{ t.url }}">#{{ t.label }}</a>{% endfor %}
      </span>
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endif %}
