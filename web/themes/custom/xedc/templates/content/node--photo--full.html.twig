{{ attach_library('xedc/photo-detail') }}
{% set classes = ['node','node--type-'~node.bundle|clean_class,'img-detail'] %}
{% set gallery = img_gallery|default([]) %}
<article{{ attributes.addClass(classes) }}>
  <div class="img-detail__layout">
    <div class="img-detail__main">
      <header class="img-detail__head">
        <h1 class="img-detail__title">{{ label }}</h1>
        {% if xedc_meta %}
          <div class="img-detail__meta-row">
            <p class="img-detail__facts">
              <span>{{ '@count 张'|t({'@count': xedc_meta.count}) }}</span>
              <span class="img-detail__facts-sep" aria-hidden="true">·</span>
              {% if gallery %}
                <span><span class="img-detail__original">{{ '原图:'|t }}</span>{{ xedc_meta.size }}</span>
              {% else %}
                <span>{{ xedc_meta.size }}</span>
              {% endif %}
              <span class="img-detail__facts-sep" aria-hidden="true">·</span>
              <time datetime="{{ xedc_meta.date }}">{{ xedc_meta.date }}</time>
            </p>
            {% if gallery %}
              <button type="button" class="img-detail__all" data-img-all aria-label="{{ '全部'|t }}" aria-haspopup="dialog" aria-controls="img-sheet" aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
              </button>
            {% endif %}
          </div>
        {% endif %}
      </header>
      <div class="img-detail__gallery" data-img-count="{{ gallery|length }}" data-img-gallery="{{ img_gallery_client|default(gallery)|json_encode|e('html_attr') }}">
        {% for item in gallery %}
          <img
            src="{{ item.full }}"
            {% if item.srcset %}srcset="{{ item.srcset }}" sizes="(min-width: 960px) 720px, 100vw"{% endif %}
            alt="{{ item.alt }}"
            {% if item.width and item.height %}width="{{ item.width }}" height="{{ item.height }}"{% endif %}
            {% if loop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
            decoding="async">
        {% endfor %}
      </div>
    </div>
    <aside class="img-detail__panel">
      {% if xedc_meta %}
        <div class="img-detail__stack">
          {% if xedc_meta.categories or xedc_meta.models %}
            <div class="img-detail__pills img-detail__pills--classify">
              {% if xedc_meta.categories %}
                <span class="img-detail__pair">
                  <span class="img-detail__prefix">{{ '分类：'|t }}</span>
                  {% for c in xedc_meta.categories %}
                    <a class="img-detail__name" href="{{ c.url }}">{{ c.label }}</a>
                  {% endfor %}
                </span>
              {% endif %}
              {% if xedc_meta.models %}
                <span class="img-detail__pair">
                  <span class="img-detail__prefix">{{ '模特：'|t }}</span>
                  {% for m in xedc_meta.models %}
                    <a class="img-detail__name" href="{{ m.url }}">{{ m.label }}</a>
                  {% endfor %}
                </span>
              {% endif %}
            </div>
          {% endif %}
          {% if xedc_meta.tags %}
            <div class="img-detail__pills img-detail__pills--tags">
              {% for t in xedc_meta.tags %}
                <a class="xedc-pill img-detail__tag" href="{{ t.url }}">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1"/></svg>
                  <span>{{ t.label }}</span>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      {% if img_summary|default('')|trim != '' %}
        <div class="img-detail__desc-group">
          <div class="img-detail__desc-label">{{ '描述'|t }}</div>
          <div class="img-detail__desc" id="img-detail-desc">{{ img_summary }}</div>
          <button type="button" class="img-detail__desc-toggle" hidden aria-expanded="false" aria-controls="img-detail-desc">{{ '展开'|t }}</button>
        </div>
      {% endif %}
      {% if xedc_member_favorite|default('') %}
        <div class="img-detail__fav">{{ xedc_member_favorite }}</div>
      {% endif %}
    </aside>
    <nav class="img-nav">
      {% if nav_prev %}<a class="img-nav__a" href="{{ path('entity.node.canonical', {'node': nav_prev.id}) }}"><small>{{ '上一篇'|t }}</small><span>{{ nav_prev.label }}</span></a>{% else %}<span></span>{% endif %}
      {% if nav_next %}<a class="img-nav__a img-nav__a--r" href="{{ path('entity.node.canonical', {'node': nav_next.id}) }}"><small>{{ '下一篇'|t }}</small><span>{{ nav_next.label }}</span></a>{% endif %}
    </nav>
    <section class="img-detail__comments" aria-label="{{ '评论'|t }}">
      {{ content.field_comment }}
    </section>
  </div>
  {% include '@xedc/includes/photo-all-sheet.html.twig' with { items: gallery } %}
  {% if related_cards %}
    <section class="img-rel">
      <h2 class="img-rel__t">{{ '相关推荐'|t }}</h2>
      <div class="meitu-grid">
        {% for card in related_cards %}
          {% include '@xedc/templates/includes/meitu-card.html.twig' with {
            url: card.url,
            title: card.title,
            img: card.img,
            count: card.count,
            loading: card.loading|default('lazy'),
            fetchpriority: card.fetchpriority|default(''),
            width: card.width|default(0),
            height: card.height|default(0)
          } only %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>
