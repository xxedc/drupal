{% set classes = ['node','node--type-'~node.bundle|clean_class,'img-detail'] %}
<article{{ attributes.addClass(classes) }}>
  <nav class="img-detail__crumb" aria-label="breadcrumb">
    <a href="{{ path('<front>') }}">首页</a><span>/</span>
    {{ content.field_categories }}
  </nav>
  <header class="img-detail__head">
    <h1 class="img-detail__title">{{ label }}</h1>
    <div class="img-detail__meta">{{ author_name }} · {{ date }}</div>
    <div class="img-detail__terms">{{ content.field_tags }}</div>
  </header>
  <div class="img-detail__gallery">{{ content.field_cover_image }}{{ content.field_images }}</div>
  <div class="img-detail__info">
    {{ content|without('field_images','field_categories','field_tags','field_cover_image','field_comment','links') }}
    {{ content.field_comment }}
  </div>
</article>
