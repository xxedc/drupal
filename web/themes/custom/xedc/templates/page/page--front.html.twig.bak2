{% embed 'radix:page' %}
  {% block page_navigation %}
    {% set search_form %}
      <form class="search-field" action="{{ path('<front>') }}search/node" method="get" role="search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="keys" placeholder="搜索壁纸…" aria-label="搜索" autocomplete="off">
      </form>
    {% endset %}
    <nav class="xedc-nav" aria-label="主导航">
      <div class="container xedc-nav__inner">
        <button type="button" class="icon-btn d-lg-none" data-menu-toggle aria-label="菜单" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="xedc-brand"><a class="xedc-logo" href="{{ path('<front>') }}" aria-label="XEDC"><span class="xedc-logo__mark"></span><span class="xedc-logo__text">XEDC</span></a></div>
        <div class="xedc-backdrop" data-menu-close></div>
        <div class="xedc-menu" id="xedc-menu">
          <div class="xedc-menu__head d-lg-none">
            <a class="xedc-logo" href="{{ path('<front>') }}" aria-label="XEDC"><span class="xedc-logo__mark"></span><span class="xedc-logo__text">XEDC</span></a>
            <button type="button" class="icon-btn" data-menu-close aria-label="关闭">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
          </div>
          {% if page.navbar_left %}{{ page.navbar_left }}{% endif %}
        </div>
        <div class="navbar-search d-none d-lg-block">{{ search_form }}</div>
        <div class="xedc-actions">
          <button type="button" class="icon-btn d-lg-none" data-search-toggle aria-label="搜索" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
          {% if logged_in %}
            <a class="text-link d-none d-lg-inline-flex" href="{{ path('user.page') }}">账号</a>
            <a class="text-link d-none d-lg-inline-flex" href="{{ path('user.logout') }}">退出</a>
            <a class="icon-btn d-lg-none" href="{{ path('user.page') }}" aria-label="账号">
          {% else %}
            <a class="text-link d-none d-lg-inline-flex" href="{{ path('user.login') }}">登录</a>
            <a class="text-link d-none d-lg-inline-flex" href="{{ path('user.register') }}">注册</a>
            <a class="icon-btn d-lg-none" href="{{ path('user.login') }}" aria-label="登录">
          {% endif %}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
          </a>
          <button type="button" class="icon-btn" data-theme-toggle aria-label="切换主题">
            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </div>
      </div>
      <div class="xedc-searchbar d-lg-none"><div class="container">{{ search_form }}</div></div>
    </nav>
  {% endblock %}
{% endembed %}
