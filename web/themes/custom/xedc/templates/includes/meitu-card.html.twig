{#
  美图卡片。首页、美图列表、分类术语页都 include 这一份。
  传入：url、title；可选 img、count、category、date、loading、fetchpriority、width、height。
  count 为数字，文案在这里拼成「2张」。空的分类、张数、日期仍保留相同标签，由 CSS 隐藏。
#}
{% set url = url|default('') %}
{% set title = title|default('') %}
{% set img = img|default('') %}
{% set count = count|default(0) %}
{% set category = category|default('') %}
{% set date = date|default('') %}
{% set loading = loading|default('lazy') %}
{% set fetchpriority = fetchpriority|default('') %}
{% set width = width|default(0) %}
{% set height = height|default(0) %}
<article class="meitu-card">
  <a class="meitu-card__link" href="{{ url }}">
    <span class="meitu-card__media">
      {% if img %}
        <img class="meitu-card__img" src="{{ img }}" alt="{{ title }}"{% if width and height %} width="{{ width }}" height="{{ height }}"{% endif %} loading="{{ loading }}"{% if fetchpriority %} fetchpriority="{{ fetchpriority }}"{% endif %} decoding="async">
      {% endif %}
      <span class="meitu-card__cat">{{ category }}</span>
      <span class="meitu-card__count">{% if count %}{{ '@count张'|t({'@count': count}) }}{% endif %}</span>
    </span>
    <span class="meitu-card__body">
      <span class="meitu-card__title">{{ title }}</span>
      <time class="meitu-card__date"{% if date %} datetime="{{ date }}"{% endif %}>{{ date }}</time>
    </span>
  </a>
</article>
