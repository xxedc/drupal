<?php

/**
 * @file
 * Theme functions.
 */

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}

/**
 * Database connection from the container.
 *
 * Theme functions cannot take a constructor. Aggregates that are not entity
 * queries keep their SQL and go through this service.
 */
function _xedc_database(): \Drupal\Core\Database\Connection {
  return \Drupal::service('database');
}

/**
 * Implements hook_theme().
 */
function xedc_theme($existing, $type, $theme, $path) {
  return [
    'xedc_search_page' => [
      'variables' => [
        'q' => '',
        'type' => 'all',
        'sort' => 'relevance',
        'page' => 0,
        'form_action' => '/search',
        'tabs' => [],
        'sorts' => [],
        'info_count' => 0,
        'cards' => [],
        'models' => [],
        'xa_pager' => [],
        'hot_models' => [],
        'explore' => [],
      ],
      'template' => 'search/search-page',
    ],
    'xedc_html_sitemap' => [
      'variables' => [
        'sections' => [],
      ],
      'template' => 'page/html-sitemap',
    ],
  ];
}

/**
 * Replaces the homepage share image with the current hero or latest photo.
 */
function _xedc_front_share_image(array &$attachments): void {
  if (!\Drupal::moduleHandler()->moduleExists('xedc_home')) {
    return;
  }
  $cards = \Drupal::service('xedc_home.cards');
  $slides = $cards->slideshow();
  $image = (string) ($slides[0]['img'] ?? '');
  $alt = (string) ($slides[0]['title'] ?? 'DcLili');
  if ($image === '') {
    $photos = $cards->fromView('block_photos', 'field_cover_image', 'xa_hero', 'photo');
    $image = (string) ($photos[0]['img'] ?? '');
    $alt = (string) ($photos[0]['title'] ?? 'DcLili');
  }
  if ($image === '') {
    return;
  }
  if (str_starts_with($image, '/')) {
    $image = \Drupal\Core\Url::fromUserInput($image)->setAbsolute()->toString();
  }
  $map = [
    'og:image' => $image,
    'og:image:alt' => $alt,
    'twitter:image' => $image,
    'twitter:image:alt' => $alt,
  ];
  $seen = [];
  foreach ($attachments['#attached']['html_head'] ?? [] as $key => $item) {
    $attributes = $item[0]['#attributes'] ?? [];
    $id = $attributes['property'] ?? ($attributes['name'] ?? '');
    if (!isset($map[$id])) {
      continue;
    }
    $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = $map[$id];
    $seen[$id] = TRUE;
  }
  foreach ($map as $id => $content) {
    if (!empty($seen[$id])) {
      continue;
    }
    $attribute = str_starts_with($id, 'og:') ? 'property' : 'name';
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => [$attribute => $id, 'content' => $content],
      ],
      'xedc_share_' . str_replace(':', '_', $id),
    ];
  }
}

/**
 * Implements hook_metatags_alter().
 */
function xedc_metatags_alter(array &$metatags, array &$context): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $metatags['title'] = (string) t('DcLili - 精选美图、视频与优质文章');
    $metatags['og_title'] = $metatags['title'];
    $metatags['description'] = (string) t('在 DcLili 浏览精选美图、写真、风景壁纸、精彩视频与优质文章，按分类发现感兴趣的图片和内容，持续探索更多精彩。');
    $metatags['og_description'] = $metatags['description'];
  }
  elseif ($route === 'xedc.html_sitemap') {
    $metatags['title'] = t('站点地图') . ' | DcLili';
    $metatags['description'] = (string) t('DcLili 站点地图，浏览美图、文章、视频、模特与主要页面。');
    $metatags['og_description'] = $metatags['description'];
  }
  elseif ($route === 'xedc_tags.index') {
    $metatags['title'] = t('全部标签') . ' | DcLili';
    $metatags['description'] = (string) t('DcLili 标签目录，按标签浏览美图、文章与视频。');
    $metatags['og_description'] = $metatags['description'];
  }
  elseif ($route === 'view.image_gallery.page_1') {
    $metatags['title'] = t('美图列表') . ' | DcLili';
  }
  elseif ($route === 'xedc_models.detail') {
    $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $name = _xedc_translated($term)->label();
      $metatags['title'] = t('@name 的作品', ['@name' => $name]) . ' | DcLili';
      $metatags['description'] = (string) t('@name 的图片与视频作品合集，在 DcLili 浏览。', ['@name' => $name]);
      $metatags['og_title'] = $name;
      $metatags['og_description'] = $metatags['description'];
    }
  }
  $entity = $context['entity'] ?? NULL;
  if ($entity instanceof \Drupal\taxonomy\TermInterface && $entity->bundle() !== 'models') {
    $term = _xedc_translated($entity);
    $metatags['title'] = t('@name 列表页', ['@name' => $term->label()]) . ' | DcLili';
    $raw = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags((string) $term->get('description')->value), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
    if ($raw !== '') {
      $metatags['description'] = mb_substr($raw, 0, 160);
      $metatags['og_description'] = $metatags['description'];
    }
    return;
  }
  if (!$entity instanceof \Drupal\node\NodeInterface) {
    return;
  }
  if ($entity->bundle() === 'photo') {
    $cache = ['#cache' => ['tags' => [], 'contexts' => ['route']]];
    $items = _xedc_photo_gallery_items($entity, $cache);
    if ($items && !empty($items[0]['full_absolute'])) {
      $metatags['og_image'] = $items[0]['full_absolute'];
      $metatags['og_image_alt'] = $items[0]['alt'];
      $metatags['twitter_cards_image'] = $items[0]['full_absolute'];
      $metatags['twitter_cards_image_alt'] = $items[0]['alt'];
    }
    $metatags['description'] = _xedc_node_meta_description($entity);
    $metatags['og_description'] = $metatags['description'];
    $metatags['twitter_cards_description'] = $metatags['description'];
  }
  if ($entity->bundle() === 'video') {
    $metatags['description'] = _xedc_node_meta_description($entity);
    $metatags['og_description'] = $metatags['description'];
    $metatags['twitter_cards_description'] = $metatags['description'];
    if ($entity->hasField('field_video_cover') && !$entity->get('field_video_cover')->isEmpty()) {
      $relative = _xedc_vd_image_url($entity->get('field_video_cover')->entity, 'xa_hero');
      if ($relative !== '' && str_starts_with($relative, '/')) {
        $absolute = \Drupal\Core\Url::fromUserInput($relative)->setAbsolute()->toString();
        $metatags['og_image'] = $absolute;
        $metatags['twitter_cards_image'] = $absolute;
      }
    }
  }
}

/**
 * Meta description without an empty category suffix.
 */
function _xedc_node_meta_description(\Drupal\node\NodeInterface $node): string {
  $parts = [];
  if ($node->hasField('field_summary') && !$node->get('field_summary')->isEmpty()) {
    $summary = trim(preg_replace('/\s+/u', ' ', (string) $node->get('field_summary')->value));
    if ($summary !== '') {
      $parts[] = $summary;
    }
  }
  $title = trim((string) $node->label());
  if ($title !== '' && !in_array($title, $parts, TRUE)) {
    $parts[] = $title;
  }
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $term = $node->get('field_categories')->entity;
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $label = trim((string) _xedc_translated($term)->label());
      if ($label !== '') {
        $parts[] = $label;
      }
    }
  }
  return implode(' - ', $parts);
}

function xedc_preprocess_page(&$variables) {
  xedc_nav_build($variables);
  // Login, register and password forms must not be stored in the anonymous
  // page cache. A cached form_build_id expires before the page does, and the
  // first submit then fails and has to be repeated.
  if (function_exists('_xedc_auth_is_auth_route') && _xedc_auth_is_auth_route()) {
    $variables['#cache']['max-age'] = 0;
    $variables['page']['#cache']['max-age'] = 0;
  }
  $lang_links = _xedc_language_links();
  $variables['xedc_lang_links'] = $lang_links;
  $variables['xedc_lang_current'] = NULL;
  $variables['xedc_lang_others'] = [];
  foreach ($lang_links as $lang_link) {
    if (!empty($lang_link['current'])) {
      $variables['xedc_lang_current'] = $lang_link;
    }
    else {
      $variables['xedc_lang_others'][] = $lang_link;
    }
  }
  $variables['#cache']['contexts'][] = 'languages:language_interface';
  $variables['#cache']['contexts'][] = 'url';
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';
  $xedc_link = static function (string $path): string {
    return \Drupal\Core\Url::fromUserInput($path)->toString();
  };
  $variables['xedc_href'] = [
    'front' => \Drupal\Core\Url::fromRoute('<front>')->toString(),
    'search' => $xedc_link('/search'),
    'meitu' => $xedc_link('/meitu'),
    'video' => $xedc_link('/video'),
    'articles' => $xedc_link('/articles'),
    'about' => $xedc_link('/about'),
    'privacy' => $xedc_link('/privacy-policy'),
    'terms' => $xedc_link('/terms'),
    'sitemap' => $xedc_link('/sitemap'),
  ];
  if (_xedc_search_is_route() && isset($variables['page']['content'])) {
    $variables['page']['content'] = _xedc_search_build_page();
    $variables['page']['#cache']['contexts'] = \Drupal\Core\Cache\Cache::mergeContexts(
      $variables['page']['#cache']['contexts'] ?? [],
      ['url.query_args:q', 'url.query_args:type', 'url.query_args:sort', 'url.query_args:page']
    );
    $variables['page']['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags(
      $variables['page']['#cache']['tags'] ?? [],
      ['node_list:photo', 'node_list:article', 'node_list:video', 'taxonomy_term_list']
    );
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'xedc/home-page';
    $variables['home_slides'] = [];
    $variables['home_categories'] = [];
    if (\Drupal::moduleHandler()->moduleExists('xedc_home')) {
      $cards = \Drupal::service('xedc_home.cards');
      $variables['home_slides'] = $cards->slideshow();
      $variables['home_photos'] = $cards->fromView('block_photos', 'field_cover_image', 'meitu_card_cover', 'photo');
      $variables['home_videos'] = $cards->fromView('block_videos', 'field_video_cover', 'video_cover', 'video');
      $variables['home_articles'] = $cards->fromView('block_articles', 'field_cover', 'xa_cover', 'article');
      $block = \Drupal::service('plugin.manager.block')->createInstance('xedc_home_photo_categories');
      $variables['home_categories'] = $block->build();
      if (count($variables['home_slides']) > 1) {
        $variables['#attached']['library'][] = 'xedc/home';
      }
    }
    else {
      $variables['home_photos'] = _xedc_home_items('photo', 'field_cover_image', 5);
      $variables['home_videos'] = _xedc_home_items('video', 'field_video_cover', 8);
      $variables['home_articles'] = _xedc_home_items('article', 'field_cover', 6);
    }
    $lcp = '';
    if (!empty($variables['home_slides'][0]['img'])) {
      $lcp = (string) $variables['home_slides'][0]['img'];
    }
    elseif (!empty($variables['home_photos'][0]['img'])) {
      $lcp = (string) $variables['home_photos'][0]['img'];
    }
    if ($lcp !== '') {
      $lcp_attributes = [
        'rel' => 'preload',
        'as' => 'image',
        'href' => $lcp,
        'fetchpriority' => 'high',
      ];
      if (!empty($variables['home_slides'][0]['srcset'])) {
        $lcp_attributes['imagesrcset'] = $variables['home_slides'][0]['srcset'];
        $lcp_attributes['imagesizes'] = '(min-width: 1200px) 1200px, 100vw';
      }
      $variables['#attached']['html_head'][] = [
        [
          '#tag' => 'link',
          '#attributes' => $lcp_attributes,
        ],
        'xedc_lcp_image',
      ];
    }
    $variables['#cache']['tags'][] = 'node_list:photo';
    $variables['#cache']['tags'][] = 'node_list:article';
    $variables['#cache']['tags'][] = 'node_list:video';
    $variables['#cache']['tags'][] = 'taxonomy_term_list';
    $variables['#cache']['contexts'][] = 'user.permissions';
    $variables['#cache']['max-age'] = \Drupal\Core\Cache\Cache::mergeMaxAges($variables['#cache']['max-age'] ?? \Drupal\Core\Cache\Cache::PERMANENT, 3600);
    $variables['page']['#cache']['tags'][] = 'node_list:photo';
    $variables['page']['#cache']['tags'][] = 'node_list:article';
    $variables['page']['#cache']['tags'][] = 'node_list:video';
    $variables['page']['#cache']['tags'][] = 'taxonomy_term_list';
    $variables['page']['#cache']['max-age'] = \Drupal\Core\Cache\Cache::mergeMaxAges($variables['page']['#cache']['max-age'] ?? \Drupal\Core\Cache\Cache::PERMANENT, 3600);
  }
}

/**
 * Drops jQuery from trackers that no longer call it.
 *
 * Comment forms keep their own core/jquery dependency.
 */
function xedc_library_info_alter(array &$libraries, $extension) {
  $targets = [
    'matomo' => ['matomo'],
    'statistics' => ['drupal.statistics'],
  ];
  if (!isset($targets[$extension])) {
    return;
  }
  foreach ($targets[$extension] as $name) {
    if (empty($libraries[$name]['dependencies'])) {
      continue;
    }
    $libraries[$name]['dependencies'] = array_values(array_filter(
      $libraries[$name]['dependencies'],
      static fn (string $dependency): bool => $dependency !== 'core/jquery'
    ));
  }
}

function xedc_page_attachments_alter(array &$attachments) {
  $attachments['#cache']['contexts'] = \Drupal\Core\Cache\Cache::mergeContexts(
    $attachments['#cache']['contexts'] ?? [],
    ['route', 'url.path', 'languages:language_interface']
  );
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'preconnect',
        'href' => 'https://x.gitxx.xyz',
      ],
    ],
    'xedc_matomo_preconnect',
  ];
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if ($term instanceof \Drupal\taxonomy\TermInterface) {
    $term = _xedc_translated($term);
    $title = (string) t('@name 列表页', ['@name' => $term->label()]);
    $full = $title . ' | DcLili';
    foreach ($attachments['#attached']['html_head'] ?? [] as $key => $item) {
      $tag = $item[0]['#tag'] ?? '';
      $name = $item[1] ?? '';
      if ($tag === 'title' || $name === 'title') {
        $attachments['#attached']['html_head'][$key][0]['#value'] = $full;
      }
      if (($item[0]['#attributes']['name'] ?? '') === 'description' && isset($item[0]['#attributes']['content'])) {
        $raw = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags((string) $term->get('description')->value), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
        if ($raw !== '') {
          $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = mb_substr($raw, 0, 160);
        }
      }
    }
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $front_description = '在 DcLili 浏览精选美图、写真、风景壁纸、精彩视频与优质文章，按分类发现感兴趣的图片和内容，持续探索更多精彩。';
    foreach ($attachments['#attached']['html_head'] ?? [] as $key => $item) {
      if (($item[0]['#attributes']['name'] ?? '') !== 'description') {
        continue;
      }
      $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = (string) t($front_description);
    }
  }
  foreach ($attachments['#attached']['html_head'] ?? [] as $key => $item) {
    if (($item[1] ?? '') !== 'viewport') {
      continue;
    }
    $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = 'width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual';
    break;
  }

  if (_xedc_search_is_route()) {
    [$q, $type, $sort, $page] = _xedc_search_params();
    $query = [];
    if ($q !== '') {
      $query['q'] = $q;
    }
    if ($type !== 'all') {
      $query['type'] = $type;
    }
    if ($page > 0) {
      $query['page'] = $page;
    }
    $canonical = \Drupal\Core\Url::fromUserInput('/search', ['query' => $query])->setAbsolute()->toString();

    $attachments['#attached']['html_head'] = $attachments['#attached']['html_head'] ?? [];
    $has_canonical = FALSE;
    foreach ($attachments['#attached']['html_head'] as $key => $item) {
      $name = $item[1] ?? '';
      if ($name === 'robots') {
        unset($attachments['#attached']['html_head'][$key]);
      }
      if ($name === 'canonical_url') {
        $attachments['#attached']['html_head'][$key][0]['#attributes']['href'] = $canonical;
        $has_canonical = TRUE;
      }
    }
    if (!$has_canonical) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'link',
          '#attributes' => ['rel' => 'canonical', 'href' => $canonical],
        ],
        'canonical_url',
      ];
    }
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex,follow'],
      ],
      'robots',
    ];
    $attachments['#cache']['contexts'] = \Drupal\Core\Cache\Cache::mergeContexts(
      $attachments['#cache']['contexts'] ?? [],
      ['url.query_args:q', 'url.query_args:type', 'url.query_args:page']
    );
    return;
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $attachments['#cache']['tags'][] = 'node_list:photo';
    $attachments['#cache']['tags'][] = 'node_list:article';
    $attachments['#cache']['tags'][] = 'node_list:video';
    _xedc_front_share_image($attachments);
  }
  _xedc_attach_route_breadcrumb($attachments);
  if (!_xedc_is_photo_list_route()) {
    return;
  }

  $page = _xedc_photo_current_page();
  $canonical = _xedc_photo_page_url($page, TRUE);
  if (empty($attachments['#attached']['html_head'])) {
    return;
  }
  foreach ($attachments['#attached']['html_head'] as $key => $item) {
    $name = $item[1] ?? '';
    if ($name === 'canonical_url') {
      $attachments['#attached']['html_head'][$key][0]['#attributes']['href'] = $canonical;
    }
    if ($page > 0 && $name === 'description') {
      unset($attachments['#attached']['html_head'][$key]);
    }
  }
}

/**
 * Published photo counts per model inside one photo category.
 *
 * @return array<int, array{id: int, t: string, n: int}>
 *   Models ordered by photo count.
 */
function _xedc_photo_category_models(int $tid): array {
  $rows = _xedc_database()->query(
    "SELECT m.field_model_target_id AS tid, COUNT(DISTINCT m.entity_id) AS n
     FROM {node__field_model} m
     INNER JOIN {node__field_categories} c ON c.entity_id = m.entity_id AND c.langcode = m.langcode AND c.deleted = 0
     INNER JOIN {node_field_data} n ON n.nid = m.entity_id AND n.langcode = m.langcode
     WHERE m.deleted = 0 AND n.status = 1 AND n.type = :type AND c.field_categories_target_id = :tid
     GROUP BY m.field_model_target_id",
    [':type' => 'photo', ':tid' => $tid]
  )->fetchAllKeyed();
  if (!$rows) {
    return [];
  }
  $items = [];
  foreach (\Drupal\taxonomy\Entity\Term::loadMultiple(array_keys($rows)) as $term) {
    $items[] = ['id' => (int) $term->id(), 't' => _xedc_translated($term)->label(), 'n' => (int) $rows[$term->id()]];
  }
  usort($items, static fn(array $a, array $b) => $b['n'] <=> $a['n']);
  return $items;
}

function xedc_form_views_exposed_form_alter(array &$form, $form_state, $form_id) {
  if (isset($form['sort_by'])) {
    if ((string) ($form['sort_by']['#title'] ?? '') === '排序依据') {
      $form['sort_by']['#title'] = t('排序依据');
    }
    foreach ($form['sort_by']['#options'] ?? [] as $key => $label) {
      $plain = (string) $label;
      if (in_array($plain, ['最新', '最热'], TRUE)) {
        $form['sort_by']['#options'][$key] = t($plain);
      }
    }
  }
  if ((string) ($form['actions']['submit']['#value'] ?? '') === '应用') {
    $form['actions']['submit']['#value'] = t('应用');
  }
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'image_gallery') {
    return;
  }
  $q = \Drupal::request()->query;
  $sort = $q->get('sort_by') === 'totalcount' ? 'totalcount' : 'created';
  $cur = 0;
  if (preg_match('#^/taxonomy/term/(\d+)$#', \Drupal::service('path.current')->getPath(), $m)) {
    $cur = (int) $m[1];
  }
  $sq = function ($s) { return $s !== 'created' ? ['sort_by' => $s] : []; };

  // 栏目页：按已发布美图统计人物，不加载栏目下的全部节点。
  $models = [];
  $tags = [];
  $term = $cur ? \Drupal\taxonomy\Entity\Term::load($cur) : NULL;
  $is_cat = $term && $term->bundle() === 'photo_category';
  if ($is_cat) {
    $models = _xedc_photo_category_models($cur);
  }

  // 顶部条：栏目页且有人物 -> 人物；否则 -> 栏目。横条只露前若干项，其余进弹出层。
  // 模特筛选留在当前栏目页，用 ?model= 收窄列表。
  $model_id = 0;
  if ($is_cat) {
    $raw_model = $q->get('model');
    if (is_scalar($raw_model) && ctype_digit((string) $raw_model)) {
      $model_id = (int) $raw_model;
    }
    $tabs = [['t' => t('全部'), 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq($sort)])->toString(), 'a' => $model_id === 0]];
    foreach ($models as $item) {
      $query = $sq($sort);
      $query['model'] = $item['id'];
      $tabs[] = [
        't' => $item['t'],
        'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $query])->toString(),
        'a' => $model_id === $item['id'],
      ];
    }
    if ($model_id > 0) {
      $base_sq = $sq;
      $sq = function ($s) use ($base_sq, $model_id) {
        $query = $base_sq($s);
        $query['model'] = $model_id;
        return $query;
      };
    }
  }
  else {
    $tabs = [['t' => t('全部'), 'u' => \Drupal\Core\Url::fromUserInput('/meitu', ['query' => $sq($sort)])->toString(), 'a' => !$cur]];
    $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('photo_category');
    $labels = _xedc_term_label_map($tree);
    foreach ($tree as $t) {
      $tabs[] = ['t' => $labels[(int) $t->tid] ?? $t->name,
        'u' => \Drupal\Core\Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $t->tid], ['query' => $sq($sort)])->toString(),
        'a' => $cur == $t->tid];
    }
  }
  $sorts = [
    ['t' => t('最新'), 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq('created')])->toString(), 'a' => $sort === 'created'],
    ['t' => t('最热'), 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq('totalcount')])->toString(), 'a' => $sort === 'totalcount'],
  ];

  $label = $is_cat ? t('模特') : t('分类');
  $sheet_title = $is_cat ? t('全部模特') : t('全部分类');
  $bar_limit = 6;
  $lead = $tabs[0] ?? NULL;
  $rest = array_slice($tabs, 1);
  $bar = array_slice($rest, 0, $bar_limit);
  $seen = [];
  foreach ($bar as $item) {
    $seen[$item['u']] = TRUE;
  }
  foreach ($rest as $item) {
    if (!empty($item['a']) && empty($seen[$item['u']])) {
      $bar[] = $item;
      break;
    }
  }
  $show_more = count($rest) > $bar_limit;

  $pill = '<a class="xedc-pill{{ i.a ? \' is-active\' : \'\' }}" href="{{ i.u }}"{% if i.a %} aria-current="page"{% endif %}>{{ i.t }}</a>';
  $tpl = '<div class="photo-bar"><div class="photo-tabs-wrap">';
  $tpl .= '<div class="photo-tabs-scroll"><nav class="photo-tabs" aria-label="{{ label }}">';
  $tpl .= '{% if lead %}<a class="xedc-pill{{ lead.a ? \' is-active\' : \'\' }}" href="{{ lead.u }}"{% if lead.a %} aria-current="page"{% endif %}>{{ lead.t }}</a>{% endif %}';
  $tpl .= '{% for i in bar %}' . $pill . '{% endfor %}';
  $tpl .= '</nav><span class="photo-tabs-fade" hidden></span></div>';
  $tpl .= '{% if show_more %}<button type="button" class="xedc-pill photo-more" aria-haspopup="dialog" aria-expanded="false" aria-controls="photo-filter-sheet">{{ \'更多\'|t }}</button>{% endif %}';
  $tpl .= '</div><nav class="photo-sorts" aria-label="{{ \'排序\'|t }}">';
  $tpl .= '{% for i in sorts %}<a class="xedc-pill{{ i.a ? \' is-active\' : \'\' }}" href="{{ i.u }}"{% if i.a %} aria-current="page"{% endif %}>{{ i.t }}</a>{% endfor %}</nav></div>';
  $tpl .= '{% if show_more %}<div class="photo-sheet" id="photo-filter-sheet" hidden>';
  $tpl .= '<div class="photo-sheet__backdrop" data-photo-sheet-close></div>';
  $tpl .= '<div class="photo-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="photo-filter-sheet-title">';
  $tpl .= '<div class="photo-sheet__head"><h2 id="photo-filter-sheet-title">{{ sheet_title }}</h2>';
  $tpl .= '<button type="button" class="photo-sheet__close" data-photo-sheet-close aria-label="{{ \'关闭\'|t }}">&times;</button></div>';
  $tpl .= '<label class="photo-sheet__search"><span class="visually-hidden">{{ \'搜索 @label\'|t({\'@label\': label}) }}</span>';
  $tpl .= '<input type="search" placeholder="{{ \'搜索 @label\'|t({\'@label\': label}) }}" autocomplete="off" enterkeyhint="search"></label>';
  $tpl .= '<div class="photo-sheet__grid">{% for i in tabs %}' . $pill . '{% endfor %}</div>';
  $tpl .= '<p class="photo-sheet__empty" hidden>{{ \'没有匹配的@label\'|t({\'@label\': label}) }}</p></div></div>{% endif %}';
  $form['pills'] = ['#type' => 'inline_template', '#template' => $tpl,
    '#context' => [
      'lead' => $lead,
      'bar' => $bar,
      'tabs' => $tabs,
      'sorts' => $sorts,
      'label' => $label,
      'sheet_title' => $sheet_title,
      'show_more' => $show_more,
    ], '#weight' => -10];

  // 标签行（栏目页，最多 6 个，其余折叠）。
  if ($tags) {
    $t2 = '<div class="xedc-chips"><span class="xedc-chips-title">{{ \'标签\'|t }}</span>';
    $t2 .= '{% for c in tags|slice(0, 6) %}<a class="xedc-pill" href="{{ c.u }}">{{ c.t }}</a>{% endfor %}';
    $t2 .= '{% if tags|length > 6 %}<details class="xedc-more"><summary class="xedc-pill">{{ \'更多标签\'|t }}</summary>';
    $t2 .= '{% for c in tags|slice(6) %}<a class="xedc-pill" href="{{ c.u }}">{{ c.t }}</a>{% endfor %}</details>{% endif %}</div>';
    $form['chips'] = ['#type' => 'inline_template', '#template' => $t2,
      '#context' => ['tags' => $tags], '#weight' => -5];
  }

  foreach (['cat', 'sort_by', 'sort_order', 'actions'] as $f) {
    if (isset($form[$f])) { $form[$f]['#attributes']['class'][] = 'photo-hide'; }
  }
  $form['#cache']['contexts'][] = 'url.path';
  $form['#cache']['contexts'][] = 'url.query_args:sort_by';
  $form['#cache']['contexts'][] = 'url.query_args:model';
  $form['#cache']['tags'][] = 'node_list:photo';
  $form['#cache']['tags'][] = 'taxonomy_term_list:photo_category';
  $form['#cache']['tags'][] = 'taxonomy_term_list:models';
}

function xedc_form_comment_form_alter(array &$form, $form_state, $form_id) {
  $form['#attached']['library'][] = 'xedc/comment-form';
  $form_object = $form_state->getFormObject();
  $comment = $form_object instanceof \Drupal\comment\CommentForm ? $form_object->getEntity() : NULL;
  $is_edit = $comment instanceof \Drupal\comment\CommentInterface && !$comment->isNew();
  if (!$is_edit && $comment instanceof \Drupal\comment\CommentInterface) {
    $form['pid'] = [
      '#type' => 'hidden',
      '#default_value' => $comment->hasParentComment() ? (int) $comment->getParentComment()->id() : 0,
    ];
    $form['#entity_builders'][] = '_xedc_comment_apply_pid';
    $form['actions']['submit']['#ajax'] = [
      'callback' => '_xedc_comment_ajax_callback',
      'disable-refocus' => TRUE,
      'progress' => [
        'type' => 'throbber',
        'message' => '',
      ],
    ];
  }
  $form["actions"]["submit"]["#value"] = $is_edit ? t('保存修改') : t('发表评论');
  if (isset($form['comment_body']['widget'][0]['value']['#title']) && (string) $form['comment_body']['widget'][0]['value']['#title'] === '评论') {
    $form['comment_body']['widget'][0]['value']['#title'] = t('评论');
  }
  if ($is_edit) {
    $form['#attributes']['class'][] = 'comment-form--edit';
    $comment = $form_object->getEntity();
    $destination = \Drupal::request()->query->get('destination');
    $cancel_url = NULL;
    if (is_string($destination) && $destination !== '' && str_starts_with($destination, '/') && !str_starts_with($destination, '//')) {
      try {
        $cancel_url = \Drupal\Core\Url::fromUserInput($destination);
      }
      catch (\InvalidArgumentException $e) {
        $cancel_url = NULL;
      }
    }
    if (!$cancel_url) {
      $parent = $comment->getCommentedEntity();
      $cancel_url = $parent ? $parent->toUrl()->setOption('fragment', 'comment-' . $comment->id()) : \Drupal\Core\Url::fromRoute('<front>');
    }
    $form['actions']['cancel'] = [
      '#type' => 'link',
      '#title' => t('取消'),
      '#url' => $cancel_url,
      '#attributes' => ['class' => ['btn', 'btn-secondary', 'comment-form__cancel']],
      '#weight' => 20,
    ];
  }
  if (isset($form["actions"]["preview"])) { $form["actions"]["preview"]["#access"] = FALSE; }
  $form['#after_build'][] = '_xedc_comment_form_placeholder_after_build';
  if (\Drupal::currentUser()->isAnonymous() && isset($form["field_comment_image"])) { $form["field_comment_image"]["#access"] = FALSE; }
}

/**
 * Adds the comment placeholder after the comment textarea is built.
 */
function _xedc_comment_form_placeholder_after_build(array $form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $set_placeholder = function (array &$element) use (&$set_placeholder) {
    if (($element['#type'] ?? '') === 'textarea' && empty($element['#placeholder'])) {
      $element['#placeholder'] = t('写下你的评论…');
    }
    foreach (\Drupal\Core\Render\Element::children($element) as $key) {
      if (isset($element[$key]) && is_array($element[$key])) {
        $set_placeholder($element[$key]);
      }
    }
  };
  $set_placeholder($form);
  return $form;
}

/**
 * Copies the reply parent onto a new comment.
 *
 * The reply link sets input[name="pid"] without leaving the page.
 */
function _xedc_comment_apply_pid($entity_type, $entity, array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!$entity instanceof \Drupal\comment\CommentInterface || !$entity->isNew()) {
    return;
  }
  $pid = (int) $form_state->getValue('pid');
  if ($pid <= 0) {
    $entity->set('pid', NULL);
    return;
  }
  $parent = \Drupal\comment\Entity\Comment::load($pid);
  $same = $parent instanceof \Drupal\comment\CommentInterface
    && (int) $parent->getCommentedEntityId() === (int) $entity->getCommentedEntityId()
    && $parent->getCommentedEntityTypeId() === $entity->getCommentedEntityTypeId()
    && $parent->getFieldName() === $entity->getFieldName();
  $entity->set('pid', $same ? $pid : NULL);
}

/**
 * Ajax callback: insert the new comment beside the form, without a redirect.
 */
function _xedc_comment_ajax_callback(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): \Drupal\Core\Ajax\AjaxResponse {
  $response = new \Drupal\Core\Ajax\AjaxResponse();
  $messenger = \Drupal::messenger();
  if ($form_state->hasAnyErrors()) {
    $messages = [];
    foreach ($form_state->getErrors() as $message) {
      $text = trim(strip_tags((string) $message));
      if ($text !== '') {
        $messages[] = $text;
      }
    }
    if ($messages) {
      $form['xedc_error'] = [
        '#type' => 'html_tag',
        '#tag' => 'div',
        '#value' => implode(' ', $messages),
        '#attributes' => [
          'class' => ['comment-form__error'],
          'role' => 'alert',
        ],
        '#weight' => -100,
      ];
    }
    $messenger->deleteByType('error');
    $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', $form));
    return $response;
  }

  $form_object = $form_state->getFormObject();
  $comment = $form_object instanceof \Drupal\comment\CommentForm ? $form_object->getEntity() : NULL;
  if (!$comment instanceof \Drupal\comment\CommentInterface || !$comment->id()) {
    $messenger->deleteAll();
    $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', $form));
    return $response;
  }

  $visible = $comment->isPublished() && $comment->access('view');
  if ($visible) {
    $build = \Drupal::entityTypeManager()->getViewBuilder('comment')->view($comment);
    $response->addCommand(new \Drupal\Core\Ajax\BeforeCommand('form.comment-form', $build));
  }
  else {
    $response->addCommand(new \Drupal\Core\Ajax\BeforeCommand('form.comment-form', [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => (string) t('评论已提交，审核通过后才会显示。'),
      '#attributes' => [
        'class' => ['comment-form__notice'],
        'role' => 'status',
      ],
    ]));
  }
  $messenger->deleteAll();
  $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', _xedc_comment_fresh_form($comment)));
  $response->addCommand(new \Drupal\Core\Ajax\InvokeCommand('form.comment-form', 'xedcCommentDone', []));
  return $response;
}

/**
 * Builds an empty comment form that is not tied to the submission just saved.
 */
function _xedc_comment_fresh_form(\Drupal\comment\CommentInterface $comment): array {
  $entity = $comment->getCommentedEntity();
  $fresh = \Drupal\comment\Entity\Comment::create([
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'field_name' => $comment->getFieldName(),
    'comment_type' => $comment->bundle(),
  ]);
  $form_object = \Drupal::entityTypeManager()->getFormObject('comment', 'default');
  $form_object->setEntity($fresh);
  $form_state = new \Drupal\Core\Form\FormState();
  $form_state->setUserInput([]);
  $form_state->disableRedirect();
  return \Drupal::formBuilder()->buildForm($form_object, $form_state);
}

function xedc_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if (($variables['view_mode'] ?? '') === 'full' && $node->hasField('field_body')) {
    $variables['#attached']['library'][] = 'xedc/legal';
  }
  _xedc_vd_preprocess($variables);
  _xedc_add_meta($variables);
  $node = $variables['node'];
  if ($node->bundle() !== 'photo' || $variables['view_mode'] !== 'full') {
    return;
  }
  $variables['img_summary'] = '';
  if ($node->hasField('field_summary') && !$node->get('field_summary')->isEmpty()) {
    $summary = trim(str_replace(["\r\n", "\r"], "\n", (string) $node->get('field_summary')->value));
    if ($summary !== '') {
      $variables['img_summary'] = $summary;
    }
  }
  $variables['img_gallery'] = _xedc_photo_gallery_items($node, $variables);
  $variables['img_gallery_client'] = array_map(static function (array $item): array {
    return [
      'thumb' => $item['thumb'],
      'full' => $item['full'],
      'original' => $item['original'],
      'alt' => $item['alt'],
    ];
  }, $variables['img_gallery']);
  $variables['img_show_cover'] = !empty($variables['img_show_cover']);
  if (isset($variables['xedc_meta']) && is_array($variables['xedc_meta'])) {
    $variables['xedc_meta']['count'] = count($variables['img_gallery']);
  }
  _xedc_photo_jsonld($node, $variables);
  $st = \Drupal::entityTypeManager()->getStorage('node');
  $created = $node->getCreatedTime();
  $q = $st->getQuery()->accessCheck(TRUE)->condition('type', 'photo')->condition('status', 1);
  $prev = (clone $q)->condition('created', $created, '<')->sort('created', 'DESC')->range(0, 1)->execute();
  $next = (clone $q)->condition('created', $created, '>')->sort('created', 'ASC')->range(0, 1)->execute();
  $prev_node = $prev ? $st->load(reset($prev)) : NULL;
  $next_node = $next ? $st->load(reset($next)) : NULL;
  $variables['nav_prev'] = $prev_node ? _xedc_translated($prev_node) : NULL;
  $variables['nav_next'] = $next_node ? _xedc_translated($next_node) : NULL;
  $ids = [];
  $ex = [$node->id()];
  $pick = function ($extra) use ($q, &$ex) {
    $qq = clone $q;
    $qq->condition('nid', $ex, 'NOT IN');
    $extra($qq);
    $r = array_values($qq->sort('created', 'DESC')->range(0, 8)->execute());
    return $r;
  };
  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    $tids = array_column($node->get('field_tags')->getValue(), 'target_id');
    $r = $pick(function ($qq) use ($tids) { $qq->condition('field_tags', $tids, 'IN'); });
    $ids = array_merge($ids, $r); $ex = array_merge($ex, $r);
  }
  if (count($ids) < 8 && $node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $cid = $node->get('field_categories')->target_id;
    $r = $pick(function ($qq) use ($cid) { $qq->condition('field_categories', $cid); });
    $r = array_slice($r, 0, 8 - count($ids));
    $ids = array_merge($ids, $r); $ex = array_merge($ex, $r);
  }
  if (count($ids) < 8) {
    $r = array_slice($pick(function ($qq) {}), 0, 8 - count($ids));
    $ids = array_merge($ids, $r);
  }
  $variables['related_cards'] = _xedc_photo_related_cards(array_slice($ids, 0, 4), $variables);
  $variables['#cache']['tags'][] = 'node_list:photo';
}

/**
 * Fits an image inside a square without cropping or upscaling.
 *
 * @return array{0: int, 1: int}
 *   Width and height after scaling.
 */
function _xedc_fit_dimensions(int $width, int $height, int $max): array {
  if ($width < 1 || $height < 1) {
    return [0, 0];
  }
  $scale = min(1, $max / max($width, $height));
  return [(int) round($width * $scale), (int) round($height * $scale)];
}

/**
 * Gallery items in field_images order.
 *
 * The cover is included only when that file is not already in field_images.
 * The visible image and lightbox use photo_gallery_1300. Sheet thumbs use
 * photo_gallery_650. Neither style crops.
 */
function _xedc_photo_gallery_items($node, array &$variables): array {
  $cache_key = $node->id() . ':' . $node->language()->getId();
  $built = &drupal_static(__FUNCTION__, []);
  if (isset($built[$cache_key])) {
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $built[$cache_key]['tags']);
    if ($built[$cache_key]['show_cover']) {
      $variables['img_show_cover'] = TRUE;
    }
    return $built[$cache_key]['items'];
  }
  $tags_before = $variables['#cache']['tags'] ?? [];
  $full_style = \Drupal\image\Entity\ImageStyle::load('photo_gallery_1300');
  $thumb_style = \Drupal\image\Entity\ImageStyle::load('photo_gallery_650');
  $generator = \Drupal::service('file_url_generator');
  $variables['#cache']['tags'][] = 'config:image.style.photo_gallery_1300';
  $variables['#cache']['tags'][] = 'config:image.style.photo_gallery_650';
  $variables['img_show_cover'] = FALSE;

  $pending = [];
  if ($node->hasField('field_images') && !$node->get('field_images')->isEmpty()) {
    foreach ($node->get('field_images')->referencedEntities() as $media) {
      if ($media instanceof \Drupal\media\MediaInterface) {
        $pending[] = $media;
      }
    }
  }
  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $cover_media = $node->get('field_cover_image')->entity;
    if ($cover_media instanceof \Drupal\media\MediaInterface) {
      $pending[] = $cover_media;
    }
  }
  $fids = [];
  foreach ($pending as $media) {
    $fid = $media->getSource()->getSourceFieldValue($media);
    if ($fid) {
      $fids[] = $fid;
    }
  }
  $files = $fids ? \Drupal\file\Entity\File::loadMultiple(array_values(array_unique($fids))) : [];
  $file_of = static function ($media) use ($files) {
    if (!$media instanceof \Drupal\media\MediaInterface) {
      return NULL;
    }
    $fid = $media->getSource()->getSourceFieldValue($media);
    if (!$fid || !isset($files[$fid])) {
      return NULL;
    }
    $file = $files[$fid];
    return $file instanceof \Drupal\file\FileInterface ? $file : NULL;
  };
  $pack = function ($media) use ($file_of, $full_style, $thumb_style, $generator, &$variables) {
    $file = $file_of($media);
    if (!$file || !$media instanceof \Drupal\media\MediaInterface) {
      return NULL;
    }
    $uri = $file->getFileUri();
    $full_absolute = $full_style ? $full_style->buildUrl($uri) : $generator->generateAbsoluteString($uri);
    $thumb_absolute = $thumb_style ? $thumb_style->buildUrl($uri) : $full_absolute;
    $scene = '';
    $source_w = 0;
    $source_h = 0;
    if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $image_item = $media->get('field_media_image')->first();
      if ($image_item) {
        $scene = trim((string) $image_item->alt);
        $source_w = (int) $image_item->width;
        $source_h = (int) $image_item->height;
      }
    }
    [$width, $height] = _xedc_fit_dimensions($source_w, $source_h, 1300);
    [$thumb_w, $thumb_h] = _xedc_fit_dimensions($source_w, $source_h, 650);
    $full = $generator->transformRelative($full_absolute);
    $thumb = $generator->transformRelative($thumb_absolute);
    $variables['#cache']['tags'][] = 'media:' . $media->id();
    $variables['#cache']['tags'][] = 'file:' . $file->id();
    $srcset = $thumb . ' ' . max(1, $thumb_w) . 'w, ' . $full . ' ' . max(1, $width) . 'w';
    return [
      'thumb' => $thumb,
      'full' => $full,
      'full_absolute' => $full_absolute,
      'original' => $generator->transformRelative($generator->generateAbsoluteString($uri)),
      'srcset' => $srcset,
      'width' => $width,
      'height' => $height,
      'scene' => $scene,
      'alt' => '',
    ];
  };

  $images = [];
  $seen = [];
  if ($node->hasField('field_images') && !$node->get('field_images')->isEmpty()) {
    foreach ($node->get('field_images')->referencedEntities() as $media) {
      if (!$media instanceof \Drupal\media\MediaInterface || !$media->access('view')) {
        continue;
      }
      $item = $pack($media);
      if (!$item) {
        continue;
      }
      $images[] = $item;
      $seen[(int) $media->id()] = TRUE;
      $file = $file_of($media);
      if ($file) {
        $seen['f' . $file->id()] = TRUE;
      }
    }
  }

  $cover_items = [];
  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $cover = $node->get('field_cover_image')->entity;
    if (!$cover instanceof \Drupal\media\MediaInterface || !$cover->access('view')) {
      $cover = NULL;
    }
    $cover_file = $file_of($cover);
    $redundant = $cover instanceof \Drupal\media\MediaInterface && (
      isset($seen[(int) $cover->id()]) ||
      ($cover_file && isset($seen['f' . $cover_file->id()]))
    );
    if (!$redundant) {
      $item = $pack($cover);
      if ($item) {
        $cover_items[] = $item;
        $variables['img_show_cover'] = TRUE;
      }
    }
  }
  $items = array_merge($cover_items, $images);
  $title = trim((string) $node->label());
  foreach ($items as $index => &$item) {
    $scene = trim((string) ($item['scene'] ?? ''));
    $alt = (string) t('@title - 图@index', ['@title' => $title, '@index' => $index + 1]);
    if ($scene !== '') {
      $alt .= ' - ' . $scene;
    }
    $item['alt'] = $alt;
  }
  unset($item);
  $built[$cache_key] = [
    'items' => $items,
    'tags' => array_values(array_diff($variables['#cache']['tags'] ?? [], $tags_before)),
    'show_cover' => !empty($variables['img_show_cover']),
  ];
  return $items;
}

/**
 * Loads media, files and terms referenced by a view before rows render.
 */
function _xedc_warm_view_nodes(\Drupal\views\ViewExecutable $view, array $media_fields, array $term_fields): void {
  $nodes = [];
  foreach ($view->result as $result) {
    $node = $result->_entity ?? NULL;
    if ($node instanceof \Drupal\node\NodeInterface) {
      $nodes[$node->id()] = $node;
    }
  }
  if (!$nodes) {
    return;
  }
  if ($media_fields) {
    _xedc_warm_media_files($nodes, $media_fields);
  }
  if (!$term_fields) {
    return;
  }
  $tids = [];
  foreach ($nodes as $node) {
    foreach ($term_fields as $field) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
        foreach ($node->get($field)->getValue() as $item) {
          if (!empty($item['target_id'])) {
            $tids[] = $item['target_id'];
          }
        }
      }
    }
  }
  _xedc_warm_targets('taxonomy_term', $tids);
}

/**
 * Implements hook_views_pre_render().
 */
function xedc_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  $map = [
    'image_gallery' => [['field_cover_image'], ['field_categories']],
    'video_list' => [['field_video_cover'], ['field_categories', 'field_tags']],
    'article_list' => [['field_cover'], ['field_categories', 'field_tags']],
    'taxonomy_term' => [['field_video_cover'], ['field_categories', 'field_tags']],
  ];
  if (!isset($map[$view->id()])) {
    return;
  }
  [$media_fields, $term_fields] = $map[$view->id()];
  _xedc_warm_view_nodes($view, $media_fields, $term_fields);
}

function _xedc_warm_targets(string $entity_type, array $ids): array {
  $ids = array_values(array_unique(array_filter($ids)));
  if (!$ids) {
    return [];
  }
  return \Drupal::entityTypeManager()->getStorage($entity_type)->loadMultiple($ids);
}

/**
 * Loads referenced media and their files in two queries.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface[] $entities
 *   Entities that reference media.
 * @param string[] $fields
 *   Media reference field names.
 *
 * @return array{0: array, 1: array}
 *   Loaded media and files, keyed by id.
 */
function _xedc_warm_media_files(array $entities, array $fields): array {
  $media_ids = [];
  foreach ($entities as $entity) {
    if (!$entity instanceof \Drupal\Core\Entity\ContentEntityInterface) {
      continue;
    }
    foreach ($fields as $field) {
      if ($entity->hasField($field) && !$entity->get($field)->isEmpty()) {
        foreach ($entity->get($field)->getValue() as $item) {
          if (!empty($item['target_id'])) {
            $media_ids[] = $item['target_id'];
          }
        }
      }
    }
  }
  $medias = _xedc_warm_targets('media', $media_ids);
  $fids = [];
  foreach ($medias as $media) {
    if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $fids[] = $media->get('field_media_image')->target_id;
    }
    elseif ($media->hasField('thumbnail') && !$media->get('thumbnail')->isEmpty()) {
      $fids[] = $media->get('thumbnail')->target_id;
    }
  }
  return [$medias, _xedc_warm_targets('file', $fids)];
}

/**
 * Related photo cards for the detail page. Images stay lazy.
 *
 * @param int[] $ids
 *   Node IDs in display order.
 *
 * @return array<int, array<string, mixed>>
 *   Card variables for meitu-card.html.twig.
 */
function _xedc_photo_related_cards(array $ids, array &$variables): array {
  if (!$ids) {
    return [];
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $loaded = $storage->loadMultiple($ids);
  [$medias] = _xedc_warm_media_files($loaded, ['field_cover_image']);
  $style = \Drupal\image\Entity\ImageStyle::load('meitu_card_cover');
  $generator = \Drupal::service('file_url_generator');
  $date_formatter = \Drupal::service('date.formatter');
  $variables['#cache']['tags'][] = 'config:image.style.meitu_card_cover';
  $cards = [];
  foreach ($ids as $id) {
    $related = $loaded[$id] ?? NULL;
    if (!$related instanceof \Drupal\node\NodeInterface || !$related->access('view')) {
      continue;
    }
    $related = _xedc_translated($related);
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $related->getCacheTags());
    $img = '';
    if ($related->hasField('field_cover_image') && !$related->get('field_cover_image')->isEmpty()) {
      $media = $medias[$related->get('field_cover_image')->target_id] ?? $related->get('field_cover_image')->entity;
      if ($media instanceof \Drupal\media\MediaInterface && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
        $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $media->getCacheTags());
        $image_item = $media->get('field_media_image')->first();
        $file = $image_item ? $image_item->entity : NULL;
        if ($file instanceof \Drupal\file\FileInterface) {
          $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $file->getCacheTags());
          $absolute = $style ? $style->buildUrl($file->getFileUri()) : $generator->generateAbsoluteString($file->getFileUri());
          $img = $generator->transformRelative($absolute);
        }
      }
    }
    $cards[] = [
      'url' => $related->toUrl()->toString(),
      'title' => $related->label(),
      'img' => $img,
      'count' => $related->hasField('field_images') ? (int) $related->get('field_images')->count() : 0,
      'category' => _xedc_photo_card_badge($related, []),
      'date' => $date_formatter->format($related->getCreatedTime(), 'custom', 'Y-m-d'),
      'loading' => 'lazy',
      'fetchpriority' => '',
      'width' => $img ? 480 : 0,
      'height' => $img ? 800 : 0,
    ];
  }
  return $cards;
}

/**
 * ImageGallery JSON-LD whose contentUrl matches the visible img src.
 */
function _xedc_photo_jsonld(\Drupal\node\NodeInterface $node, array &$variables): void {
  $gallery = $variables['img_gallery'] ?? [];
  if (!$gallery) {
    return;
  }
  $images = [];
  foreach ($gallery as $item) {
    if (empty($item['full_absolute'])) {
      continue;
    }
    $image = [
      '@type' => 'ImageObject',
      'contentUrl' => $item['full_absolute'],
      'url' => $item['full_absolute'],
      'name' => $item['alt'],
      'caption' => $item['alt'],
    ];
    if (!empty($item['width']) && !empty($item['height'])) {
      $image['width'] = (int) $item['width'];
      $image['height'] = (int) $item['height'];
    }
    $images[] = $image;
  }
  if (!$images) {
    return;
  }
  $page = $node->toUrl()->setAbsolute()->toString();
  $breadcrumbs = [[
    '@type' => 'ListItem',
    'position' => 1,
    'name' => t('首页'),
    'item' => \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString(),
  ]];
  $position = 2;
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $term = $node->get('field_categories')->entity;
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term = _xedc_translated($term);
      $breadcrumbs[] = [
        '@type' => 'ListItem',
        'position' => $position++,
        'name' => $term->label(),
        'item' => $term->toUrl()->setAbsolute()->toString(),
      ];
    }
  }
  $breadcrumbs[] = [
    '@type' => 'ListItem',
    'position' => $position,
    'name' => $node->label(),
    'item' => $page,
  ];
  $description = '';
  if ($node->hasField('field_summary') && !$node->get('field_summary')->isEmpty()) {
    $description = trim(preg_replace('/\s+/u', ' ', (string) $node->get('field_summary')->value));
  }
  $data = [
    '@context' => 'https://schema.org',
    '@graph' => [
      [
        '@type' => 'ImageGallery',
        'name' => $node->label(),
        'url' => $page,
        'description' => $description,
        'image' => $images,
      ],
      [
        '@type' => 'BreadcrumbList',
        'itemListElement' => $breadcrumbs,
      ],
    ],
  ];
  $json = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
  if ($json === FALSE) {
    return;
  }
  $variables['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => \Drupal\Core\Render\Markup::create($json),
    ],
    'xedc_photo_detail_jsonld',
  ];
}

require_once __DIR__ . '/includes/auth.inc';

/**
 * Attaches a JSON-LD script to a render array.
 */
function _xedc_attach_jsonld(array &$render, array $data, string $id): void {
  $json = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
  if ($json === FALSE) {
    return;
  }
  $render['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value' => \Drupal\Core\Render\Markup::create($json),
    ],
    $id,
  ];
}

/**
 * BreadcrumbList for routes whose visible trail is not built in a node template.
 */
function _xedc_attach_route_breadcrumb(array &$attachments): void {
  $route = \Drupal::routeMatch();
  $name = $route->getRouteName();
  if (in_array($name, ['entity.node.canonical', 'view.image_gallery.page_1', 'view.image_gallery.page_2', 'view.image_gallery.page_3'], TRUE) || _xedc_is_photo_list_route()) {
    return;
  }
  $front = \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString();
  $items = [['name' => t('首页'), 'item' => $front]];
  if ($name === 'view.article_list.page_1') {
    $items[] = ['name' => t('文章'), 'item' => \Drupal\Core\Url::fromUserInput('/articles')->setAbsolute()->toString()];
  }
  elseif ($name === 'view.video_list.page_1') {
    $items[] = ['name' => t('视频'), 'item' => \Drupal\Core\Url::fromUserInput('/video')->setAbsolute()->toString()];
  }
  elseif ($name === 'xedc_models.page') {
    $items[] = ['name' => t('模特'), 'item' => \Drupal\Core\Url::fromUserInput('/models')->setAbsolute()->toString()];
  }
  elseif ($name === 'xedc_models.detail') {
    $term = $route->getParameter('taxonomy_term');
    $items[] = ['name' => t('模特'), 'item' => \Drupal\Core\Url::fromUserInput('/models')->setAbsolute()->toString()];
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term = _xedc_translated($term);
      $items[] = ['name' => $term->label(), 'item' => $term->toUrl()->setAbsolute()->toString()];
    }
  }
  elseif ($name === 'xedc_tags.index') {
    $items[] = ['name' => t('标签'), 'item' => \Drupal\Core\Url::fromUserInput('/tags')->setAbsolute()->toString()];
  }
  elseif ($name === 'xedc.html_sitemap') {
    $items[] = ['name' => t('站点地图'), 'item' => \Drupal\Core\Url::fromUserInput('/sitemap')->setAbsolute()->toString()];
  }
  elseif ($name === 'entity.taxonomy_term.canonical') {
    $term = $route->getParameter('taxonomy_term');
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term = _xedc_translated($term);
      $items[] = ['name' => $term->label(), 'item' => $term->toUrl()->setAbsolute()->toString()];
    }
  }
  else {
    return;
  }
  if (count($items) < 2) {
    return;
  }
  _xedc_attach_jsonld($attachments, _xedc_breadcrumb_data($items), 'xedc_route_breadcrumb');
}

/**
 * @param array<int, array{name: string, item: string}> $items
 */
function _xedc_breadcrumb_data(array $items): array {
  $list = [];
  foreach (array_values($items) as $index => $item) {
    $list[] = [
      '@type' => 'ListItem',
      'position' => $index + 1,
      'name' => $item['name'],
      'item' => $item['item'],
    ];
  }
  return [
    '@context' => 'https://schema.org',
    '@type' => 'BreadcrumbList',
    'itemListElement' => $list,
  ];
}

/**
 * Article breadcrumb matching the visible trail.
 */
function _xedc_article_breadcrumb(\Drupal\node\NodeInterface $node, array &$variables): void {
  $items = [
    ['name' => t('首页'), 'item' => \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString()],
    ['name' => t('文章'), 'item' => \Drupal\Core\Url::fromUserInput('/articles')->setAbsolute()->toString()],
  ];
  if (!empty($variables['xa_cat']['name']) && !empty($variables['xa_cat']['url'])) {
    $url = $variables['xa_cat']['url'];
    if (str_starts_with($url, '/')) {
      $url = \Drupal\Core\Url::fromUserInput($url)->setAbsolute()->toString();
    }
    $items[] = ['name' => $variables['xa_cat']['name'], 'item' => $url];
  }
  $items[] = ['name' => $node->label(), 'item' => $node->toUrl()->setAbsolute()->toString()];
  _xedc_attach_jsonld($variables, _xedc_breadcrumb_data($items), 'xedc_article_breadcrumb');
}

/**
 * Video breadcrumb matching the visible trail.
 */
function _xedc_video_breadcrumb(\Drupal\node\NodeInterface $node, array &$variables): void {
  $items = [
    ['name' => t('首页'), 'item' => \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString()],
    ['name' => t('视频'), 'item' => \Drupal\Core\Url::fromUserInput('/video')->setAbsolute()->toString()],
  ];
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $term = $node->get('field_categories')->entity;
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term = _xedc_translated($term);
      $items[] = ['name' => $term->label(), 'item' => $term->toUrl()->setAbsolute()->toString()];
    }
  }
  $items[] = ['name' => $node->label(), 'item' => $node->toUrl()->setAbsolute()->toString()];
  _xedc_attach_jsonld($variables, _xedc_breadcrumb_data($items), 'xedc_video_breadcrumb');
}

function xedc_preprocess_page_title(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['view.image_gallery.page_1', 'view.image_gallery.page_2'], TRUE)) {
    $variables['title'] = t('美图列表');
  }
  if ($route_name === 'xedc.html_sitemap') {
    $variables['title'] = t('站点地图');
  }
  if ($route_name === 'xedc_tags.index') {
    $variables['title'] = '';
    return;
  }
  if ($route_name === 'view.video_list.page_1') {
    $variables['title'] = t('视频列表页');
    return;
  }
  if ($route_name === 'view.article_list.page_1') {
    $variables['title'] = t('文章列表');
    return;
  }
  if (_xedc_search_is_route()) {
    [$q] = _xedc_search_params();
    $variables['title'] = $q !== '' ? t('搜索：@query', ['@query' => $q]) : t('搜索');
    $variables['#cache']['contexts'][] = 'url.query_args:q';
    return;
  }
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() === 'entity.comment.edit_form') {
    $variables['title'] = t('编辑评论');
  }
  $node = $route->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface && in_array($node->bundle(), ['photo', 'article', 'video'], TRUE)) {
    $variables['title'] = '';
    return;
  }
  $path = \Drupal::service('path.current')->getPath();
  if (preg_match('#^/taxonomy/term/(\d+)$#', $path, $m)) {
    $t = \Drupal\taxonomy\Entity\Term::load($m[1]);
    if ($t) {
      // 视频栏目的 H1 在 taxonomy-term--video-category 里，避免和页面标题重复。
      $variables['title'] = in_array($t->bundle(), ['tags', 'video_category'], TRUE) ? '' : _xedc_translated($t)->label();
    }
  }
  if (_xedc_is_photo_list_route() && ($page = _xedc_photo_current_page()) > 0) {
    $title = $variables['title'] ?? '';
    if (is_string($title) || $title instanceof \Stringable) {
      $variables['title'] = t('@title - 第 @page 页', ['@title' => (string) $title, '@page' => $page + 1]);
    }
  }
}

/**
 * Whether the current route renders the photo list view.
 */
function _xedc_is_photo_list_route(): bool {
  static $is_photo_list = NULL;
  if ($is_photo_list !== NULL) {
    return $is_photo_list;
  }
  $route = \Drupal::routeMatch();
  $name = $route->getRouteName();
  $is_photo_list = in_array($name, [
    'view.image_gallery.page_1',
    'view.image_gallery.page_2',
    'view.image_gallery.page_3',
  ], TRUE);
  if (!$is_photo_list && $name === 'entity.taxonomy_term.canonical') {
    $route_object = $route->getRouteObject();
    $is_photo_list = $route_object && $route_object->getDefault('_xt_view_id') === 'image_gallery';
  }
  return $is_photo_list;
}

/**
 * Returns the current zero-based photo list page.
 */
function _xedc_photo_current_page(): int {
  static $page = NULL;
  if ($page !== NULL) {
    return $page;
  }
  $raw = \Drupal::request()->query->get('page');
  if (is_array($raw)) {
    $raw = end($raw);
  }
  $page = is_numeric($raw) && (int) $raw > 0 ? (int) $raw : 0;
  return $page;
}

/**
 * Builds a clean photo list URL, ignoring sort parameters.
 */
function _xedc_photo_page_url(int $page, bool $absolute = FALSE): string {
  $query = $page > 0 ? ['page' => $page] : [];
  $url = \Drupal\Core\Url::fromUserInput(\Drupal::request()->getPathInfo(), ['query' => $query]);
  if ($absolute) {
    $url->setAbsolute();
  }
  return $url->toString();
}

/**
 * Returns a useful category badge for a photo card.
 */
function _xedc_photo_card_badge(\Drupal\node\NodeInterface $node, array $hidden_tids): string {
  if (!$node->hasField('field_categories') || $node->get('field_categories')->isEmpty()) {
    return '';
  }
  foreach ($node->get('field_categories')->referencedEntities() as $term) {
    if (!$term instanceof \Drupal\taxonomy\TermInterface || $term->bundle() !== 'photo_category') {
      continue;
    }
    if (in_array((int) $term->id(), $hidden_tids, TRUE)) {
      continue;
    }
    return _xedc_translated($term)->label();
  }
  return '';
}

/**
 * Replaces photo list rows with semantic, linked cards.
 */
function _xedc_photo_build_rows(array &$variables, \Drupal\views\ViewExecutable $view, array $hidden_tids): void {
  if (empty($view->result)) {
    return;
  }
  $style = \Drupal\image\Entity\ImageStyle::load('meitu_card_cover');
  $file_url = \Drupal::service('file_url_generator');
  $date_formatter = \Drupal::service('date.formatter');
  $cards = [];
  $tags = ['taxonomy_term_list', 'config:image.style.meitu_card_cover'];
  $index = 0;

  foreach ($view->result as $result) {
    $node = $result->_entity ?? NULL;
    if (!$node instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $node = _xedc_translated($node);
    $title = $node->label();
    $url = $node->toUrl()->toString();
    $cover_url = '';
    $media_tags = [];
    if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
      $media = $node->get('field_cover_image')->entity;
      if ($media instanceof \Drupal\media\MediaInterface) {
        $media_tags = $media->getCacheTags();
        if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
          $file = $media->get('field_media_image')->entity;
          if ($file instanceof \Drupal\file\FileInterface) {
            $uri = $file->getFileUri();
            $cover_url = $style ? $style->buildUrl($uri) : $file_url->generateString($uri);
            $media_tags = \Drupal\Core\Cache\Cache::mergeTags($media_tags, $file->getCacheTags());
          }
        }
      }
    }
    if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
      foreach ($node->get('field_categories')->referencedEntities() as $term) {
        if ($term instanceof \Drupal\taxonomy\TermInterface) {
          $media_tags = \Drupal\Core\Cache\Cache::mergeTags($media_tags, $term->getCacheTags());
        }
      }
    }
    $eager = $index < 2;
    $cards[] = [
      'url' => $url,
      'title' => $title,
      'img' => $cover_url,
      'count' => $node->hasField('field_images') ? (int) $node->get('field_images')->count() : 0,
      'category' => _xedc_photo_card_badge($node, $hidden_tids),
      'date' => $date_formatter->format($node->getCreatedTime(), 'custom', 'Y-m-d'),
      'loading' => $eager ? 'eager' : 'lazy',
      'fetchpriority' => $eager ? 'high' : '',
      'width' => $cover_url ? 480 : 0,
      'height' => $cover_url ? 800 : 0,
    ];
    $tags = \Drupal\Core\Cache\Cache::mergeTags($tags, $node->getCacheTags(), $media_tags);
    $index++;
  }

  if ($cards) {
    $variables['meitu_cards'] = $cards;
    $variables['rows'] = [];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $tags);
  }
}

/**
 * Adds pagination SEO links and JSON-LD to the photo list.
 */
function _xedc_photo_attach_seo(array &$variables, \Drupal\views\ViewExecutable $view, ?\Drupal\taxonomy\TermInterface $term): void {
  $page = _xedc_photo_current_page();
  $page_url = _xedc_photo_page_url($page, TRUE);
  if ($term instanceof \Drupal\taxonomy\TermInterface) {
    $term = _xedc_translated($term);
  }
  $name = $term ? $term->label() : t('美图列表');
  $description = '';
  if ($term) {
    $raw = (string) $term->get('description')->value;
    $description = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
    $description = mb_substr($description, 0, 160);
  }

  $items = [];
  $position = 1;
  foreach ($view->result as $result) {
    $node = $result->_entity ?? NULL;
    if (!$node instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $node = _xedc_translated($node);
    $items[] = [
      '@type' => 'ListItem',
      'position' => $position++,
      'url' => $node->toUrl()->setAbsolute()->toString(),
      'name' => $node->label(),
    ];
  }

  $breadcrumbs = [[
    '@type' => 'ListItem',
    'position' => 1,
    'name' => t('首页'),
    'item' => \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString(),
  ]];
  $breadcrumbs[] = [
    '@type' => 'ListItem',
    'position' => 2,
    'name' => $name,
    'item' => $term ? $term->toUrl()->setAbsolute()->toString() : _xedc_photo_page_url(0, TRUE),
  ];

  $data = [
    '@context' => 'https://schema.org',
    '@graph' => [
      [
        '@type' => 'BreadcrumbList',
        'itemListElement' => $breadcrumbs,
      ],
      [
        '@type' => 'CollectionPage',
        'name' => $name,
        'url' => $page_url,
        'description' => $description,
        'mainEntity' => [
          '@type' => 'ItemList',
          'itemListElement' => $items,
        ],
      ],
    ],
  ];
  $json = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
  if ($json !== FALSE) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'script',
        '#attributes' => ['type' => 'application/ld+json'],
        '#value' => \Drupal\Core\Render\Markup::create($json),
      ],
      'xedc_photo_jsonld',
    ];
  }

  $total = (int) $view->pager->getTotalItems();
  $per_page = max(1, (int) $view->pager->getItemsPerPage());
  $last_page = max(0, (int) ceil($total / $per_page) - 1);
  if ($page > 0) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'link',
        '#attributes' => ['rel' => 'prev', 'href' => _xedc_photo_page_url($page - 1, TRUE)],
      ],
      'xedc_photo_prev',
    ];
  }
  if ($page < $last_page) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'link',
        '#attributes' => ['rel' => 'next', 'href' => _xedc_photo_page_url($page + 1, TRUE)],
      ],
      'xedc_photo_next',
    ];
  }
}

/**
 * Preprocesses the image gallery view.
 */
function xedc_preprocess_views_view__image_gallery(array &$variables): void {
  $view = $variables['view'];
  if (!$view instanceof \Drupal\views\ViewExecutable || $view->id() !== 'image_gallery') {
    return;
  }
  $variables['#attached']['library'][] = 'xedc/photo-list';
  $total = (int) ($view->total_rows ?? 0);
  if (!empty($variables['header'])) {
    $variables['header'] = ['#markup' => t('共 @total 组美图', ['@total' => $total])];
  }
  if (!empty($variables['empty'])) {
    $variables['empty'] = ['#markup' => t('暂无美图')];
  }

  $term = NULL;
  if (!empty($view->args[0])) {
    $candidate = \Drupal\taxonomy\Entity\Term::load($view->args[0]);
    if ($candidate instanceof \Drupal\taxonomy\TermInterface && $candidate->bundle() === 'photo_category') {
      $term = _xedc_translated($candidate);
    }
  }
  $hidden_tids = [];
  if ($term) {
    $hidden_tids[] = (int) $term->id();
    foreach ($term->get('parent')->getValue() as $parent) {
      if (!empty($parent['target_id'])) {
        $hidden_tids[] = (int) $parent['target_id'];
      }
    }
    $hidden_tids = array_values(array_unique(array_filter($hidden_tids)));
  }
  _xedc_photo_build_rows($variables, $view, $hidden_tids);
  _xedc_photo_attach_seo($variables, $view, $term);

  if (!$term || _xedc_photo_current_page() !== 0) {
    return;
  }
  $raw = (string) $term->get('description')->value;
  $plain = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
  if ($plain === '') {
    return;
  }

  $format = $term->get('description')->format ?: filter_fallback_format();
  $text_id = 'term-intro-' . $term->id();
  $intro = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['term-intro'],
      'data-term-intro' => '',
    ],
    '#cache' => ['tags' => $term->getCacheTags()],
    '#attached' => ['library' => ['xedc/term-intro']],
    'text' => [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#attributes' => ['class' => ['term-intro__text'], 'id' => $text_id],
      '#value' => \Drupal\Core\Render\Markup::create((string) check_markup($raw, $format)),
    ],
    'toggle' => [
      '#markup' => \Drupal\Core\Render\Markup::create('<button type="button" class="term-intro__toggle" aria-expanded="false" aria-controls="' . \Drupal\Component\Utility\Html::escape($text_id) . '" hidden>' . t('展开') . '</button>'),
    ],
  ];
  $variables['xedc_photo_intro'] = $intro;
  $variables['#attached']['library'][] = 'xedc/term-intro';
  $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $term->getCacheTags());
}

/**
 * Removes the system breadcrumb on article/video pages with custom crumbs.
 */
/**
 * Translates the home crumb. Easy Breadcrumb stores the Chinese label as plain text.
 */
function xedc_preprocess_breadcrumb(array &$variables): void {
  if (empty($variables['breadcrumb']) || !is_array($variables['breadcrumb'])) {
    return;
  }
  foreach ($variables['breadcrumb'] as &$item) {
    if (!is_array($item) || !isset($item['text']) || $item['text'] instanceof \Drupal\Core\StringTranslation\TranslatableMarkup) {
      continue;
    }
    $text = trim((string) $item['text']);
    $replaced = FALSE;
    $url = $item['url'] ?? NULL;
    if ($url instanceof \Drupal\Core\Url && $url->isRouted()) {
      $params = $url->getRouteParameters();
      if (!empty($params['taxonomy_term'])) {
        $term = \Drupal\taxonomy\Entity\Term::load($params['taxonomy_term']);
        if ($term instanceof \Drupal\taxonomy\TermInterface) {
          $item['text'] = _xedc_translated($term)->label();
          $replaced = TRUE;
        }
      }
      elseif (!empty($params['node'])) {
        $node = \Drupal\node\Entity\Node::load($params['node']);
        if ($node instanceof \Drupal\node\NodeInterface) {
          $item['text'] = _xedc_translated($node)->label();
          $replaced = TRUE;
        }
      }
    }
    if (!$replaced && in_array($text, ['首页', '视频列表页', '文章列表', '全部标签', '美图列表', '模特', '标签', '搜索', '站点地图'], TRUE)) {
      $item['text'] = t($text);
    }
  }
  unset($item);
  $variables['#cache']['contexts'][] = 'languages:language_interface';
  $variables['#cache']['contexts'][] = 'languages:language_content';
}

/**
 * Translates Chinese pager labels stored on the photo list view.
 *
 * 「首页」already means Home, so the first-page tag uses a separate string.
 */
function xedc_preprocess_pager(array &$variables): void {
  $variables['#cache']['contexts'][] = 'languages:language_interface';
  $map = [
    '首页' => t('第一页'),
    '上一页' => t('上一页'),
    '下一页' => t('下一页'),
    '尾页' => t('尾页'),
    '下一页 ›' => t('下一页'),
  ];
  if (\Drupal::languageManager()->getCurrentLanguage()->getId() === 'zh-hans') {
    return;
  }
  foreach (['first', 'previous', 'next', 'last'] as $key) {
    if (empty($variables['items'][$key]['text'])) {
      continue;
    }
    $text = trim((string) $variables['items'][$key]['text']);
    if (isset($map[$text])) {
      $variables['items'][$key]['text'] = $map[$text];
    }
  }
}

function xedc_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? '') !== 'system_breadcrumb_block') {
    return;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface || !in_array($node->bundle(), ['article', 'video'], TRUE)) {
    return;
  }
  $variables['content'] = [];
  $attributes = $variables['attributes'] ?? [];
  if (is_object($attributes) && method_exists($attributes, 'addClass')) {
    $attributes->addClass('d-none');
  }
  else {
    $variables['attributes']['class'][] = 'd-none';
  }
  $variables['#cache']['contexts'][] = 'route';
}

/**
 * Marks the first detail image as eager/high priority.
 */
function xedc_preprocess_image(array &$variables): void {
  static $first_photo_image = FALSE;
  if ($first_photo_image || ($variables['style_name'] ?? '') !== 'images_450x800') {
    return;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'photo') {
    return;
  }
  $attributes = $variables['attributes'] ?? [];
  if (is_object($attributes) && method_exists($attributes, 'setAttribute')) {
    $attributes->setAttribute('loading', 'eager');
    $attributes->setAttribute('fetchpriority', 'high');
  }
  else {
    $variables['attributes']['loading'] = 'eager';
    $variables['attributes']['fetchpriority'] = 'high';
  }
  $first_photo_image = TRUE;
}

/**
 * Adds xedc_meta (count, size, date, models, tags) to full node view.
 */
function _xedc_add_meta(array &$variables) {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $variables['node'];
  $files = [];
  $mediaOf = [];
  $collect = function ($e) use (&$files, &$mediaOf) {
    if ($e instanceof \Drupal\file\FileInterface) {
      $files[$e->id()] = $e;
    }
    elseif ($e instanceof \Drupal\media\MediaInterface) {
      $sf = $e->getSource()->getConfiguration()['source_field'] ?? NULL;
      if ($sf && $e->hasField($sf)) {
        foreach ($e->get($sf)->referencedEntities() as $f) {
          if ($f instanceof \Drupal\file\FileInterface) {
            $files[$f->id()] = $f;
            $mediaOf[$f->id()] = $e->id();
          }
        }
      }
    }
  };
  foreach ($node->getFieldDefinitions() as $name => $def) {
    if (in_array($def->getType(), ['image', 'file', 'entity_reference']) && !$node->get($name)->isEmpty()) {
      foreach ($node->get($name)->referencedEntities() as $e) {
        $collect($e);
      }
    }
  }
  $orig = function_exists('xedc_quick_original_sizes') ? xedc_quick_original_sizes(array_values(array_unique($mediaOf))) : [];
  $size = 0;
  foreach ($files as $fid => $f) {
    $mid = $mediaOf[$fid] ?? NULL;
    $size += ($mid && !empty($orig[$mid])) ? (int) $orig[$mid] : (int) $f->getSize();
  }
  $terms = function ($field) use ($node) {
    $out = [];
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      foreach ($node->get($field)->referencedEntities() as $t) {
        $t = _xedc_translated($t);
        $out[] = ['label' => $t->label(), 'url' => $field === 'field_model' ? \Drupal\Core\Url::fromRoute('xedc_models.detail', ['taxonomy_term' => $t->id()])->toString() : $t->toUrl()->toString()];
      }
    }
    return $out;
  };
  $variables['xedc_meta'] = [
    'count' => count($files),
    'size' => (string) \Drupal\Core\StringTranslation\ByteSizeMarkup::create($size),
    'date' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'Y-m-d'),
    'models' => $terms('field_model'),
    'tags' => $terms('field_tags'),
    'categories' => $terms('field_categories'),
  ];
  $variables['#cache']['tags'][] = 'node:' . $node->id();
}

/**
 * 导航数据：main 菜单 + photo_category 两级术语（挂在标题为“美图”的菜单项下）。
 */
function xedc_nav_build(array &$variables) {
  $mt = \Drupal::menuTree();
  $p = new \Drupal\Core\Menu\MenuTreeParameters();
  $p->setMaxDepth(1)->onlyEnabledLinks();
  $tree = $mt->transform($mt->load('main', $p), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $cats = [];
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('photo_category', 0, 2);
  $labels = _xedc_term_label_map($terms);
  foreach ($terms as $t) {
    $node = [
      'name' => $labels[(int) $t->tid] ?? $t->name,
      'url' => \Drupal\Core\Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $t->tid])->toString(),
      'children' => [],
    ];
    if ((int) $t->depth === 0) {
      $cats[$t->tid] = $node;
    }
    elseif (isset($cats[$t->parents[0]])) {
      $cats[$t->parents[0]]['children'][] = $node;
    }
  }

  $items = [];
  foreach ($tree as $el) {
    $title = (string) $el->link->getTitle();
    $path = parse_url($el->link->getUrlObject()->toString(), PHP_URL_PATH) ?? '';
    $items[] = [
      'title' => $title,
      'url' => $el->link->getUrlObject()->toString(),
      'cats' => (bool) preg_match('#/meitu$#', $path) ? array_values($cats) : [],
    ];
  }

  $variables['xn'] = ['items' => $items];
  $variables['#cache']['tags'][] = 'config:system.menu.main';
  $variables['#cache']['tags'][] = 'taxonomy_term_list:photo_category';
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';
  $variables['#cache']['contexts'][] = 'languages:language_interface';
  $variables['#cache']['contexts'][] = 'languages:language_content';
}

/**
 * Short language switcher links for the custom header.
 */
function _xedc_language_links(): array {
  $manager = \Drupal::languageManager();
  if (!$manager->isMultilingual()) {
    return [];
  }
  $current = $manager->getCurrentLanguage()->getId();
  $labels = _xedc_language_switch_labels();
  $request = \Drupal::request();
  $path = $request->getPathInfo() ?: '/';
  $query = $request->query->all();
  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  $items = [];
  foreach ($manager->getNativeLanguages() as $language) {
    $id = $language->getId();
    if ($is_front) {
      $url = \Drupal\Core\Url::fromRoute('<front>', [], [
        'language' => $language,
        'query' => $query,
      ]);
    }
    else {
      $url = \Drupal\Core\Url::fromUri('internal:' . $path, [
        'language' => $language,
        'query' => $query,
      ]);
    }
    $label = $labels[$id] ?? $language->getName();
    $items[] = [
      'id' => $id,
      'label' => $label,
      'name' => $language->getName(),
      'url' => $url->toString(),
      'current' => $id === $current,
    ];
  }
  return $items;
}

/**
 * Native language names. These stay the same in every interface language.
 */
function _xedc_language_switch_labels(): array {
  return [
    'zh-hans' => '中文',
    'en' => 'English',
    'ru' => 'Русский',
    'ja' => '日本語',
  ];
}

/**
 * Content entity in the current content language.
 */
function _xedc_translated($entity) {
  if (!$entity instanceof \Drupal\Core\Entity\ContentEntityInterface) {
    return $entity;
  }
  $translated = \Drupal::service('entity.repository')->getTranslationFromContext($entity);
  return $translated instanceof \Drupal\Core\Entity\ContentEntityInterface ? $translated : $entity;
}

/**
 * Translated term labels for tree rows, loaded in one query.
 *
 * @param object[] $rows
 *   Rows from TermStorageInterface::loadTree().
 *
 * @return array<int, string>
 *   Labels keyed by term id.
 */
function _xedc_term_label_map(array $rows): array {
  $ids = [];
  foreach ($rows as $row) {
    $id = (int) ($row->tid ?? 0);
    if ($id > 0) {
      $ids[$id] = $id;
    }
  }
  if (!$ids) {
    return [];
  }
  $labels = [];
  $repository = \Drupal::service('entity.repository');
  foreach (\Drupal\taxonomy\Entity\Term::loadMultiple($ids) as $id => $term) {
    $labels[(int) $id] = $repository->getTranslationFromContext($term)->label();
  }
  return $labels;
}

/**
 * Styled image URL for a video cover. Falls back to the original file.
 */
function _xedc_vd_image_url($media, string $style_name): string {
  if (!$media instanceof \Drupal\media\MediaInterface || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return _xedc_vd_file_url($media);
  }
  $item = $media->get('field_media_image')->first();
  $file = $item ? $item->entity : NULL;
  if (!$file instanceof \Drupal\file\FileInterface) {
    return '';
  }
  $style = \Drupal\image\Entity\ImageStyle::load($style_name);
  $generator = \Drupal::service('file_url_generator');
  $absolute = $style ? $style->buildUrl($file->getFileUri()) : $generator->generateAbsoluteString($file->getFileUri());
  return $generator->transformRelative($absolute);
}

function _xedc_vd_file_url($entity) {
  if (!$entity) return '';
  if ($entity->getEntityTypeId() === 'media') {
    $fid = $entity->getSource()->getSourceFieldValue($entity);
    $entity = \Drupal\file\Entity\File::load($fid);
  }
  if (!$entity || !method_exists($entity, 'getFileUri')) return '';
  return \Drupal::service('file_url_generator')->generateString($entity->getFileUri());
}

function _xedc_vd_preprocess(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'video' || $variables['view_mode'] !== 'full') return;
  $vd = ['cover' => '', 'cover_width' => 0, 'cover_height' => 0, 'type' => '', 'src' => '', 'mime' => ''];
  if ($node->hasField('field_video_cover') && !$node->get('field_video_cover')->isEmpty()) {
    $cover_media = $node->get('field_video_cover')->entity;
    if ($cover_media instanceof \Drupal\media\MediaInterface && $cover_media->hasField('field_media_image')) {
      $cover_image = $cover_media->get('field_media_image')->first();
      if ($cover_image) {
        $vd['cover_width'] = (int) $cover_image->get('width')->getValue();
        $vd['cover_height'] = (int) $cover_image->get('height')->getValue();
      }
    }
    $vd['cover'] = _xedc_vd_image_url($cover_media, 'xa_hero');
    if ($vd['cover_width'] > 1200 && $vd['cover_height'] > 0) {
      $scale = 1200 / $vd['cover_width'];
      $vd['cover_height'] = (int) round($vd['cover_height'] * $scale);
      $vd['cover_width'] = 1200;
    }
  }
  $src = '';
  if ($node->hasField('field_video_file') && !$node->get('field_video_file')->isEmpty()) {
    $e = $node->get('field_video_file')->entity;
    $src = _xedc_vd_file_url($e);
    if ($e && $e->getEntityTypeId() === 'file') $vd['mime'] = $e->getMimeType();
  }
  if (!$src && $node->hasField('field_video_url') && !$node->get('field_video_url')->isEmpty()) {
    $item = $node->get('field_video_url')->first();
    $src = trim((string) ($item->uri ?? $item->value ?? ''));
    $src = preg_replace('#^(internal:|base:)#', '', $src);
  }
  if ($src) {
    if (preg_match('#youtube\.com/shorts/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.youtube.com/embed/' . $m[1] . '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#(?:x|twitter)\.com/[\w]+/status/(\d+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://platform.twitter.com/embed/Tweet.html?id=' . $m[1];
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#instagram\.com/(?:p|reel|reels|tv)/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.instagram.com/p/' . $m[1] . '/embed';
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#youtube\.com/watch\?v=([\w-]+)#', $src, $m) || preg_match('#youtu\.be/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.youtube.com/embed/' . $m[1] . '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
    } elseif (preg_match('#bilibili\.com/video/(BV\w+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://player.bilibili.com/player.html?autoplay=1&rel=0&playsinline=1&modestbranding=1&bvid=' . $m[1];
    } elseif (preg_match('#\.m3u8(\?.*)?$#i', $src)) {
      $vd['type'] = 'hls'; $vd['src'] = $src;
    } elseif (preg_match('#\.(mp4|webm|ogg|mov)(\?.*)?$#i', $src) || $vd['mime']) {
      $vd['type'] = 'video'; $vd['src'] = $src;
    } else {
      $vd['type'] = 'iframe'; $vd['src'] = $src;
    }
  }

  $cur = $node->id();
  $base = function () use ($cur) {
    return \Drupal::entityQuery('node')->accessCheck(TRUE)->condition('type', 'video')->condition('status', 1)->condition('nid', $cur, '<>')->sort('created', 'DESC');
  };
  $rel = [];
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $tids = array_column($node->get('field_categories')->getValue(), 'target_id');
    $rel = array_values($base()->condition('field_categories', $tids, 'IN')->range(0, 5)->execute());
  }
  if (count($rel) < 5) {
    $more = $base();
    if ($rel) $more->condition('nid', $rel, 'NOT IN');
    $rel = array_merge($rel, array_values($more->range(0, 5 - count($rel))->execute()));
  }
  $variables['vd_related'] = _xedc_vd_cards($rel, $variables);
  $variables['vd_latest'] = _xedc_vd_cards(array_values($base()->range(0, 6)->execute()), $variables);
  $cats = [];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('video_category', 0, 1, TRUE) as $t) {
    $cats[] = ['name' => _xedc_translated($t)->label(), 'tid' => $t->id()];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $t->getCacheTags());
  }
  $variables['vd_cats'] = $cats;
  $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], [
    'node_list:video',
    'taxonomy_term_list:video_category',
  ]);
  $variables['vd_cache'] = ['#cache' => ['tags' => ['node_list:video', 'taxonomy_term_list:video_category']]];
  $variables['vd'] = $vd;
  _xedc_video_breadcrumb($node, $variables);
}

function _xedc_vd_cards(array $nids, array &$variables = []) {
  $out = [];
  if (!$nids) return $out;
  $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);
  _xedc_warm_media_files($nodes, ['field_video_cover']);
  if ($variables) {
    $variables['#cache']['tags'][] = 'config:image.style.video_cover';
  }
  foreach ($nids as $nid) {
    $n = $nodes[$nid] ?? NULL;
    if (!$n instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $n = _xedc_translated($n);
    if ($variables) {
      $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $n->getCacheTags());
    }
    $cover = '';
    if ($n->hasField('field_video_cover') && !$n->get('field_video_cover')->isEmpty()) {
      $media = $n->get('field_video_cover')->entity;
      if ($variables && $media) {
        $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $media->getCacheTags());
      }
      $cover = _xedc_vd_image_url($media, 'video_cover');
    }
    $d = $n->hasField('field_duration') ? (int) $n->get('field_duration')->value : 0;
    $out[] = ['title' => $n->label(), 'url' => $n->toUrl()->toString(), 'cover' => $cover, 'dur' => $d ? sprintf('%d:%02d', intdiv($d, 60), $d % 60) : '', 'alt' => $n->label()];
  }
  return $out;
}

require_once __DIR__ . '/xedc.search.inc';

/**
 * 视频列表页加载网格样式。
 */
function xedc_preprocess_views_view__video_list(array &$variables): void {
  $variables['title'] = t('视频列表页');
  _xedc_video_page_attach($variables);
  $view = $variables['view'] ?? NULL;
  $total = $view ? (int) ($view->total_rows ?? 0) : 0;
  if (!empty($variables['header'])) {
    $variables['header'] = ['#markup' => t('共 @total 个视频', ['@total' => $total])];
  }
  if (!empty($variables['empty'])) {
    $variables['empty'] = ['#markup' => t('暂无视频')];
  }
}

/**
 * 视频分类术语页复用同一套网格。该 View 只给 video_category 使用。
 */
/**
 * Shows the term name and description in the current content language.
 */
function xedc_preprocess_taxonomy_term(array &$variables): void {
  $term = $variables['term'] ?? NULL;
  if (!$term instanceof \Drupal\taxonomy\TermInterface) {
    return;
  }
  $term = _xedc_translated($term);
  $variables['term'] = $term;
  $variables['name'] = $term->label();
  if (isset($variables['content']['description']) && $term->hasField('description')) {
    $variables['content']['description'] = $term->get('description')->view(['label' => 'hidden']);
  }
  $variables['#cache']['contexts'][] = 'languages:language_content';
}

function xedc_preprocess_views_view__taxonomy_term(array &$variables): void {
  _xedc_video_page_attach($variables);
  if (!empty($variables['empty'])) {
    $variables['empty'] = ['#markup' => t('该分类下暂无视频')];
  }
}

/**
 * 给视频列表容器加上页面 class，并加载布局 CSS。
 */
function _xedc_video_page_attach(array &$variables): void {
  $attributes = $variables['attributes'] ?? NULL;
  if (is_object($attributes) && method_exists($attributes, 'addClass')) {
    $attributes->addClass('xedc-video-page');
  }
  $variables['#attached']['library'][] = 'xedc/video_list';
}

/**
 * 视频 teaser 卡片数据。时长来自 field_duration（秒），封面用 video_cover。
 */
function xedc_preprocess_node__video__teaser(array &$variables): void {
  $node = _xedc_translated($variables['node']);
  $variables['node'] = $node;
  $variables['url'] = $node->toUrl()->toString();
  $variables['label'] = $node->label();
  $variables['vc_cover'] = '';
  $variables['vc_cover_alt'] = $node->label();
  $variables['vc_duration'] = '';
  $variables['vc_category'] = NULL;
  $variables['vc_tags'] = [];

  $seconds = 0;
  if ($node->hasField('field_duration') && !$node->get('field_duration')->isEmpty()) {
    $seconds = (int) $node->get('field_duration')->value;
  }
  if ($seconds > 0) {
    if ($seconds >= 3600) {
      $variables['vc_duration'] = sprintf('%d:%02d:%02d', intdiv($seconds, 3600), intdiv($seconds % 3600, 60), $seconds % 60);
    }
    else {
      $variables['vc_duration'] = sprintf('%d:%02d', intdiv($seconds, 60), $seconds % 60);
    }
  }

  if ($node->hasField('field_video_cover') && !$node->get('field_video_cover')->isEmpty()) {
    $media = $node->get('field_video_cover')->entity;
    if ($media instanceof \Drupal\media\MediaInterface && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $item = $media->get('field_media_image')->first();
      $file = $item ? $item->entity : NULL;
      if ($file instanceof \Drupal\file\FileInterface) {
        $alt = trim((string) $item->alt);
        if ($alt !== '') {
          $variables['vc_cover_alt'] = $alt;
        }
        $style = \Drupal\image\Entity\ImageStyle::load('video_cover');
        $gen = \Drupal::service('file_url_generator');
        $uri = $file->getFileUri();
        $url = $style ? $style->buildUrl($uri) : $gen->generateAbsoluteString($uri);
        $variables['vc_cover'] = $gen->transformRelative($url);
        $tags = \Drupal\Core\Cache\Cache::mergeTags($file->getCacheTags(), $media->getCacheTags());
        if ($style) {
          $tags = \Drupal\Core\Cache\Cache::mergeTags($tags, $style->getCacheTags());
        }
        $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $tags);
      }
    }
  }

  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $term = $node->get('field_categories')->entity;
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $term = _xedc_translated($term);
      $variables['vc_category'] = [
        'name' => $term->label(),
        'url' => $term->toUrl()->toString(),
      ];
      $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $term->getCacheTags());
    }
  }

  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    foreach ($node->get('field_tags')->referencedEntities() as $tag) {
      if (!$tag instanceof \Drupal\taxonomy\TermInterface) {
        continue;
      }
      $tag = _xedc_translated($tag);
      $variables['vc_tags'][] = [
        'name' => $tag->label(),
        'url' => $tag->toUrl()->toString(),
      ];
      $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $tag->getCacheTags());
    }
  }
}

/**
 * 文章列表卡片数据。
 */
function xedc_preprocess_node__article__teaser(array &$variables): void {
  $node = _xedc_translated($variables['node']);
  $variables['node'] = $node;
  $variables['url'] = $node->toUrl()->toString();
  $variables['label'] = $node->label();
  $gen = \Drupal::service('file_url_generator');

  // 封面
  $variables['xa_cover'] = '';
  if (!$node->get('field_cover')->isEmpty()) {
    $media = $node->get('field_cover')->entity;
    $file = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->entity : NULL;
    if ($file) {
      $uri = $file->getFileUri();
      $style = \Drupal\image\Entity\ImageStyle::load('xa_cover');
      $url = $style ? $style->buildUrl($uri) : $gen->generateAbsoluteString($uri);
      $variables['xa_cover'] = $gen->transformRelative($url);
      $cover_tags = $media->getCacheTags();
      $cover_tags = \Drupal\Core\Cache\Cache::mergeTags($cover_tags, $file->getCacheTags());
      if ($style) {
        $cover_tags = \Drupal\Core\Cache\Cache::mergeTags($cover_tags, $style->getCacheTags());
      }
      $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $cover_tags);
    }
  }

  // 摘要（为空时截取正文前 120 字）+ 阅读时长
  $body = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('field_body')->value)));
  $summary = trim((string) $node->get('field_summary')->value);
  $variables['xa_summary'] = $summary !== '' ? $summary : mb_substr($body, 0, 120);
  $variables['xa_read'] = max(1, (int) ceil(mb_strlen(str_replace(' ', '', $body)) / 400));

  // 分类（点击后在列表页筛选）
  $variables['xa_cat'] = NULL;
  if ($term = $node->get('field_categories')->entity) {
    $term = _xedc_translated($term);
    $variables['xa_cat'] = [
      'name' => $term->label(),
      'url' => \Drupal\Core\Url::fromUserInput('/articles', ['query' => ['cat' => $term->id()]])->toString(),
    ];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $term->getCacheTags());
  }

  // 标签，最多 3 个
  $tags = [];
  foreach (array_slice($node->get('field_tags')->referencedEntities(), 0, 3) as $t) {
    $t = _xedc_translated($t);
    $tags[] = ['name' => $t->label(), 'url' => $t->toUrl()->toString()];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $t->getCacheTags());
  }
  $variables['xa_tags'] = $tags;

  // 来源 / 日期 / 阅读量
  $variables['xa_source'] = (string) $node->get('field_source')->value;
  $item = $node->get('field_published_at')->first();
  $ts = ($item && $item->date) ? $item->date->getTimestamp() : $node->getCreatedTime();
  $variables['xa_date'] = \Drupal::service('date.formatter')->format($ts, 'custom', 'Y-m-d');
  $n = (int) $node->get('field_views')->value;
  $variables['xa_views'] = $n >= 10000 ? t('@count万', ['@count' => round($n / 10000, 1)]) : $n;
}

/**
 * 文章列表页：分类胶囊 + 搜索框数据。
 */
function xedc_preprocess_views_view__article_list(array &$variables): void {
  $variables['title'] = t('文章列表');
  $req = \Drupal::request()->query;
  $raw_cat = $req->get('cat');
  $active = 0;
  if ($raw_cat !== NULL) {
    $is_scalar = is_string($raw_cat) || is_int($raw_cat);
    if (!$is_scalar || !preg_match('/^\d+$/', (string) $raw_cat)) {
      throw new \Symfony\Component\HttpKernel\Exception\NotFoundHttpException();
    }
    $cat = (int) $raw_cat;
    $term = $cat > 0 ? \Drupal\taxonomy\Entity\Term::load($cat) : NULL;
    if (!$term || $term->bundle() !== 'article_category') {
      throw new \Symfony\Component\HttpKernel\Exception\NotFoundHttpException();
    }
    $active = $cat;
  }
  $articles_url = \Drupal\Core\Url::fromUserInput('/articles')->toString();
  $chips = [['name' => t('全部'), 'url' => $articles_url, 'active' => !$active]];
  $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('article_category');
  $labels = _xedc_term_label_map($tree);
  foreach ($tree as $t) {
    $chips[] = ['name' => $labels[(int) $t->tid] ?? $t->name, 'url' => $articles_url . '?cat=' . $t->tid, 'active' => $active === (int) $t->tid];
  }
  $variables['xa_chips'] = $chips;
  $variables['#cache']['tags'][] = 'taxonomy_term_list:article_category';
  $variables['#cache']['tags'][] = 'taxonomy_term_list:tags';
  $variables['#cache']['contexts'][] = 'languages:language_content';
  $variables['xa_cat'] = $active ?: '';
  $variables['xa_q'] = (string) $req->get('q', '');
  $variables['xa_side'] = xedc_xa_side();
  $variables['xa_pager'] = xedc_xa_pager($variables['view']);
}

/**
 * 文章列表侧栏：分类(带数量)、热门文章、热门标签。
 */
function xedc_xa_side(): array {
  $db = _xedc_database();
  $active = (int) \Drupal::request()->query->get('cat');

  $count_by = function (string $field) use ($db): array {
    $col = $field . '_target_id';
    $q = $db->select('node__' . $field, 'f');
    $q->innerJoin('node_field_data', 'n', 'n.nid = f.entity_id AND n.vid = f.revision_id');
    $q->condition('n.status', 1)->condition('n.type', 'article')->condition('f.deleted', 0);
    $q->condition('n.langcode', \Drupal::languageManager()->getCurrentLanguage(\Drupal\Core\Language\LanguageInterface::TYPE_CONTENT)->getId());
    $q->addField('f', $col, 'tid');
    $q->addExpression('COUNT(DISTINCT n.nid)', 'cnt');
    $q->groupBy('f.' . $col);
    $q->addTag('node_access');
    return $q->execute()->fetchAllKeyed();
  };

  // 分类
  $total = (int) \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', 'article')->condition('status', 1)->count()->execute();
  $articles_url = \Drupal\Core\Url::fromUserInput('/articles')->toString();
  $cats = [['name' => t('全部'), 'url' => $articles_url, 'count' => $total, 'active' => !$active]];
  $cc = $count_by('field_categories');
  $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('article_category');
  $labels = _xedc_term_label_map($tree);
  foreach ($tree as $t) {
    if (empty($cc[$t->tid]) && $active !== (int) $t->tid) { continue; }
    $cats[] = ['name' => $labels[(int) $t->tid] ?? $t->name, 'url' => $articles_url . '?cat=' . $t->tid,
      'count' => (int) ($cc[$t->tid] ?? 0), 'active' => $active === (int) $t->tid];
  }

  // 热门文章
  $ids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', 'article')->condition('status', 1)
    ->sort('field_views', 'DESC')->sort('created', 'DESC')->range(0, 5)->execute();
  $nodes = \Drupal\node\Entity\Node::loadMultiple($ids);
  $hot = [];
  foreach ($ids as $id) {
    if (isset($nodes[$id])) {
      $hot_node = _xedc_translated($nodes[$id]);
      $hot[] = ['title' => $hot_node->label(), 'url' => $hot_node->toUrl()->toString()];
    }
  }

  // 热门标签
  $tc = $count_by('field_tags');
  arsort($tc);
  $tids = array_slice(array_keys($tc), 0, 12);
  $terms = \Drupal\taxonomy\Entity\Term::loadMultiple($tids);
  $tags = [];
  foreach ($tids as $id) {
    if (isset($terms[$id])) {
      $tag = _xedc_translated($terms[$id]);
      $tags[] = ['name' => $tag->label(), 'url' => $tag->toUrl()->toString()];
    }
  }

  return ['cats' => $cats, 'hot' => $hot, 'tags' => $tags];
}

/**
 * 文章列表分页数据。
 */
function xedc_xa_pager($view): array {
  if (!$view || !$view->pager) {
    return [];
  }
  $pager = $view->pager;
  $per = (int) $pager->getItemsPerPage();
  $total = (int) $pager->getTotalItems();
  if ($per < 1 || $total <= $per) {
    return [];
  }
  $last = (int) ceil($total / $per);
  $cur = (int) $pager->getCurrentPage() + 1;
  $q = \Drupal::request()->query->all();
  unset($q['page']);
  $href = function (int $n) use ($q) {
    $p = $q + ($n > 1 ? ['page' => $n - 1] : []);
    return \Drupal\Core\Url::fromUserInput('/articles')->toString() . ($p ? '?' . http_build_query($p) : '');
  };
  $win = array_unique(array_filter([1, $cur - 1, $cur, $cur + 1, $last], fn($n) => $n >= 1 && $n <= $last));
  sort($win);
  $items = [];
  $prev = 0;
  foreach ($win as $n) {
    if ($prev && $n - $prev > 1) {
      $items[] = ['gap' => TRUE];
    }
    $items[] = ['n' => $n, 'url' => $href($n), 'active' => $n === $cur];
    $prev = $n;
  }
  return [
    'items' => $items, 'cur' => $cur, 'last' => $last,
    'prev' => $cur > 1 ? $href($cur - 1) : '',
    'next' => $cur < $last ? $href($cur + 1) : '',
  ];
}

/**
 * 文章详情页数据（v2）。
 */
function xedc_preprocess_node__article__full(array &$variables): void {
  $node = $variables['node'];
  $gen = \Drupal::service('file_url_generator');
  $fmt = \Drupal::service('date.formatter');
  $q = function () {
    return \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('type', 'article')->condition('status', 1);
  };
  $views = function ($n) {
    $n = (int) $n;
    return $n >= 10000 ? t('@count万', ['@count' => round($n / 10000, 1)]) : $n;
  };
  $pick = function (array $ids, callable $map) {
    $out = [];
    $nodes = \Drupal\node\Entity\Node::loadMultiple($ids);
    foreach ($ids as $id) {
      if (isset($nodes[$id])) {
        $out[] = $map($nodes[$id]);
      }
    }
    return $out;
  };

  // 封面
  $variables['xa_cover'] = '';
  $variables['xa_cover_width'] = 0;
  $variables['xa_cover_height'] = 0;
  if (!$node->get('field_cover')->isEmpty()) {
    $media = $node->get('field_cover')->entity;
    $file = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->entity : NULL;
    if ($file) {
      $style = \Drupal\image\Entity\ImageStyle::load('xa_hero');
      $url = $style ? $style->buildUrl($file->getFileUri()) : $gen->generateAbsoluteString($file->getFileUri());
      $variables['xa_cover'] = $gen->transformRelative($url);
    }
  }
  // 封面显示开关 + 横竖图判断
  $variables['xa_cover_portrait'] = FALSE;
  if ($node->hasField('field_show_cover') && !$node->get('field_show_cover')->isEmpty() && !(int) $node->get('field_show_cover')->value) {
    $variables['xa_cover'] = '';
  }
  if ($variables['xa_cover'] && ($m = $node->get('field_cover')->entity) && $m->hasField('field_media_image') && !$m->get('field_media_image')->isEmpty()) {
    $iw = (int) $m->get('field_media_image')->width;
    $ih = (int) $m->get('field_media_image')->height;
    if ($iw > 0 && $ih > 0) {
      $variables['xa_cover_width'] = $iw;
      $variables['xa_cover_height'] = $ih;
      $variables['xa_cover_portrait'] = $ih > $iw * 1.15;
    }
  }


  // 正文：过滤器渲染 → 清除空段落 → 图片懒加载
  $item = $node->get('field_body')->first();
  $html = $item ? (string) check_markup((string) $item->value, $item->format ?: NULL) : '';
  $html = preg_replace('#<p(?:\s[^>]*)?>(?:\s|&nbsp;|\x{00A0}|<br\s*/?>)*</p>#iu', '', $html) ?? $html;
  $html = preg_replace('#<img(?![^>]*\sloading=)#i', '<img loading="lazy"', $html) ?? $html;
  $html = preg_replace_callback('#<p(?:\s[^>]*)?>(.*?)</p>#isu', function ($m) {
    if (preg_match('#<(img|video|iframe|audio|picture)#i', $m[1])) { return $m[0]; }
    $t = html_entity_decode(strip_tags($m[1]), ENT_QUOTES | ENT_HTML5, 'UTF-8');
    return preg_replace('/[\s\x{00A0}\x{200B}]+/u', '', $t) === '' ? '' : $m[0];
  }, $html) ?? $html;
  $variables['xa_body'] = [
    '#markup' => \Drupal\Core\Render\Markup::create($html),
  ];
  $plain = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($html))));
  $variables['xa_read'] = max(1, (int) ceil(mb_strlen(str_replace(' ', '', $plain)) / 400));

  $variables['xa_summary'] = trim((string) $node->get('field_summary')->value);
  $variables['xa_source'] = (string) $node->get('field_source')->value;
  $variables['xa_author'] = (string) $node->get('field_author')->value;
  $ditem = $node->get('field_published_at')->first();
  $ts = ($ditem && $ditem->date) ? $ditem->date->getTimestamp() : $node->getCreatedTime();
  $variables['xa_date'] = $fmt->format($ts, 'custom', 'Y-m-d');
  $variables['xa_views'] = $views($node->get('field_views')->value);

  // 分类
  $variables['xa_cat'] = NULL;
  $tid = 0;
  if ($term = $node->get('field_categories')->entity) {
    $term = _xedc_translated($term);
    $tid = (int) $term->id();
    $variables['xa_cat'] = [
      'name' => $term->label(),
      'url' => \Drupal\Core\Url::fromUserInput('/articles', ['query' => ['cat' => $tid]])->toString(),
    ];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $term->getCacheTags());
  }

  // 标签
  $tags = [];
  foreach ($node->get('field_tags')->referencedEntities() as $t) {
    $t = _xedc_translated($t);
    $tags[] = ['name' => $t->label(), 'url' => $t->toUrl()->toString()];
    $variables['#cache']['tags'] = \Drupal\Core\Cache\Cache::mergeTags($variables['#cache']['tags'] ?? [], $t->getCacheTags());
  }
  $variables['xa_tags'] = $tags;
  $variables['#cache']['tags'][] = 'node_list:article';

  // 原文链接
  $variables['xa_source_url'] = '';
  $variables['xa_source_host'] = '';
  if (!$node->get('field_source_url')->isEmpty()) {
    $u = $node->get('field_source_url')->first()->getUrl()->toString();
    $variables['xa_source_url'] = $u;
    $variables['xa_source_host'] = (string) parse_url($u, PHP_URL_HOST);
  }

  // 上一篇 / 下一篇
  $created = $node->getCreatedTime();
  $one = function (string $op, string $dir) use ($q, $created) {
    $ids = $q()->condition('created', $created, $op)->sort('created', $dir)->range(0, 1)->execute();
    $n = $ids ? \Drupal\node\Entity\Node::load(reset($ids)) : NULL;
    if ($n) {
      $n = _xedc_translated($n);
    }
    return $n ? ['title' => $n->label(), 'url' => $n->toUrl()->toString()] : NULL;
  };
  $variables['xa_prev'] = $one('<', 'DESC');
  $variables['xa_next'] = $one('>', 'ASC');

  // 相关阅读（同分类 4 篇）
  $variables['xa_related'] = [];
  if ($tid) {
    $ids = $q()->condition('field_categories.target_id', $tid)->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')->range(0, 4)->execute();
    $variables['xa_related'] = $pick(array_values($ids), function ($n) use ($fmt) {
      $n = _xedc_translated($n);
      return ['title' => $n->label(), 'url' => $n->toUrl()->toString(),
        'meta' => $fmt->format($n->getCreatedTime(), 'custom', 'Y-m-d')];
    });
  }

  // 热门文章（阅读量前 5）
  $ids = $q()->condition('nid', $node->id(), '<>')->sort('field_views', 'DESC')->sort('created', 'DESC')->range(0, 5)->execute();
  $variables['xa_hot'] = $pick(array_values($ids), function ($n) use ($views) {
    $n = _xedc_translated($n);
    return ['title' => $n->label(), 'url' => $n->toUrl()->toString(),
      'meta' => t('@count 阅读', ['@count' => $views($n->get('field_views')->value)])];
  });
  _xedc_article_breadcrumb($node, $variables);
}
