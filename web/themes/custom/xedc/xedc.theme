<?php

/**
 * @file
 * Theme functions.
 */

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}

/**
 * Implements hook_theme().
 */
function xedc_theme($existing, $type, $theme, $path) {
  return [
    'xedc_search_page' => [
      'variables' => [
        'q' => '',
        'type' => 'all',
        'sort' => 'relevance',
        'page' => 0,
        'form_action' => '/search',
        'tabs' => [],
        'sorts' => [],
        'info_count' => 0,
        'cards' => [],
        'models' => [],
        'pager' => [],
        'hot_models' => [],
        'explore' => [],
      ],
      'template' => 'search/search-page',
    ],
  ];
}

function _xedc_home_items_old($type, $field, $limit) {
  $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', $type)->condition('status', 1)
    ->sort('created', 'DESC')->range(0, $limit)->execute();
  $items = [];
  foreach (\Drupal\node\Entity\Node::loadMultiple($nids) as $n) {
    $url = '';
    if ($n->hasField($field) && !$n->get($field)->isEmpty()) {
      $e = $n->get($field)->entity;
      if ($e instanceof \Drupal\media\MediaInterface) {
        $e = $e->get('thumbnail')->entity;
      }
      if ($e instanceof \Drupal\file\FileInterface) {
        $s = \Drupal\image\Entity\ImageStyle::load('large');
        $url = $s ? $s->buildUrl($e->getFileUri()) : \Drupal::service('file_url_generator')->generateString($e->getFileUri());
      }
    }
    $items[] = [
      'title' => $n->label(),
      'url' => $n->toUrl()->toString(),
      'img' => $url,
      'date' => \Drupal::service('date.formatter')->format($n->getCreatedTime(), 'custom', 'm-d'),
    ];
  }
  return $items;
}

function xedc_preprocess_page(&$variables) {
  xedc_nav_build($variables);
  if (_xedc_search_is_route() && isset($variables['page']['content'])) {
    $variables['page']['content'] = _xedc_search_build_page();
    $variables['page']['#cache']['contexts'] = array_merge(
      $variables['page']['#cache']['contexts'] ?? [],
      ['url.query_args:q', 'url.query_args:type', 'url.query_args:sort', 'url.query_args:page']
    );
    $variables['page']['#cache']['tags'] = array_merge(
      $variables['page']['#cache']['tags'] ?? [],
      ['node_list', 'taxonomy_term_list', 'media_list', 'file_list']
    );
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['home_slides'] = [];
    $variables['home_categories'] = [];
    if (\Drupal::moduleHandler()->moduleExists('xedc_home')) {
      $cards = \Drupal::service('xedc_home.cards');
      $variables['home_slides'] = $cards->slideshow();
      $variables['home_photos'] = $cards->fromView('block_photos', 'field_cover_image', 'meitu_card_cover', 'photo');
      $variables['home_videos'] = $cards->fromView('block_videos', 'field_video_cover', 'video_cover', 'video');
      $variables['home_articles'] = $cards->fromView('block_articles', 'field_cover', 'large', 'article');
      $block = \Drupal::service('plugin.manager.block')->createInstance('xedc_home_photo_categories');
      $variables['home_categories'] = $block->build();
      if (count($variables['home_slides']) > 1) {
        $variables['#attached']['library'][] = 'xedc/home';
      }
    }
    else {
      $variables['home_photos'] = _xedc_home_items('photo', 'field_cover_image', 5);
      $variables['home_videos'] = _xedc_home_items('video', 'field_video_cover', 8);
      $variables['home_articles'] = _xedc_home_items('article', 'field_cover', 6);
    }
    $variables['#cache']['tags'][] = 'node_list';
    $variables['#cache']['tags'][] = 'taxonomy_term_list';
    $variables['#cache']['contexts'][] = 'user.permissions';
    $variables['#cache']['max-age'] = \Drupal\Core\Cache\Cache::mergeMaxAges($variables['#cache']['max-age'] ?? \Drupal\Core\Cache\Cache::PERMANENT, 3600);
    $variables['page']['#cache']['tags'][] = 'node_list';
    $variables['page']['#cache']['tags'][] = 'taxonomy_term_list';
    $variables['page']['#cache']['max-age'] = \Drupal\Core\Cache\Cache::mergeMaxAges($variables['page']['#cache']['max-age'] ?? \Drupal\Core\Cache\Cache::PERMANENT, 3600);
  }
}

function xedc_page_attachments_alter(array &$attachments) {
  foreach ($attachments['#attached']['html_head'] ?? [] as $key => $item) {
    if (($item[1] ?? '') !== 'viewport') {
      continue;
    }
    $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = 'width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual';
    break;
  }

  if (_xedc_search_is_route()) {
    [$q, $type, $sort, $page] = _xedc_search_params();
    $query = [];
    if ($q !== '') {
      $query['q'] = $q;
    }
    if ($type !== 'all') {
      $query['type'] = $type;
    }
    if ($page > 0) {
      $query['page'] = $page;
    }
    $canonical = \Drupal\Core\Url::fromUserInput('/search', ['query' => $query])->setAbsolute()->toString();

    $attachments['#attached']['html_head'] = $attachments['#attached']['html_head'] ?? [];
    $has_canonical = FALSE;
    foreach ($attachments['#attached']['html_head'] as $key => $item) {
      $name = $item[1] ?? '';
      if ($name === 'robots') {
        unset($attachments['#attached']['html_head'][$key]);
      }
      if ($name === 'canonical_url') {
        $attachments['#attached']['html_head'][$key][0]['#attributes']['href'] = $canonical;
        $has_canonical = TRUE;
      }
    }
    if (!$has_canonical) {
      $attachments['#attached']['html_head'][] = [
        [
          '#tag' => 'link',
          '#attributes' => ['rel' => 'canonical', 'href' => $canonical],
        ],
        'canonical_url',
      ];
    }
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex,follow'],
      ],
      'robots',
    ];
    $attachments['#cache']['contexts'] = array_merge(
      $attachments['#cache']['contexts'] ?? [],
      ['url.query_args:q', 'url.query_args:type', 'url.query_args:page']
    );
    return;
  }
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $attachments['#cache']['tags'][] = 'node_list';
  }
  if (!_xedc_is_photo_list_route()) {
    return;
  }

  $page = _xedc_photo_current_page();
  $canonical = _xedc_photo_page_url($page, TRUE);
  if (empty($attachments['#attached']['html_head'])) {
    return;
  }
  foreach ($attachments['#attached']['html_head'] as $key => $item) {
    $name = $item[1] ?? '';
    if ($name === 'canonical_url') {
      $attachments['#attached']['html_head'][$key][0]['#attributes']['href'] = $canonical;
    }
    if ($page > 0 && $name === 'description') {
      unset($attachments['#attached']['html_head'][$key]);
    }
  }
}

function xedc_form_views_exposed_form_alter(array &$form, $form_state, $form_id) {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'image_gallery') {
    return;
  }
  $q = \Drupal::request()->query;
  $sort = $q->get('sort_by') === 'totalcount' ? 'totalcount' : 'created';
  $cur = 0;
  if (preg_match('#^/taxonomy/term/(\d+)$#', \Drupal::service('path.current')->getPath(), $m)) {
    $cur = (int) $m[1];
  }
  $sq = function ($s) { return $s !== 'created' ? ['sort_by' => $s] : []; };

  // 栏目页：收集该栏目内容用到的人物和标签。
  $models = [];
  $tags = [];
  $term = $cur ? \Drupal\taxonomy\Entity\Term::load($cur) : NULL;
  $is_cat = $term && $term->bundle() === 'photo_category';
  if ($is_cat) {
    $nids = \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('status', 1)->condition('field_categories', $cur)->execute();
    $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);
    $collect = function ($field) use ($nodes) {
      $count = [];
      foreach ($nodes as $n) {
        if (!$n->hasField($field)) { continue; }
        foreach ($n->get($field)->getValue() as $v) {
          $count[$v['target_id']] = ($count[$v['target_id']] ?? 0) + 1;
        }
      }
      $items = [];
      foreach (\Drupal\taxonomy\Entity\Term::loadMultiple(array_keys($count)) as $tt) {
        $items[] = ['id' => (int) $tt->id(), 't' => $tt->label(), 'n' => $count[$tt->id()]];
      }
      usort($items, fn($x, $y) => $y['n'] <=> $x['n']);
      return $items;
    };
    $models = $collect('field_model');
    $tags = [];
  }

  // 顶部条：栏目页且有人物 -> 人物；否则 -> 栏目。横条只露前若干项，其余进弹出层。
  // 模特筛选留在当前栏目页，用 ?model= 收窄列表。
  $model_id = 0;
  if ($is_cat) {
    $raw_model = $q->get('model');
    if (is_scalar($raw_model) && ctype_digit((string) $raw_model)) {
      $model_id = (int) $raw_model;
    }
    $tabs = [['t' => '全部', 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq($sort)])->toString(), 'a' => $model_id === 0]];
    foreach ($models as $item) {
      $query = $sq($sort);
      $query['model'] = $item['id'];
      $tabs[] = [
        't' => $item['t'],
        'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $query])->toString(),
        'a' => $model_id === $item['id'],
      ];
    }
    if ($model_id > 0) {
      $base_sq = $sq;
      $sq = function ($s) use ($base_sq, $model_id) {
        $query = $base_sq($s);
        $query['model'] = $model_id;
        return $query;
      };
    }
  }
  else {
    $tabs = [['t' => '全部', 'u' => \Drupal\Core\Url::fromUserInput('/meitu', ['query' => $sq($sort)])->toString(), 'a' => !$cur]];
    foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('photo_category') as $t) {
      $tabs[] = ['t' => $t->name,
        'u' => \Drupal\Core\Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $t->tid], ['query' => $sq($sort)])->toString(),
        'a' => $cur == $t->tid];
    }
  }
  $sorts = [
    ['t' => '最新', 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq('created')])->toString(), 'a' => $sort === 'created'],
    ['t' => '最热', 'u' => \Drupal\Core\Url::fromRoute('<current>', [], ['query' => $sq('totalcount')])->toString(), 'a' => $sort === 'totalcount'],
  ];

  $label = $is_cat ? '模特' : '分类';
  $sheet_title = $is_cat ? '全部模特' : '全部分类';
  $bar_limit = 6;
  $lead = $tabs[0] ?? NULL;
  $rest = array_slice($tabs, 1);
  $bar = array_slice($rest, 0, $bar_limit);
  $seen = [];
  foreach ($bar as $item) {
    $seen[$item['u']] = TRUE;
  }
  foreach ($rest as $item) {
    if (!empty($item['a']) && empty($seen[$item['u']])) {
      $bar[] = $item;
      break;
    }
  }
  $show_more = count($rest) > $bar_limit;

  $pill = '<a class="xedc-pill{{ i.a ? \' is-active\' : \'\' }}" href="{{ i.u }}"{% if i.a %} aria-current="page"{% endif %}>{{ i.t }}</a>';
  $tpl = '<div class="photo-bar"><div class="photo-tabs-wrap">';
  $tpl .= '<div class="photo-tabs-scroll"><nav class="photo-tabs" aria-label="{{ label }}">';
  $tpl .= '{% if lead %}<a class="xedc-pill{{ lead.a ? \' is-active\' : \'\' }}" href="{{ lead.u }}"{% if lead.a %} aria-current="page"{% endif %}>{{ lead.t }}</a>{% endif %}';
  $tpl .= '{% for i in bar %}' . $pill . '{% endfor %}';
  $tpl .= '</nav><span class="photo-tabs-fade" hidden></span></div>';
  $tpl .= '{% if show_more %}<button type="button" class="xedc-pill photo-more" aria-haspopup="dialog" aria-expanded="false" aria-controls="photo-filter-sheet">更多</button>{% endif %}';
  $tpl .= '</div><nav class="photo-sorts" aria-label="排序">';
  $tpl .= '{% for i in sorts %}<a class="xedc-pill{{ i.a ? \' is-active\' : \'\' }}" href="{{ i.u }}"{% if i.a %} aria-current="page"{% endif %}>{{ i.t }}</a>{% endfor %}</nav></div>';
  $tpl .= '{% if show_more %}<div class="photo-sheet" id="photo-filter-sheet" hidden>';
  $tpl .= '<div class="photo-sheet__backdrop" data-photo-sheet-close></div>';
  $tpl .= '<div class="photo-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="photo-filter-sheet-title">';
  $tpl .= '<div class="photo-sheet__head"><h2 id="photo-filter-sheet-title">{{ sheet_title }}</h2>';
  $tpl .= '<button type="button" class="photo-sheet__close" data-photo-sheet-close aria-label="关闭">&times;</button></div>';
  $tpl .= '<label class="photo-sheet__search"><span class="visually-hidden">搜索{{ label }}</span>';
  $tpl .= '<input type="search" placeholder="搜索{{ label }}" autocomplete="off" enterkeyhint="search"></label>';
  $tpl .= '<div class="photo-sheet__grid">{% for i in tabs %}' . $pill . '{% endfor %}</div>';
  $tpl .= '<p class="photo-sheet__empty" hidden>没有匹配的{{ label }}</p></div></div>{% endif %}';
  $form['pills'] = ['#type' => 'inline_template', '#template' => $tpl,
    '#context' => [
      'lead' => $lead,
      'bar' => $bar,
      'tabs' => $tabs,
      'sorts' => $sorts,
      'label' => $label,
      'sheet_title' => $sheet_title,
      'show_more' => $show_more,
    ], '#weight' => -10];

  // 标签行（栏目页，最多 6 个，其余折叠）。
  if ($tags) {
    $t2 = '<div class="xedc-chips"><span class="xedc-chips-title">标签</span>';
    $t2 .= '{% for c in tags|slice(0, 6) %}<a class="xedc-pill" href="{{ c.u }}">{{ c.t }}</a>{% endfor %}';
    $t2 .= '{% if tags|length > 6 %}<details class="xedc-more"><summary class="xedc-pill">更多标签</summary>';
    $t2 .= '{% for c in tags|slice(6) %}<a class="xedc-pill" href="{{ c.u }}">{{ c.t }}</a>{% endfor %}</details>{% endif %}</div>';
    $form['chips'] = ['#type' => 'inline_template', '#template' => $t2,
      '#context' => ['tags' => $tags], '#weight' => -5];
  }

  foreach (['cat', 'sort_by', 'sort_order', 'actions'] as $f) {
    if (isset($form[$f])) { $form[$f]['#attributes']['class'][] = 'photo-hide'; }
  }
  $form['#cache']['contexts'][] = 'url.path';
  $form['#cache']['contexts'][] = 'url.query_args:sort_by';
  $form['#cache']['contexts'][] = 'url.query_args:model';
  $form['#cache']['tags'][] = 'node_list';
  $form['#cache']['tags'][] = 'taxonomy_term_list';
}

function xedc_form_comment_form_alter(array &$form, $form_state, $form_id) {
  $form['#attached']['library'][] = 'xedc/comment-form';
  $form_object = $form_state->getFormObject();
  $comment = $form_object instanceof \Drupal\comment\CommentForm ? $form_object->getEntity() : NULL;
  $is_edit = $comment instanceof \Drupal\comment\CommentInterface && !$comment->isNew();
  if (!$is_edit && $comment instanceof \Drupal\comment\CommentInterface) {
    $form['pid'] = [
      '#type' => 'hidden',
      '#default_value' => $comment->hasParentComment() ? (int) $comment->getParentComment()->id() : 0,
    ];
    $form['#entity_builders'][] = '_xedc_comment_apply_pid';
    $form['actions']['submit']['#ajax'] = [
      'callback' => '_xedc_comment_ajax_callback',
      'disable-refocus' => TRUE,
      'progress' => [
        'type' => 'throbber',
        'message' => '',
      ],
    ];
  }
  $form["actions"]["submit"]["#value"] = $is_edit ? t('保存修改') : t('发表评论');
  if ($is_edit) {
    $form['#attributes']['class'][] = 'comment-form--edit';
    $comment = $form_object->getEntity();
    $destination = \Drupal::request()->query->get('destination');
    $cancel_url = NULL;
    if (is_string($destination) && $destination !== '' && str_starts_with($destination, '/') && !str_starts_with($destination, '//')) {
      try {
        $cancel_url = \Drupal\Core\Url::fromUserInput($destination);
      }
      catch (\InvalidArgumentException $e) {
        $cancel_url = NULL;
      }
    }
    if (!$cancel_url) {
      $parent = $comment->getCommentedEntity();
      $cancel_url = $parent ? $parent->toUrl()->setOption('fragment', 'comment-' . $comment->id()) : \Drupal\Core\Url::fromRoute('<front>');
    }
    $form['actions']['cancel'] = [
      '#type' => 'link',
      '#title' => t('取消'),
      '#url' => $cancel_url,
      '#attributes' => ['class' => ['btn', 'btn-secondary', 'comment-form__cancel']],
      '#weight' => 20,
    ];
  }
  if (isset($form["actions"]["preview"])) { $form["actions"]["preview"]["#access"] = FALSE; }
  $form['#after_build'][] = '_xedc_comment_form_placeholder_after_build';
  if (\Drupal::currentUser()->isAnonymous() && isset($form["field_comment_image"])) { $form["field_comment_image"]["#access"] = FALSE; }
}

/**
 * Adds the comment placeholder after the comment textarea is built.
 */
function _xedc_comment_form_placeholder_after_build(array $form, \Drupal\Core\Form\FormStateInterface $form_state) {
  $set_placeholder = function (array &$element) use (&$set_placeholder) {
    if (($element['#type'] ?? '') === 'textarea' && empty($element['#placeholder'])) {
      $element['#placeholder'] = t('写下你的评论…');
    }
    foreach (\Drupal\Core\Render\Element::children($element) as $key) {
      if (isset($element[$key]) && is_array($element[$key])) {
        $set_placeholder($element[$key]);
      }
    }
  };
  $set_placeholder($form);
  return $form;
}

/**
 * Copies the reply parent onto a new comment.
 *
 * The reply link sets input[name="pid"] without leaving the page.
 */
function _xedc_comment_apply_pid($entity_type, $entity, array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
  if (!$entity instanceof \Drupal\comment\CommentInterface || !$entity->isNew()) {
    return;
  }
  $pid = (int) $form_state->getValue('pid');
  if ($pid <= 0) {
    $entity->set('pid', NULL);
    return;
  }
  $parent = \Drupal\comment\Entity\Comment::load($pid);
  $same = $parent instanceof \Drupal\comment\CommentInterface
    && (int) $parent->getCommentedEntityId() === (int) $entity->getCommentedEntityId()
    && $parent->getCommentedEntityTypeId() === $entity->getCommentedEntityTypeId()
    && $parent->getFieldName() === $entity->getFieldName();
  $entity->set('pid', $same ? $pid : NULL);
}

/**
 * Ajax callback: insert the new comment beside the form, without a redirect.
 */
function _xedc_comment_ajax_callback(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): \Drupal\Core\Ajax\AjaxResponse {
  $response = new \Drupal\Core\Ajax\AjaxResponse();
  $messenger = \Drupal::messenger();
  if ($form_state->hasAnyErrors()) {
    $messages = [];
    foreach ($form_state->getErrors() as $message) {
      $text = trim(strip_tags((string) $message));
      if ($text !== '') {
        $messages[] = $text;
      }
    }
    if ($messages) {
      $form['xedc_error'] = [
        '#type' => 'html_tag',
        '#tag' => 'div',
        '#value' => implode(' ', $messages),
        '#attributes' => [
          'class' => ['comment-form__error'],
          'role' => 'alert',
        ],
        '#weight' => -100,
      ];
    }
    $messenger->deleteByType('error');
    $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', $form));
    return $response;
  }

  $form_object = $form_state->getFormObject();
  $comment = $form_object instanceof \Drupal\comment\CommentForm ? $form_object->getEntity() : NULL;
  if (!$comment instanceof \Drupal\comment\CommentInterface || !$comment->id()) {
    $messenger->deleteAll();
    $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', $form));
    return $response;
  }

  $visible = $comment->isPublished() && $comment->access('view');
  if ($visible) {
    $build = \Drupal::entityTypeManager()->getViewBuilder('comment')->view($comment);
    $response->addCommand(new \Drupal\Core\Ajax\BeforeCommand('form.comment-form', $build));
  }
  else {
    $response->addCommand(new \Drupal\Core\Ajax\BeforeCommand('form.comment-form', [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => (string) t('评论已提交，审核通过后才会显示。'),
      '#attributes' => [
        'class' => ['comment-form__notice'],
        'role' => 'status',
      ],
    ]));
  }
  $messenger->deleteAll();
  $response->addCommand(new \Drupal\Core\Ajax\ReplaceCommand('form.comment-form', _xedc_comment_fresh_form($comment)));
  $response->addCommand(new \Drupal\Core\Ajax\InvokeCommand('form.comment-form', 'xedcCommentDone', []));
  return $response;
}

/**
 * Builds an empty comment form that is not tied to the submission just saved.
 */
function _xedc_comment_fresh_form(\Drupal\comment\CommentInterface $comment): array {
  $entity = $comment->getCommentedEntity();
  $fresh = \Drupal\comment\Entity\Comment::create([
    'entity_type' => $entity->getEntityTypeId(),
    'entity_id' => $entity->id(),
    'field_name' => $comment->getFieldName(),
    'comment_type' => $comment->bundle(),
  ]);
  $form_object = \Drupal::entityTypeManager()->getFormObject('comment', 'default');
  $form_object->setEntity($fresh);
  $form_state = new \Drupal\Core\Form\FormState();
  $form_state->setUserInput([]);
  $form_state->disableRedirect();
  return \Drupal::formBuilder()->buildForm($form_object, $form_state);
}

function xedc_preprocess_node(array &$variables) {
  _xedc_vd_preprocess($variables);
  _xedc_add_meta($variables);
  $node = $variables['node'];
  if ($node->bundle() !== 'photo' || $variables['view_mode'] !== 'full') {
    return;
  }
  $variables['img_summary'] = '';
  if ($node->hasField('field_summary') && !$node->get('field_summary')->isEmpty()) {
    $summary = trim(str_replace(["\r\n", "\r"], "\n", (string) $node->get('field_summary')->value));
    if ($summary !== '') {
      $variables['img_summary'] = $summary;
    }
  }
  $variables['img_gallery'] = _xedc_photo_gallery_items($node, $variables);
  $variables['img_show_cover'] = !empty($variables['img_show_cover']);
  if (isset($variables['xedc_meta']) && is_array($variables['xedc_meta'])) {
    $variables['xedc_meta']['count'] = count($variables['img_gallery']);
  }
  if (isset($variables['content']['field_images'])) {
    $variables['content']['field_images']['#post_render'][] = [XedcPhotoGalleryLazy::class, 'render'];
  }
  $st = \Drupal::entityTypeManager()->getStorage('node');
  $created = $node->getCreatedTime();
  $q = $st->getQuery()->accessCheck(TRUE)->condition('type', 'photo')->condition('status', 1);
  $prev = (clone $q)->condition('created', $created, '<')->sort('created', 'DESC')->range(0, 1)->execute();
  $next = (clone $q)->condition('created', $created, '>')->sort('created', 'ASC')->range(0, 1)->execute();
  $variables['nav_prev'] = $prev ? $st->load(reset($prev)) : NULL;
  $variables['nav_next'] = $next ? $st->load(reset($next)) : NULL;
  $ids = [];
  $ex = [$node->id()];
  $pick = function ($extra) use ($q, &$ex) {
    $qq = clone $q;
    $qq->condition('nid', $ex, 'NOT IN');
    $extra($qq);
    $r = array_values($qq->sort('created', 'DESC')->range(0, 8)->execute());
    return $r;
  };
  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    $tids = array_column($node->get('field_tags')->getValue(), 'target_id');
    $r = $pick(function ($qq) use ($tids) { $qq->condition('field_tags', $tids, 'IN'); });
    $ids = array_merge($ids, $r); $ex = array_merge($ex, $r);
  }
  if (count($ids) < 8 && $node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $cid = $node->get('field_categories')->target_id;
    $r = $pick(function ($qq) use ($cid) { $qq->condition('field_categories', $cid); });
    $r = array_slice($r, 0, 8 - count($ids));
    $ids = array_merge($ids, $r); $ex = array_merge($ex, $r);
  }
  if (count($ids) < 8) {
    $r = array_slice($pick(function ($qq) {}), 0, 8 - count($ids));
    $ids = array_merge($ids, $r);
  }
  $variables['related'] = $ids ? $st->loadMultiple($ids) : [];
  $variables['#cache']['tags'][] = 'node_list:photo';
}

/**
 * Gallery items in field_images order.
 *
 * The cover is included only when that file is not already in field_images.
 * Lightbox uses max_1300x1300. Sheet thumbs use max_650x650 (scale, no crop).
 */
function _xedc_photo_gallery_items($node, array &$variables): array {
  $full_style = \Drupal\image\Entity\ImageStyle::load('max_1300x1300');
  $thumb_style = \Drupal\image\Entity\ImageStyle::load('max_650x650');
  $generator = \Drupal::service('file_url_generator');
  $variables['#cache']['tags'][] = 'config:image.style.max_1300x1300';
  $variables['#cache']['tags'][] = 'config:image.style.max_650x650';
  $variables['img_show_cover'] = FALSE;

  $file_of = static function ($media) {
    if (!$media instanceof \Drupal\media\MediaInterface) {
      return NULL;
    }
    $fid = $media->getSource()->getSourceFieldValue($media);
    if (!$fid) {
      return NULL;
    }
    $file = \Drupal\file\Entity\File::load($fid);
    return $file instanceof \Drupal\file\FileInterface ? $file : NULL;
  };
  $pack = function ($media) use ($file_of, $full_style, $thumb_style, $generator, &$variables) {
    $file = $file_of($media);
    if (!$file || !$media instanceof \Drupal\media\MediaInterface) {
      return NULL;
    }
    $uri = $file->getFileUri();
    $full = $full_style ? $full_style->buildUrl($uri) : $generator->generateAbsoluteString($uri);
    $thumb = $thumb_style ? $thumb_style->buildUrl($uri) : $full;
    $original = $generator->generateString($uri);
    $alt = '';
    if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $alt = trim((string) $media->get('field_media_image')->alt);
    }
    $variables['#cache']['tags'][] = 'media:' . $media->id();
    $variables['#cache']['tags'][] = 'file:' . $file->id();
    return [
      'thumb' => $generator->transformRelative($thumb),
      'full' => $generator->transformRelative($full),
      'original' => $generator->transformRelative($original),
      'alt' => $alt,
    ];
  };

  $images = [];
  $seen = [];
  if ($node->hasField('field_images') && !$node->get('field_images')->isEmpty()) {
    foreach ($node->get('field_images')->referencedEntities() as $media) {
      if (!$media instanceof \Drupal\media\MediaInterface || !$media->access('view')) {
        continue;
      }
      $item = $pack($media);
      if (!$item) {
        continue;
      }
      $images[] = $item;
      $seen[(int) $media->id()] = TRUE;
      $file = $file_of($media);
      if ($file) {
        $seen['f' . $file->id()] = TRUE;
      }
    }
  }

  $cover_items = [];
  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $cover = $node->get('field_cover_image')->entity;
    if (!$cover instanceof \Drupal\media\MediaInterface || !$cover->access('view')) {
      $cover = NULL;
    }
    $cover_file = $file_of($cover);
    $redundant = $cover instanceof \Drupal\media\MediaInterface && (
      isset($seen[(int) $cover->id()]) ||
      ($cover_file && isset($seen['f' . $cover_file->id()]))
    );
    if (!$redundant) {
      $item = $pack($cover);
      if ($item) {
        $cover_items[] = $item;
        $variables['img_show_cover'] = TRUE;
      }
    }
  }
  return array_merge($cover_items, $images);
}

require_once __DIR__ . '/includes/auth.inc';

function xedc_preprocess_page_title(array &$variables) {
  if (_xedc_search_is_route()) {
    [$q] = _xedc_search_params();
    $variables['title'] = $q !== '' ? '搜索：' . $q : '搜索';
    $variables['#cache']['contexts'][] = 'url.query_args:q';
    return;
  }
  $route = \Drupal::routeMatch();
  if ($route->getRouteName() === 'entity.comment.edit_form') {
    $variables['title'] = t('编辑评论');
  }
  $node = $route->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface && in_array($node->bundle(), ['photo', 'article', 'video'], TRUE)) {
    $variables['title'] = '';
    return;
  }
  $path = \Drupal::service('path.current')->getPath();
  if (preg_match('#^/taxonomy/term/(\d+)$#', $path, $m)) {
    $t = \Drupal\taxonomy\Entity\Term::load($m[1]);
    if ($t) {
      $variables['title'] = $t->bundle() === 'tags' ? '' : $t->label();
    }
  }
  if (_xedc_is_photo_list_route() && ($page = _xedc_photo_current_page()) > 0) {
    $title = $variables['title'] ?? '';
    if (is_string($title) || $title instanceof \Stringable) {
      $variables['title'] = (string) $title . ' - 第 ' . ($page + 1) . ' 页';
    }
  }
}

/**
 * Whether the current route renders the photo list view.
 */
function _xedc_is_photo_list_route(): bool {
  static $is_photo_list = NULL;
  if ($is_photo_list !== NULL) {
    return $is_photo_list;
  }
  $route = \Drupal::routeMatch();
  $name = $route->getRouteName();
  $is_photo_list = in_array($name, [
    'view.image_gallery.page_1',
    'view.image_gallery.page_2',
    'view.image_gallery.page_3',
  ], TRUE);
  if (!$is_photo_list && $name === 'entity.taxonomy_term.canonical') {
    $route_object = $route->getRouteObject();
    $is_photo_list = $route_object && $route_object->getDefault('_xt_view_id') === 'image_gallery';
  }
  return $is_photo_list;
}

/**
 * Returns the current zero-based photo list page.
 */
function _xedc_photo_current_page(): int {
  static $page = NULL;
  if ($page !== NULL) {
    return $page;
  }
  $raw = \Drupal::request()->query->get('page');
  if (is_array($raw)) {
    $raw = end($raw);
  }
  $page = is_numeric($raw) && (int) $raw > 0 ? (int) $raw : 0;
  return $page;
}

/**
 * Builds a clean photo list URL, ignoring sort parameters.
 */
function _xedc_photo_page_url(int $page, bool $absolute = FALSE): string {
  $query = $page > 0 ? ['page' => $page] : [];
  $url = \Drupal\Core\Url::fromUserInput(\Drupal::request()->getPathInfo(), ['query' => $query]);
  if ($absolute) {
    $url->setAbsolute();
  }
  return $url->toString();
}

/**
 * Returns a useful category badge for a photo card.
 */
function _xedc_photo_card_badge(\Drupal\node\NodeInterface $node, array $hidden_tids): string {
  if (!$node->hasField('field_categories') || $node->get('field_categories')->isEmpty()) {
    return '';
  }
  foreach ($node->get('field_categories')->referencedEntities() as $term) {
    if (!$term instanceof \Drupal\taxonomy\TermInterface || $term->bundle() !== 'photo_category') {
      continue;
    }
    if (in_array((int) $term->id(), $hidden_tids, TRUE)) {
      continue;
    }
    return $term->label();
  }
  return '';
}

/**
 * Replaces photo list rows with semantic, linked cards.
 */
function _xedc_photo_build_rows(array &$variables, \Drupal\views\ViewExecutable $view, array $hidden_tids): void {
  if (empty($view->result)) {
    return;
  }
  $style = \Drupal\image\Entity\ImageStyle::load('meitu_card_cover');
  $file_url = \Drupal::service('file_url_generator');
  $date_formatter = \Drupal::service('date.formatter');
  $cards = [];
  $tags = ['taxonomy_term_list', 'config:image.style.meitu_card_cover'];
  $index = 0;

  foreach ($view->result as $result) {
    $node = $result->_entity ?? NULL;
    if (!$node instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $title = $node->label();
    $url = $node->toUrl()->toString();
    $cover_url = '';
    $media_tags = [];
    if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
      $media = $node->get('field_cover_image')->entity;
      if ($media instanceof \Drupal\media\MediaInterface) {
        $media_tags = $media->getCacheTags();
        if ($media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
          $file = $media->get('field_media_image')->entity;
          if ($file instanceof \Drupal\file\FileInterface) {
            $uri = $file->getFileUri();
            $cover_url = $style ? $style->buildUrl($uri) : $file_url->generateString($uri);
          }
        }
      }
    }
    $eager = $index < 2;
    $cards[] = [
      'url' => $url,
      'title' => $title,
      'img' => $cover_url,
      'count' => $node->hasField('field_images') ? (int) $node->get('field_images')->count() : 0,
      'category' => _xedc_photo_card_badge($node, $hidden_tids),
      'date' => $date_formatter->format($node->getCreatedTime(), 'custom', 'Y-m-d'),
      'loading' => $eager ? 'eager' : 'lazy',
      'fetchpriority' => $eager ? 'high' : '',
      'width' => $cover_url ? 480 : 0,
      'height' => $cover_url ? 800 : 0,
    ];
    $tags = array_merge($tags, $node->getCacheTags(), $media_tags);
    $index++;
  }

  if ($cards) {
    $variables['meitu_cards'] = $cards;
    $variables['rows'] = [];
    $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], $tags);
  }
}

/**
 * Adds pagination SEO links and JSON-LD to the photo list.
 */
function _xedc_photo_attach_seo(array &$variables, \Drupal\views\ViewExecutable $view, ?\Drupal\taxonomy\TermInterface $term): void {
  $page = _xedc_photo_current_page();
  $page_url = _xedc_photo_page_url($page, TRUE);
  $name = $term ? $term->label() : '美图列表';
  $description = '';
  if ($term) {
    $raw = (string) $term->get('description')->value;
    $description = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
    $description = mb_substr($description, 0, 160);
  }

  $items = [];
  $position = 1;
  foreach ($view->result as $result) {
    $node = $result->_entity ?? NULL;
    if (!$node instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    $items[] = [
      '@type' => 'ListItem',
      'position' => $position++,
      'url' => $node->toUrl()->setAbsolute()->toString(),
      'name' => $node->label(),
    ];
  }

  $breadcrumbs = [[
    '@type' => 'ListItem',
    'position' => 1,
    'name' => '首页',
    'item' => \Drupal\Core\Url::fromRoute('<front>')->setAbsolute()->toString(),
  ]];
  $breadcrumbs[] = [
    '@type' => 'ListItem',
    'position' => 2,
    'name' => $name,
    'item' => $term ? $term->toUrl()->setAbsolute()->toString() : _xedc_photo_page_url(0, TRUE),
  ];

  $data = [
    '@context' => 'https://schema.org',
    '@graph' => [
      [
        '@type' => 'BreadcrumbList',
        'itemListElement' => $breadcrumbs,
      ],
      [
        '@type' => 'CollectionPage',
        'name' => $name,
        'url' => $page_url,
        'description' => $description,
        'mainEntity' => [
          '@type' => 'ItemList',
          'itemListElement' => $items,
        ],
      ],
    ],
  ];
  $json = json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT);
  if ($json !== FALSE) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'script',
        '#attributes' => ['type' => 'application/ld+json'],
        '#value' => \Drupal\Core\Render\Markup::create($json),
      ],
      'xedc_photo_jsonld',
    ];
  }

  $total = (int) $view->pager->getTotalItems();
  $per_page = max(1, (int) $view->pager->getItemsPerPage());
  $last_page = max(0, (int) ceil($total / $per_page) - 1);
  if ($page > 0) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'link',
        '#attributes' => ['rel' => 'prev', 'href' => _xedc_photo_page_url($page - 1, TRUE)],
      ],
      'xedc_photo_prev',
    ];
  }
  if ($page < $last_page) {
    $variables['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'link',
        '#attributes' => ['rel' => 'next', 'href' => _xedc_photo_page_url($page + 1, TRUE)],
      ],
      'xedc_photo_next',
    ];
  }
}

/**
 * Preprocesses the image gallery view.
 */
function xedc_preprocess_views_view__image_gallery(array &$variables): void {
  $view = $variables['view'];
  if (!$view instanceof \Drupal\views\ViewExecutable || $view->id() !== 'image_gallery') {
    return;
  }
  $variables['#attached']['library'][] = 'xedc/photo-list';

  $term = NULL;
  if (!empty($view->args[0])) {
    $candidate = \Drupal\taxonomy\Entity\Term::load($view->args[0]);
    if ($candidate instanceof \Drupal\taxonomy\TermInterface && $candidate->bundle() === 'photo_category') {
      $term = $candidate;
    }
  }
  $hidden_tids = [];
  if ($term) {
    $hidden_tids[] = (int) $term->id();
    foreach ($term->get('parent')->getValue() as $parent) {
      if (!empty($parent['target_id'])) {
        $hidden_tids[] = (int) $parent['target_id'];
      }
    }
    $hidden_tids = array_values(array_unique(array_filter($hidden_tids)));
  }
  _xedc_photo_build_rows($variables, $view, $hidden_tids);
  _xedc_photo_attach_seo($variables, $view, $term);

  if (!$term || _xedc_photo_current_page() !== 0) {
    return;
  }
  $raw = (string) $term->get('description')->value;
  $plain = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8')));
  if ($plain === '') {
    return;
  }

  $format = $term->get('description')->format ?: filter_fallback_format();
  $text_id = 'term-intro-' . $term->id();
  $intro = [
    '#type' => 'container',
    '#attributes' => [
      'class' => ['term-intro'],
      'data-term-intro' => '',
    ],
    '#cache' => ['tags' => $term->getCacheTags()],
    '#attached' => ['library' => ['xedc/term-intro']],
    'text' => [
      '#type' => 'html_tag',
      '#tag' => 'div',
      '#attributes' => ['class' => ['term-intro__text'], 'id' => $text_id],
      '#value' => \Drupal\Core\Render\Markup::create((string) check_markup($raw, $format)),
    ],
    'toggle' => [
      '#markup' => \Drupal\Core\Render\Markup::create('<button type="button" class="term-intro__toggle" aria-expanded="false" aria-controls="' . \Drupal\Component\Utility\Html::escape($text_id) . '" hidden>展开</button>'),
    ],
  ];
  $variables['xedc_photo_intro'] = $intro;
  $variables['#attached']['library'][] = 'xedc/term-intro';
  $variables['#cache']['tags'] = array_merge($variables['#cache']['tags'] ?? [], $term->getCacheTags());
}

/**
 * Removes the system breadcrumb on article/video pages with custom crumbs.
 */
function xedc_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? '') !== 'system_breadcrumb_block') {
    return;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface || !in_array($node->bundle(), ['article', 'video'], TRUE)) {
    return;
  }
  $variables['content'] = [];
  $attributes = $variables['attributes'] ?? [];
  if (is_object($attributes) && method_exists($attributes, 'addClass')) {
    $attributes->addClass('d-none');
  }
  else {
    $variables['attributes']['class'][] = 'd-none';
  }
  $variables['#cache']['contexts'][] = 'route';
}

/**
 * Marks the first detail image as eager/high priority.
 */
function xedc_preprocess_image(array &$variables): void {
  static $first_photo_image = FALSE;
  if ($first_photo_image || ($variables['style_name'] ?? '') !== 'images_450x800') {
    return;
  }
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'photo') {
    return;
  }
  $attributes = $variables['attributes'] ?? [];
  if (is_object($attributes) && method_exists($attributes, 'setAttribute')) {
    $attributes->setAttribute('loading', 'eager');
    $attributes->setAttribute('fetchpriority', 'high');
  }
  else {
    $variables['attributes']['loading'] = 'eager';
    $variables['attributes']['fetchpriority'] = 'high';
  }
  $first_photo_image = TRUE;
}

/**
 * Adds xedc_meta (count, size, date, models, tags) to full node view.
 */
function _xedc_add_meta(array &$variables) {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $variables['node'];
  $files = [];
  $mediaOf = [];
  $collect = function ($e) use (&$files, &$mediaOf) {
    if ($e instanceof \Drupal\file\FileInterface) {
      $files[$e->id()] = $e;
    }
    elseif ($e instanceof \Drupal\media\MediaInterface) {
      $sf = $e->getSource()->getConfiguration()['source_field'] ?? NULL;
      if ($sf && $e->hasField($sf)) {
        foreach ($e->get($sf)->referencedEntities() as $f) {
          if ($f instanceof \Drupal\file\FileInterface) {
            $files[$f->id()] = $f;
            $mediaOf[$f->id()] = $e->id();
          }
        }
      }
    }
  };
  foreach ($node->getFieldDefinitions() as $name => $def) {
    if (in_array($def->getType(), ['image', 'file', 'entity_reference']) && !$node->get($name)->isEmpty()) {
      foreach ($node->get($name)->referencedEntities() as $e) {
        $collect($e);
      }
    }
  }
  $orig = function_exists('xedc_quick_original_sizes') ? xedc_quick_original_sizes(array_values(array_unique($mediaOf))) : [];
  $size = 0;
  foreach ($files as $fid => $f) {
    $mid = $mediaOf[$fid] ?? NULL;
    $size += ($mid && !empty($orig[$mid])) ? (int) $orig[$mid] : (int) $f->getSize();
  }
  $terms = function ($field) use ($node) {
    $out = [];
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      foreach ($node->get($field)->referencedEntities() as $t) {
        $out[] = ['label' => $t->label(), 'url' => $field === 'field_model' ? \Drupal\Core\Url::fromRoute('xedc_models.detail', ['taxonomy_term' => $t->id()])->toString() : $t->toUrl()->toString()];
      }
    }
    return $out;
  };
  $variables['xedc_meta'] = [
    'count' => count($files),
    'size' => (string) \Drupal\Core\StringTranslation\ByteSizeMarkup::create($size),
    'date' => \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'Y-m-d'),
    'models' => $terms('field_model'),
    'tags' => $terms('field_tags'),
    'categories' => $terms('field_categories'),
  ];
  $variables['#cache']['tags'][] = 'node:' . $node->id();
}

/**
 * 导航数据：main 菜单 + photo_category 两级术语（挂在标题为“美图”的菜单项下）。
 */
function xedc_nav_build(array &$variables) {
  $mt = \Drupal::menuTree();
  $p = new \Drupal\Core\Menu\MenuTreeParameters();
  $p->setMaxDepth(1)->onlyEnabledLinks();
  $tree = $mt->transform($mt->load('main', $p), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $cats = [];
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('photo_category', 0, 2);
  foreach ($terms as $t) {
    $node = [
      'name' => $t->name,
      'url' => \Drupal\Core\Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $t->tid])->toString(),
      'children' => [],
    ];
    if ((int) $t->depth === 0) {
      $cats[$t->tid] = $node;
    }
    elseif (isset($cats[$t->parents[0]])) {
      $cats[$t->parents[0]]['children'][] = $node;
    }
  }

  $items = [];
  foreach ($tree as $el) {
    $title = (string) $el->link->getTitle();
    $items[] = [
      'title' => $title,
      'url' => $el->link->getUrlObject()->toString(),
      'cats' => $title === '美图' ? array_values($cats) : [],
    ];
  }

  $variables['xn'] = ['items' => $items];
  $variables['#cache']['tags'][] = 'config:system.menu.main';
  $variables['#cache']['tags'][] = 'taxonomy_term_list:photo_category';
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';
}

function _xedc_vd_file_url($entity) {
  if (!$entity) return '';
  if ($entity->getEntityTypeId() === 'media') {
    $fid = $entity->getSource()->getSourceFieldValue($entity);
    $entity = \Drupal\file\Entity\File::load($fid);
  }
  if (!$entity || !method_exists($entity, 'getFileUri')) return '';
  return \Drupal::service('file_url_generator')->generateString($entity->getFileUri());
}

function _xedc_vd_preprocess(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'video' || $variables['view_mode'] !== 'full') return;
  $vd = ['cover' => '', 'cover_width' => 0, 'cover_height' => 0, 'type' => '', 'src' => '', 'mime' => ''];
  if ($node->hasField('field_video_cover') && !$node->get('field_video_cover')->isEmpty()) {
    $cover_media = $node->get('field_video_cover')->entity;
    if ($cover_media instanceof \Drupal\media\MediaInterface && $cover_media->hasField('field_media_image')) {
      $cover_image = $cover_media->get('field_media_image')->first();
      if ($cover_image) {
        $vd['cover_width'] = (int) $cover_image->get('width')->getValue();
        $vd['cover_height'] = (int) $cover_image->get('height')->getValue();
      }
    }
    $vd['cover'] = _xedc_vd_file_url($cover_media);
  }
  $src = '';
  if ($node->hasField('field_video_file') && !$node->get('field_video_file')->isEmpty()) {
    $e = $node->get('field_video_file')->entity;
    $src = _xedc_vd_file_url($e);
    if ($e && $e->getEntityTypeId() === 'file') $vd['mime'] = $e->getMimeType();
  }
  if (!$src && $node->hasField('field_video_url') && !$node->get('field_video_url')->isEmpty()) {
    $item = $node->get('field_video_url')->first();
    $src = trim((string) ($item->uri ?? $item->value ?? ''));
    $src = preg_replace('#^(internal:|base:)#', '', $src);
  }
  if ($src) {
    if (preg_match('#youtube\.com/shorts/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.youtube.com/embed/' . $m[1] . '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#(?:x|twitter)\.com/[\w]+/status/(\d+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://platform.twitter.com/embed/Tweet.html?id=' . $m[1];
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#instagram\.com/(?:p|reel|reels|tv)/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.instagram.com/p/' . $m[1] . '/embed';
      $variables['attributes']->addClass('vd-tall');
    } elseif (preg_match('#youtube\.com/watch\?v=([\w-]+)#', $src, $m) || preg_match('#youtu\.be/([\w-]+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://www.youtube.com/embed/' . $m[1] . '?autoplay=1&rel=0&playsinline=1&modestbranding=1';
    } elseif (preg_match('#bilibili\.com/video/(BV\w+)#', $src, $m)) {
      $vd['type'] = 'iframe'; $vd['src'] = 'https://player.bilibili.com/player.html?autoplay=1&rel=0&playsinline=1&modestbranding=1&bvid=' . $m[1];
    } elseif (preg_match('#\.m3u8(\?.*)?$#i', $src)) {
      $vd['type'] = 'hls'; $vd['src'] = $src;
    } elseif (preg_match('#\.(mp4|webm|ogg|mov)(\?.*)?$#i', $src) || $vd['mime']) {
      $vd['type'] = 'video'; $vd['src'] = $src;
    } else {
      $vd['type'] = 'iframe'; $vd['src'] = $src;
    }
  }

  $cur = $node->id();
  $base = function () use ($cur) {
    return \Drupal::entityQuery('node')->accessCheck(TRUE)->condition('type', 'video')->condition('status', 1)->condition('nid', $cur, '<>')->sort('created', 'DESC');
  };
  $rel = [];
  if ($node->hasField('field_categories') && !$node->get('field_categories')->isEmpty()) {
    $tids = array_column($node->get('field_categories')->getValue(), 'target_id');
    $rel = array_values($base()->condition('field_categories', $tids, 'IN')->range(0, 5)->execute());
  }
  if (count($rel) < 5) {
    $more = $base();
    if ($rel) $more->condition('nid', $rel, 'NOT IN');
    $rel = array_merge($rel, array_values($more->range(0, 5 - count($rel))->execute()));
  }
  $variables['vd_related'] = _xedc_vd_cards($rel);
  $variables['vd_latest'] = _xedc_vd_cards(array_values($base()->range(0, 6)->execute()));
  $cats = [];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('video_category', 0, 1, TRUE) as $t) {
    $cats[] = ['name' => $t->label(), 'tid' => $t->id()];
  }
  $variables['vd_cats'] = $cats;
  $variables['vd_cache'] = ['#cache' => ['tags' => ['node_list', 'taxonomy_term_list']]];
  $variables['vd'] = $vd;
}

function _xedc_vd_cards(array $nids) {
  $out = [];
  if (!$nids) return $out;
  foreach (\Drupal\node\Entity\Node::loadMultiple($nids) as $n) {
    $cover = '';
    if ($n->hasField('field_video_cover') && !$n->get('field_video_cover')->isEmpty()) {
      $cover = _xedc_vd_file_url($n->get('field_video_cover')->entity);
    }
    $d = $n->hasField('field_duration') ? (int) $n->get('field_duration')->value : 0;
    $out[] = ['title' => $n->label(), 'url' => $n->toUrl()->toString(), 'cover' => $cover, 'dur' => $d ? sprintf('%d:%02d', intdiv($d, 60), $d % 60) : ''];
  }
  return $out;
}

require_once __DIR__ . '/xedc.search.inc';

/**
 * 文章列表卡片数据。
 */
function xedc_preprocess_node__article__teaser(array &$variables): void {
  $node = $variables['node'];
  $gen = \Drupal::service('file_url_generator');

  // 封面
  $variables['xa_cover'] = '';
  if (!$node->get('field_cover')->isEmpty()) {
    $media = $node->get('field_cover')->entity;
    $file = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->entity : NULL;
    if ($file) {
      $uri = $file->getFileUri();
      $style = \Drupal\image\Entity\ImageStyle::load('xa_cover');
      $url = $style ? $style->buildUrl($uri) : $gen->generateAbsoluteString($uri);
      $variables['xa_cover'] = $gen->transformRelative($url);
    }
  }

  // 摘要（为空时截取正文前 120 字）+ 阅读时长
  $body = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('field_body')->value)));
  $summary = trim((string) $node->get('field_summary')->value);
  $variables['xa_summary'] = $summary !== '' ? $summary : mb_substr($body, 0, 120);
  $variables['xa_read'] = max(1, (int) ceil(mb_strlen(str_replace(' ', '', $body)) / 400));

  // 分类（点击后在列表页筛选）
  $variables['xa_cat'] = NULL;
  if ($term = $node->get('field_categories')->entity) {
    $variables['xa_cat'] = [
      'name' => $term->label(),
      'url' => \Drupal\Core\Url::fromUserInput('/articles', ['query' => ['cat' => $term->id()]])->toString(),
    ];
  }

  // 标签，最多 3 个
  $tags = [];
  foreach (array_slice($node->get('field_tags')->referencedEntities(), 0, 3) as $t) {
    $tags[] = ['name' => $t->label(), 'url' => $t->toUrl()->toString()];
  }
  $variables['xa_tags'] = $tags;

  // 来源 / 日期 / 阅读量
  $variables['xa_source'] = (string) $node->get('field_source')->value;
  $item = $node->get('field_published_at')->first();
  $ts = ($item && $item->date) ? $item->date->getTimestamp() : $node->getCreatedTime();
  $variables['xa_date'] = \Drupal::service('date.formatter')->format($ts, 'custom', 'Y-m-d');
  $n = (int) $node->get('field_views')->value;
  $variables['xa_views'] = $n >= 10000 ? round($n / 10000, 1) . '万' : $n;
}

/**
 * 文章列表页：分类胶囊 + 搜索框数据。
 */
function xedc_preprocess_views_view__article_list(array &$variables): void {
  $req = \Drupal::request()->query;
  $raw_cat = $req->get('cat');
  $active = 0;
  if ($raw_cat !== NULL) {
    $is_scalar = is_string($raw_cat) || is_int($raw_cat);
    if (!$is_scalar || !preg_match('/^\d+$/', (string) $raw_cat)) {
      throw new \Symfony\Component\HttpKernel\Exception\NotFoundHttpException();
    }
    $cat = (int) $raw_cat;
    $term = $cat > 0 ? \Drupal\taxonomy\Entity\Term::load($cat) : NULL;
    if (!$term || $term->bundle() !== 'article_category') {
      throw new \Symfony\Component\HttpKernel\Exception\NotFoundHttpException();
    }
    $active = $cat;
  }
  $chips = [['name' => '全部', 'url' => '/articles', 'active' => !$active]];
  $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('article_category');
  foreach ($tree as $t) {
    $chips[] = ['name' => $t->name, 'url' => '/articles?cat=' . $t->tid, 'active' => $active === (int) $t->tid];
  }
  $variables['xa_chips'] = $chips;
  $variables['xa_cat'] = $active ?: '';
  $variables['xa_q'] = (string) $req->get('q', '');
  $variables['xa_side'] = xedc_xa_side();
  $variables['xa_pager'] = xedc_xa_pager($variables['view']);
}

/**
 * 文章列表侧栏：分类(带数量)、热门文章、热门标签。
 */
function xedc_xa_side(): array {
  $db = \Drupal::database();
  $active = (int) \Drupal::request()->query->get('cat');

  $count_by = function (string $field) use ($db): array {
    $col = $field . '_target_id';
    $q = $db->select('node__' . $field, 'f');
    $q->innerJoin('node_field_data', 'n', 'n.nid = f.entity_id AND n.vid = f.revision_id');
    $q->condition('n.status', 1)->condition('n.type', 'article')->condition('f.deleted', 0);
    $q->addField('f', $col, 'tid');
    $q->addExpression('COUNT(DISTINCT n.nid)', 'cnt');
    $q->groupBy('f.' . $col);
    return $q->execute()->fetchAllKeyed();
  };

  // 分类
  $total = (int) \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', 'article')->condition('status', 1)->count()->execute();
  $cats = [['name' => '全部', 'url' => '/articles', 'count' => $total, 'active' => !$active]];
  $cc = $count_by('field_categories');
  $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('article_category');
  foreach ($tree as $t) {
    if (empty($cc[$t->tid]) && $active !== (int) $t->tid) { continue; }
    $cats[] = ['name' => $t->name, 'url' => '/articles?cat=' . $t->tid,
      'count' => (int) ($cc[$t->tid] ?? 0), 'active' => $active === (int) $t->tid];
  }

  // 热门文章
  $ids = \Drupal::entityQuery('node')->accessCheck(TRUE)
    ->condition('type', 'article')->condition('status', 1)
    ->sort('field_views', 'DESC')->sort('created', 'DESC')->range(0, 5)->execute();
  $nodes = \Drupal\node\Entity\Node::loadMultiple($ids);
  $hot = [];
  foreach ($ids as $id) {
    if (isset($nodes[$id])) {
      $hot[] = ['title' => $nodes[$id]->label(), 'url' => $nodes[$id]->toUrl()->toString()];
    }
  }

  // 热门标签
  $tc = $count_by('field_tags');
  arsort($tc);
  $tids = array_slice(array_keys($tc), 0, 12);
  $terms = \Drupal\taxonomy\Entity\Term::loadMultiple($tids);
  $tags = [];
  foreach ($tids as $id) {
    if (isset($terms[$id])) {
      $tags[] = ['name' => $terms[$id]->label(), 'url' => $terms[$id]->toUrl()->toString()];
    }
  }

  return ['cats' => $cats, 'hot' => $hot, 'tags' => $tags];
}

/**
 * 文章列表分页数据。
 */
function xedc_xa_pager($view): array {
  if (!$view || !$view->pager) {
    return [];
  }
  $pager = $view->pager;
  $per = (int) $pager->getItemsPerPage();
  $total = (int) $pager->getTotalItems();
  if ($per < 1 || $total <= $per) {
    return [];
  }
  $last = (int) ceil($total / $per);
  $cur = (int) $pager->getCurrentPage() + 1;
  $q = \Drupal::request()->query->all();
  unset($q['page']);
  $href = function (int $n) use ($q) {
    $p = $q + ($n > 1 ? ['page' => $n - 1] : []);
    return '/articles' . ($p ? '?' . http_build_query($p) : '');
  };
  $win = array_unique(array_filter([1, $cur - 1, $cur, $cur + 1, $last], fn($n) => $n >= 1 && $n <= $last));
  sort($win);
  $items = [];
  $prev = 0;
  foreach ($win as $n) {
    if ($prev && $n - $prev > 1) {
      $items[] = ['gap' => TRUE];
    }
    $items[] = ['n' => $n, 'url' => $href($n), 'active' => $n === $cur];
    $prev = $n;
  }
  return [
    'items' => $items, 'cur' => $cur, 'last' => $last,
    'prev' => $cur > 1 ? $href($cur - 1) : '',
    'next' => $cur < $last ? $href($cur + 1) : '',
  ];
}

/**
 * 文章详情页数据。
 */
function xedc_xa_detail_v1_unused(array &$variables): void {
  $node = $variables['node'];
  $gen = \Drupal::service('file_url_generator');
  $fmt = \Drupal::service('date.formatter');

  // 封面
  $variables['xa_cover'] = '';
  if (!$node->get('field_cover')->isEmpty()) {
    $media = $node->get('field_cover')->entity;
    $file = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->entity : NULL;
    if ($file) {
      $style = \Drupal\image\Entity\ImageStyle::load('xa_hero');
      $url = $style ? $style->buildUrl($file->getFileUri()) : $gen->generateAbsoluteString($file->getFileUri());
      $variables['xa_cover'] = $gen->transformRelative($url);
    }
  }

  // 正文（无标签）+ 阅读时长
  $plain = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('field_body')->value)));
  $variables['xa_read'] = max(1, (int) ceil(mb_strlen(str_replace(' ', '', $plain)) / 400));
  $variables['xa_body'] = $node->get('field_body')->view(['label' => 'hidden']);
  $variables['xa_body']['#cache']['tags'][] = 'node_list';

  $variables['xa_summary'] = trim((string) $node->get('field_summary')->value);
  $variables['xa_source'] = (string) $node->get('field_source')->value;
  $variables['xa_author'] = (string) $node->get('field_author')->value;

  $item = $node->get('field_published_at')->first();
  $ts = ($item && $item->date) ? $item->date->getTimestamp() : $node->getCreatedTime();
  $variables['xa_date'] = $fmt->format($ts, 'custom', 'Y-m-d');
  $n = (int) $node->get('field_views')->value;
  $variables['xa_views'] = $n >= 10000 ? round($n / 10000, 1) . '万' : $n;

  // 分类
  $variables['xa_cat'] = NULL;
  $tid = 0;
  if ($term = $node->get('field_categories')->entity) {
    $tid = (int) $term->id();
    $variables['xa_cat'] = [
      'name' => $term->label(),
      'url' => \Drupal\Core\Url::fromUserInput('/articles', ['query' => ['cat' => $tid]])->toString(),
    ];
  }

  // 标签
  $tags = [];
  foreach ($node->get('field_tags')->referencedEntities() as $t) {
    $tags[] = ['name' => $t->label(), 'url' => $t->toUrl()->toString()];
  }
  $variables['xa_tags'] = $tags;

  // 原文链接
  $variables['xa_source_url'] = '';
  $variables['xa_source_host'] = '';
  if (!$node->get('field_source_url')->isEmpty()) {
    $u = $node->get('field_source_url')->first()->getUrl()->toString();
    $variables['xa_source_url'] = $u;
    $variables['xa_source_host'] = (string) parse_url($u, PHP_URL_HOST);
  }

  // 相关阅读：同分类 4 篇
  $related = [];
  if ($tid) {
    $ids = \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('type', 'article')->condition('status', 1)
      ->condition('field_categories.target_id', $tid)
      ->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')->range(0, 4)->execute();
    foreach (\Drupal\node\Entity\Node::loadMultiple($ids) as $r) {
      $related[] = [
        'title' => $r->label(),
        'url' => $r->toUrl()->toString(),
        'date' => $fmt->format($r->getCreatedTime(), 'custom', 'Y-m-d'),
      ];
    }
  }
  $variables['xa_related'] = $related;
}

// xa-detail-v2
/**
 * 文章详情页数据（v2）。
 */
function xedc_preprocess_node__article__full(array &$variables): void {
  $node = $variables['node'];
  $gen = \Drupal::service('file_url_generator');
  $fmt = \Drupal::service('date.formatter');
  $q = function () {
    return \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('type', 'article')->condition('status', 1);
  };
  $views = function ($n) {
    $n = (int) $n;
    return $n >= 10000 ? round($n / 10000, 1) . '万' : $n;
  };
  $pick = function (array $ids, callable $map) {
    $out = [];
    $nodes = \Drupal\node\Entity\Node::loadMultiple($ids);
    foreach ($ids as $id) {
      if (isset($nodes[$id])) {
        $out[] = $map($nodes[$id]);
      }
    }
    return $out;
  };

  // 封面
  $variables['xa_cover'] = '';
  $variables['xa_cover_width'] = 0;
  $variables['xa_cover_height'] = 0;
  if (!$node->get('field_cover')->isEmpty()) {
    $media = $node->get('field_cover')->entity;
    $file = ($media && $media->hasField('field_media_image')) ? $media->get('field_media_image')->entity : NULL;
    if ($file) {
      $style = \Drupal\image\Entity\ImageStyle::load('xa_hero');
      $url = $style ? $style->buildUrl($file->getFileUri()) : $gen->generateAbsoluteString($file->getFileUri());
      $variables['xa_cover'] = $gen->transformRelative($url);
    }
  }
  // 封面显示开关 + 横竖图判断
  $variables['xa_cover_portrait'] = FALSE;
  if ($node->hasField('field_show_cover') && !$node->get('field_show_cover')->isEmpty() && !(int) $node->get('field_show_cover')->value) {
    $variables['xa_cover'] = '';
  }
  if ($variables['xa_cover'] && ($m = $node->get('field_cover')->entity) && $m->hasField('field_media_image') && !$m->get('field_media_image')->isEmpty()) {
    $iw = (int) $m->get('field_media_image')->width;
    $ih = (int) $m->get('field_media_image')->height;
    if ($iw > 0 && $ih > 0) {
      $variables['xa_cover_width'] = $iw;
      $variables['xa_cover_height'] = $ih;
      $variables['xa_cover_portrait'] = $ih > $iw * 1.15;
    }
  }


  // 正文：过滤器渲染 → 清除空段落 → 图片懒加载
  $item = $node->get('field_body')->first();
  $html = $item ? (string) check_markup((string) $item->value, $item->format ?: NULL) : '';
  $html = preg_replace('#<p(?:\s[^>]*)?>(?:\s|&nbsp;|\x{00A0}|<br\s*/?>)*</p>#iu', '', $html) ?? $html;
  $html = preg_replace('#<img(?![^>]*\sloading=)#i', '<img loading="lazy"', $html) ?? $html;
  $html = preg_replace_callback('#<p(?:\s[^>]*)?>(.*?)</p>#isu', function ($m) {
    if (preg_match('#<(img|video|iframe|audio|picture)#i', $m[1])) { return $m[0]; }
    $t = html_entity_decode(strip_tags($m[1]), ENT_QUOTES | ENT_HTML5, 'UTF-8');
    return preg_replace('/[\s\x{00A0}\x{200B}]+/u', '', $t) === '' ? '' : $m[0];
  }, $html) ?? $html;
  $variables['xa_body'] = [
    '#markup' => \Drupal\Core\Render\Markup::create($html),
    '#cache' => ['tags' => ['node_list']],
  ];
  $plain = trim(preg_replace('/\s+/u', ' ', html_entity_decode(strip_tags($html))));
  $variables['xa_read'] = max(1, (int) ceil(mb_strlen(str_replace(' ', '', $plain)) / 400));

  $variables['xa_summary'] = trim((string) $node->get('field_summary')->value);
  $variables['xa_source'] = (string) $node->get('field_source')->value;
  $variables['xa_author'] = (string) $node->get('field_author')->value;
  $ditem = $node->get('field_published_at')->first();
  $ts = ($ditem && $ditem->date) ? $ditem->date->getTimestamp() : $node->getCreatedTime();
  $variables['xa_date'] = $fmt->format($ts, 'custom', 'Y-m-d');
  $variables['xa_views'] = $views($node->get('field_views')->value);

  // 分类
  $variables['xa_cat'] = NULL;
  $tid = 0;
  if ($term = $node->get('field_categories')->entity) {
    $tid = (int) $term->id();
    $variables['xa_cat'] = [
      'name' => $term->label(),
      'url' => \Drupal\Core\Url::fromUserInput('/articles', ['query' => ['cat' => $tid]])->toString(),
    ];
  }

  // 标签
  $tags = [];
  foreach ($node->get('field_tags')->referencedEntities() as $t) {
    $tags[] = ['name' => $t->label(), 'url' => $t->toUrl()->toString()];
  }
  $variables['xa_tags'] = $tags;

  // 原文链接
  $variables['xa_source_url'] = '';
  $variables['xa_source_host'] = '';
  if (!$node->get('field_source_url')->isEmpty()) {
    $u = $node->get('field_source_url')->first()->getUrl()->toString();
    $variables['xa_source_url'] = $u;
    $variables['xa_source_host'] = (string) parse_url($u, PHP_URL_HOST);
  }

  // 上一篇 / 下一篇
  $created = $node->getCreatedTime();
  $one = function (string $op, string $dir) use ($q, $created) {
    $ids = $q()->condition('created', $created, $op)->sort('created', $dir)->range(0, 1)->execute();
    $n = $ids ? \Drupal\node\Entity\Node::load(reset($ids)) : NULL;
    return $n ? ['title' => $n->label(), 'url' => $n->toUrl()->toString()] : NULL;
  };
  $variables['xa_prev'] = $one('<', 'DESC');
  $variables['xa_next'] = $one('>', 'ASC');

  // 相关阅读（同分类 4 篇）
  $variables['xa_related'] = [];
  if ($tid) {
    $ids = $q()->condition('field_categories.target_id', $tid)->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')->range(0, 4)->execute();
    $variables['xa_related'] = $pick(array_values($ids), function ($n) use ($fmt) {
      return ['title' => $n->label(), 'url' => $n->toUrl()->toString(),
        'meta' => $fmt->format($n->getCreatedTime(), 'custom', 'Y-m-d')];
    });
  }

  // 热门文章（阅读量前 5）
  $ids = $q()->condition('nid', $node->id(), '<>')->sort('field_views', 'DESC')->sort('created', 'DESC')->range(0, 5)->execute();
  $variables['xa_hot'] = $pick(array_values($ids), function ($n) use ($views) {
    return ['title' => $n->label(), 'url' => $n->toUrl()->toString(),
      'meta' => $views($n->get('field_views')->value) . ' 阅读'];
  });
}


if (!class_exists('XedcPhotoGalleryLazy')) {
  class XedcPhotoGalleryLazy implements \Drupal\Core\Security\TrustedCallbackInterface {
    public static function render($children, $element) {
      $index = 0;
      $out = preg_replace_callback('/<img\b[^>]*>/i', static function (array $matches) use (&$index) {
        $index++;
        if ($index === 1) {
          return $matches[0];
        }
        $tag = str_replace('loading="eager"', 'loading="lazy"', $matches[0]);
        return str_replace(' fetchpriority="high"', '', $tag);
      }, $children);
      return is_string($out) ? $out : $children;
    }
    public static function trustedCallbacks() {
      return ['render'];
    }
  }
}
