msgstr "如果安装了cweagans/composer-patches，则必须将其定义为主项目的依赖项（即，它必须列在composer.json的<code>require</code>或<code>require-dev</code>部分中）。您可以在站点根目录中运行以下命令，将其添加为主项目的依赖项："

msgid "Additional trusted composer plugins"
msgstr "其他值得信赖的作曲家插件"

msgid "Trusted composer plugin"
msgstr "值得信赖的作曲家插件"

msgid "Cannot claim the stage because no stage has been created."
msgstr "由于尚未创建任何阶段，因此无法声明该阶段。"

msgid "Cannot claim the stage because it is not owned by the current user or session."
msgstr "无法声明该阶段，因为它不属于当前用户或会话。"

msgid "Cannot claim the stage because the current lock does not match the stored lock."
msgstr "无法声明该阶段，因为当前锁与存储的锁不匹配。"

msgid "This operation has already been applied."
msgstr "该操作已被应用。"

msgid "This operation was canceled by another user."
msgstr "此操作已被另一用户取消。"

msgid "This operation was already canceled."
msgstr "该操作已被取消。"

msgid "<code>@package_name</code>'s requested version @package_version is less stable (@package_stability) than the minimum stability (@minimum_stability) required in @file."
msgstr "<code>@package_name</code> 请求的版本 @package_version 的稳定性 (@package_stability) 低于 @file 所需的最低稳定性 (@minimum_stability)。"

msgid "It cannot be installed by Package Manager."
msgstr "它无法通过包管理器安装。"

msgid "It cannot be removed by Package Manager."
msgstr "程序包管理器无法将其删除。"

msgid "It must be a root dependency."
msgstr "它必须是根依赖项。"

msgid "The <code>composer-exit-on-patch-failure</code> key is not set to <code>true</code> in the <code>extra</code> section of <code>composer.json</code>."
msgstr "<code>composer.json</code> 的 <code>extra</code> 部分中的 <code>composer-exit-on-patch-failure</code> 键未设置为 <code>true</code>。"

msgid "Problems detected related to the Composer plugin <code>@plugin</code>."
msgstr "检测到与 Composer 插件 <code>@plugin</code> 相关的问题。"

msgid "@message See <a href=\":url\">the help page</a> for information on how to resolve the problem."
msgstr "@message 有关如何解决问题的信息，请参阅 <a href=\":url\"> 帮助页面 </a>。"

msgid "Unable to determine Composer <code>allow-plugins</code> setting."
msgstr "无法确定 Composer <code>allow-plugins</code> 设置。"

msgid "All composer plugins are allowed because <code>config.allow-plugins</code> is configured to <code>true</code>. This is an unacceptable security risk."
msgstr "允许所有 Composer 插件，因为 <code>config.allow-plugins</code> 配置为 <code>true</code>。这是不可接受的安全风险。"

msgid "An unsupported Composer plugin was detected."
msgid_plural "Unsupported Composer plugins were detected."
msgstr[0] "检测到不受支持的 Composer 插件。"
msgstr[1] "检测到不支持的 Composer 插件。"

msgid "No content suggestions found. This URL will be used as is."
msgstr "未找到内容建议。该 URL 将按原样使用。"

msgid "Your Drupal site's <code>composer.json</code> file must be valid according to <code>composer validate</code>. See <a href=\":url\">Composer's documentation</a> for more information."
msgstr "根据 <code>composer validate</code>，您的 Drupal 站点的 <code>composer.json</code> 文件必须有效。有关详细信息，请参阅 <a href=\":url\">Composer 文档</a>。"

msgid "Composer must be configured for secure downloads. This means that <a href=\":disable-tls\">the <code>disable-tls</code> option</a> must be <code>false</code>, and <a href=\":secure-http\">the <code>secure-http</code> option</a> must be <code>true</code> in the <code>config</code> section of your <code>composer.json</code> file. If these options are not set in your <code>composer.json</code>, Composer will behave securely by default. To set these values at the command line, run the following commands:"
msgstr "Composer 必须配置为安全下载。这意味着在 <code>composer.json</code> 文件的 <code>config</code> 部分中，<a href=\":disable-tls\"><code>disable-tls</code> 选项</a>必须为 <code>false</code>，并且<a href=\":secure-http\"><code>secure-http</code> 选项</a>必须为 <code>true</code>。如果您的 <code>composer.json</code> 中未设置这些选项，Composer 将默认安全运行。要在命令行设置这些值，请运行以下命令："

msgid "For more information, see the <a href=\":url\">online documentation for the Package Manager module</a>."
msgstr "有关更多信息，请参阅包管理器模块</a> 的<a href=\":url\"> 在线文档。"

msgid "FAQs related to Composer"
msgstr "Composer 相关常见问题解答"

msgid "What if it says the <code>proc_open()</code> function is disabled on your PHP installation?"
msgstr "如果它说您的 PHP 安装中的 <code>proc_open()</code> 功能被禁用怎么办？"

msgid "Ask your system administrator to remove <code>proc_open()</code> from the <a href=\":url\">disable_functions</a> setting in <code>php.ini</code>."
msgstr "请系统管理员从 <code>php.ini</code> 的 <a href=\":url\">disable_functions</a> 设置中删除 <code>proc_open()</code>。"

msgid "What if it says the <code>composer</code> executable cannot be found?"
msgstr "如果提示无法找到 <code>composer</code> 可执行文件怎么办？"

msgid "What if it says the detected version of Composer is not supported?"
msgstr "如果它说不支持检测到的 Composer 版本怎么办？"

msgid "What if it says the <code>composer validate</code> command failed?"
msgstr "如果显示 <code>composer validate</code> 命令失败怎么办？"

msgid "Composer detected problems with your <code>composer.json</code> and/or <code>composer.lock</code> files, and the project is not in a completely valid state. See <a href=\":url\">the Composer documentation</a> for more information."
msgstr "Composer 检测到您的 <code>composer.json</code> 和/或 <code>composer.lock</code> 文件存在问题，并且该项目未处于完全有效的状态。有关详细信息，请参阅<a href=\":url\">Composer 文档</a>。"

msgid "Using rsync"
msgstr "使用rsync"

msgid "Enabling PHP-TUF protection"
msgstr "启用 PHP-TUF 保护"

msgid "Package Manager requires <a href=\":php-tuf\">PHP-TUF</a>, which implements <a href=\":tuf\">The Update Framework</a> as a way to help secure Composer package downloads via the <a href=\":php-tuf-plugin\">PHP-TUF Composer integration plugin</a>. This plugin must be installed and configured properly in order to use Package Manager."
msgstr "包管理器需要 <a href=\":php-tuf\">PHP-TUF</a>，它实现了 <a href=\":tuf\"> 更新框架 </a>，作为通过 <a href=\":php-tuf-plugin\">PHP-TUF Composer 集成插件 </a> 帮助保护 Composer 包下载的一种方式。必须正确安装和配置此插件才能使用包管理器。"

msgid "To install and configure the plugin as needed, you can run the following commands:"
msgstr "要根据需要安装和配置插件，您可以运行以下命令："

msgid "Installation or removal of <code>cweagans/composer-patches</code> via Package Manager is not supported. You can install or remove it manually by running Composer commands in your site root."
msgstr "不支持通过包管理器安装或删除<code>cweagans/composer-patches</code>。您可以通过在站点根目录中运行 Composer 命令来手动安装或删除它。"

msgid "composer.lock not found in @dir."
msgstr "在 @dir 中找不到composer.lock。"

msgid "The detected Composer version, @version, does not satisfy <code>@constraint</code>."
msgstr "检测到的 Composer 版本 @version 不满足 <code>@constraint</code>。"

msgid "<code>@name</code> is supported, but only version <code>@supported_version</code>, found <code>@installed_version</code>."
msgstr "支持<code>@name</code>，但仅支持<code>@supported_version</code>版本，发现<code>@installed_version</code>。"

msgid "Composer cannot be used because the <code>proc_open()</code> function is disabled."
msgstr "由于 <code>proc_open()</code> 功能被禁用，因此无法使用 Composer。"

msgid "Unable to determine Composer <code>@key</code> setting."
msgstr "无法确定 Composer <code>@key</code> 设置。"

msgid "TLS must be enabled for HTTPS Composer downloads."
msgstr "必须为 HTTPS Composer 下载启用 TLS。"

msgid "@message See <a href=\":url\">the help page</a> for more information on how to configure Composer to download packages securely."
msgstr "@message 有关如何配置 Composer 以安全下载软件包的更多信息，请参阅 <a href=\":url\"> 帮助页面 </a>。"

