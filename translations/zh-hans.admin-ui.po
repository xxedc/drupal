msgid "The current date in a custom format. See <a href=\"https://www.php.net/manual/datetime.format.php#refsect1-datetime.format-parameters\">the PHP documentation</a> for details."
msgstr "自定义格式的当前日期。有关详细信息，请参阅 <a href=\"https://www.php.net/manual/datetime.format.php#refsect1-datetime.format-parameters\"> PHP 文档</a>。"

msgid "The current date in 'long' format. (%date)"
msgstr "“长”格式的当前日期。 (%date)"

msgid "The IP address of the current user."
msgstr "当前用户的IP地址。"

msgid "The UUID of the user account."
msgstr "用户帐户的 UUID。"

msgid "Represents the image in the given image style."
msgstr "表示给定图像样式的图像。"

msgid "The MIME type (image/png, image/bmp, etc.) of the image."
msgstr "图像的 MIME 类型（image/png、image/bmp 等）。"

msgid "The URI to the image."
msgstr "图像的 URI。"

msgid "The width of the image, in pixels."
msgstr "图像的宽度，以像素为单位。"

msgid "The file size of the image."
msgstr "图像的文件大小。"

msgid "The URL to the image."
msgstr "图像的 URL。"

msgid "The height the image, in pixels."
msgstr "图像的高度（以像素为单位）。"

msgid "The base name of the file."
msgstr "文件的基本名称。"

msgid "The UUID of the uploaded file."
msgstr "上传文件的UUID。"

msgid "The original @entity data if the @entity is being updated or saved."
msgstr "如果正在更新或保存 @entity，则为原始 @entity 数据。"

msgid "The language of the @entity."
msgstr "@entity 的语言。"

msgid "The path component of the URL."
msgstr "URL 的路径组成部分。"

msgid "The values of the array joined together with a custom string in-between each value."
msgstr "数组的值与每个值之间的自定义字符串连接在一起。"

msgid "The array values each cleaned by Pathauto and then joined with the slash into a string that resembles an URL."
msgstr "每个数组值均由 Pathauto 清理，然后用斜杠连接成类似于 URL 的字符串。"

msgid "The specific value of the array."
msgstr "数组的具体值。"

msgid "The domain name to use for the language."
msgstr "用于该语言的域名。"

msgid "Whether the language is written left-to-right (ltr) or right-to-left (rtl)."
msgstr "语言是从左到右 (ltr) 还是从右到左 (rtl) 书写。"

msgid "The language name."
msgstr "语言名称。"

msgid "Path prefix for URLs in the language."
msgstr "该语言中 URL 的路径前缀。"

msgid "The active content language."
msgstr "活跃的内容语言。"

msgid "The value of a specific query string field of the current page."
msgstr "当前页面的特定查询字符串字段的值。"

msgid "The active user interface language."
msgstr "活动的用户界面语言。"

msgid "The UUID of the content item, or \"node\"."
msgstr "内容项或“节点”的 UUID。"

msgid "The processed URL for this link suitable for using in anchor href attributes."
msgstr "此链接的已处理 URL 适合在锚点 href 属性中使用。"

msgid "The publication status of the node (\"Published\" or \"Unpublished\")."
msgstr "节点的发布状态（“已发布”或“未发布”）。"

msgid "@type field. Also known as %labels."
msgstr "@type 字段。也称为 %labels。"

msgid "The source term for this current term's translation set."
msgstr "当前术语翻译集的源术语。"

msgid "The UUID of the taxonomy term."
msgstr "分类术语的 UUID。"

msgid "The date the taxonomy was most recently updated."
msgstr "分类法最近更新的日期。"

msgid "The menu link's root."
msgstr "菜单链接的根。"

msgid "Tokens related to site language."
msgstr "与站点语言相关的标记。"

msgid "Tokens related to random data."
msgstr "与随机数据相关的令牌。"

msgid "Pattern %label saved."
msgstr "模式 %label 已保存。"

msgid "See <a href=\":pathauto-help\">Pathauto help</a> for details."
msgstr "有关详细信息，请参阅 <a href=\":pathauto-help\">Pathauto 帮助</a>。"

msgid "Maximum length of aliases to generate. 100 is the recommended length. @max is the maximum possible length."
msgstr "要生成的别名的最大长度。 100 是建议的长度。 @max 是最大可能长度。"

msgid "Maximum text length of any component in the alias (e.g., [title]). 100 is the recommended length. @max is the maximum possible length."
msgstr "别名中任何组件的最大文本长度（例如，[title]）。 100 是建议的长度。 @max 是最大可能长度。"

msgid "Considering installing the <a href=\":url\">Redirect module</a> to get redirects when your aliases change."
msgstr "考虑安装 <a href=\":url\">Redirect 模块</a> 以在别名更改时获取重定向。"

msgid "Soft Hyphen"
msgstr "软连字符"

msgid "Enabled entity types"
msgstr "启用的实体类型"

msgid "Enable to add a path field and allow to define alias patterns for the given type. Disabled types already define a path field themselves or currently have a pattern."
msgstr "启用添加路径字段并允许为给定类型定义别名模式。禁用类型本身已经定义了路径字段或当前具有模式。"

msgid "Convert token values to lowercase."
msgstr "将标记值转换为小写。"

msgid "When a pattern includes certain characters (such as those with accents) should Pathauto attempt to transliterate them into the US-ASCII alphabet?"
msgstr "当模式包含某些字符（例如带有重音符号的字符）时，Pathauto 是否应该尝试将它们音译为 US-ASCII 字母表？"

msgid "Safe tokens"
msgstr "安全代币"

msgid "List of tokens that are safe to use in alias patterns and do not need to be cleaned. For example urls, aliases, machine names. Separated with a comma."
msgstr "可在别名模式中安全使用且无需清理的令牌列表。例如 url、别名、机器名称。用逗号分隔。"

msgid "Select the types of paths for which to generate URL aliases"
msgstr "选择要为其生成 URL 别名的路径类型"

msgid "Generate a URL alias for un-aliased paths only"
msgstr "仅为未使用别名的路径生成 URL 别名"

msgid "Update the URL alias for paths having an old URL alias"
msgstr "更新具有旧 URL 别名的路径的 URL 别名"

msgid "Regenerate URL aliases for all paths"
msgstr "为所有路径重新生成 URL 别名"

msgid "Select which URL aliases to generate"
msgstr "选择要生成的 URL 别名"

msgid "Bulk generation can be used to generate URL aliases for items that currently have no aliases. This is typically used when installing Pathauto on a site that has existing un-aliased content that needs to be aliased in bulk."
msgstr "批量生成可用于为当前没有别名的项目生成 URL 别名。当在现有的未别名内容需要批量设置别名的站点上安装 Pathauto 时，通常会使用此方法。"

msgid "It can also be used to regenerate URL aliases for items that have an old alias and for which the Pathauto pattern has been changed."
msgstr "它还可用于为具有旧别名且 Pathauto 模式已更改的项目重新生成 URL 别名。"

msgid "Note that this will only affect items which are configured to have their URL alias automatically set. Items whose URL alias is manually set are not affected."
msgstr "请注意，这只会影响配置为自动设置 URL 别名的项目。手动设置 URL 别名的项目不受影响。"

msgid "Processed @count of @total aliases for %label."
msgstr "已处理 %label 的 @total 别名的 @count。"

msgid "Uncheck this to create a custom alias below. <a href=\"@admin_link\">Configure URL alias patterns.</a>"
msgstr "取消选中此选项可在下面创建自定义别名。 <a href=\"@admin_link\">配置 URL 别名模式。</a>"

msgid "This field supports tokens. @browse_tokens_link"
msgstr "该字段支持令牌。 @browse_tokens_link"

msgid "Success (@status_code)"
msgstr "成功（@status_code）"

msgid "Access denied (@status_code)"
msgstr "访问被拒绝 (@status_code)"

msgid "Page not found (@status_code)"
msgstr "找不到页面 (@status_code)"

msgid "Response status"
msgstr "响应状态"

msgid "Shows the block on pages with any matching response status. If nothing is checked, the block is shown on all pages. Other response statuses are not used."
msgstr "在具有任何匹配响应状态的页面上显示该区块。如果未检查任何内容，则该区块将显示在所有页面上。不使用其他响应状态。"

msgid "Add new comment to %label"
msgstr "添加新评论到 %label"

msgctxt "Day ordinal suffix"
msgid "th"
msgstr "日"

msgid "The field types use different formats to store date and time in the database. All field types can be displayed in various ways."
msgstr "字段类型使用不同的格式在数据库中存储日期和时间。所有字段类型都可以以多种方式显示。"

msgid "Human-readable string format"
msgstr "人类可读的字符串格式"

msgid "Choose either date or date and time"
msgstr "选择日期或日期和时间"

msgid "Examples: 2001-01-15, 2001-01-15T05:28:07"
msgstr "示例：2001-01-15、2001-01-15T05:28:07"

msgid "Date and time stored in seconds since January 1, 1970 (UTC)"
msgstr "自 1970 年 1 月 1 日 (UTC) 以来以秒为单位存储的日期和时间"

msgid "Allowed values: 1901-12-13 to 2038-01-19 03:14:07 UTC"
msgstr "允许的值：1901-12-13 至 2038-01-19 03:14:07 UTC"

msgid "Compact and efficient for storage, sorting and calculations"
msgstr "紧凑、高效的存储、排序和计算"

msgid "Example: 979536485"
msgstr "示例：979536485"

msgid "Leave blank to use the time of form submission."
msgstr "留空以使用表单提交时间。"

msgid "CST"
msgstr "科学技术委员会"

msgid "The field %field has been deleted from the %type %source_label."
msgstr "%field 字段已从 %type %source_label 中删除。"

msgid "Sark"
msgstr "萨克"

msgid "Türkiye"
msgstr "土耳其"

msgid "Displayed images"
msgstr "显示图像"

msgid "Additional configuration: max/min image dimensions; default image, alt text, and title"
msgstr "附加配置：最大/最小图像尺寸；默认图像、替代文本和标题"

msgid "Examples: displayed image (jpeg, png, webp, gif)"
msgstr "示例：显示的图像（jpeg、png、webp、gif）"

msgid "Downloadable files"
msgstr "可下载的文件"

msgid "Configure allowed file extensions, maximum upload size, and storage location"
msgstr "配置允许的文件扩展名、最大上传大小和存储位置"

msgid "Examples: document (pdf, txt), audio (mp3), video (avi, mov), downloadable image (jpeg, png, webp, gif), etc."
msgstr "示例：文档（pdf、txt）、音频（mp3）、视频（avi、mov）、可下载图像（jpeg、png、webp、gif）等。"

msgid "Minimum image dimensions"
msgstr "最小图像尺寸"

msgid "The UploadProgress PHP extension must be enabled to configure the progress indicator. Check the <a href=\":status\">status report</a> for more information."
msgstr "必须启用 UploadProgress PHP 扩展才能配置进度指示器。检查 <a href=\":status\"> 状态报告</a> 了解更多信息。"

msgid "Colorbox Responsive"
msgstr "彩盒响应式"

msgid "Adds access permissions on all actions allowing admins to restrict access on a per-role basis."
msgstr "添加对所有操作的访问权限，允许管理员按角色限制访问。"

msgid "Adds an ability to perform bulk operations on selected entities from view results."
msgstr "添加对从视图结果中选定的实体执行批量操作的功能。"

msgid "You must install the following module to install @module:"
msgid_plural "You must install the following modules to install @module:"
msgstr[0] "您必须安装以下模块才能安装 @module："
msgstr[1] "您必须安装以下模块才能安装 @module："

msgid "Some required modules must be installed"
msgstr "必须安装一些必需的模块"

msgid "Module %name has been installed."
msgid_plural "@count modules have been installed: %names."
msgstr[0] "模块 %name 已安装。"
msgstr[1] "已安装 @count 模块：%names。"

msgid "Delete selected entities / translations"
msgstr "删除选定的实体/翻译"

msgid "Update URL alias of an entity"
msgstr "更新实体的 URL 别名"

msgid "Provides a user interface for per-module and site-wide mail_system selection."
msgstr "为每个模块和站点范围的邮件系统选择提供用户界面。"

msgid "Global Mail System configuration."
msgstr "全球邮件系统配置。"

msgid "Mail System"
msgstr "邮件系统"

msgid "Default PHP Mailer"
msgstr "默认 PHP 邮件程序"

msgid "Symfony mailer (Experimental)"
msgstr "Symfony 邮件程序（实验）"

msgid "Select the standard plugin for formatting an email before sending it. This plugin implements <a href=\":interface\">@interface</a> and in special the <a href=\":format\">@format</a> function."
msgstr "在发送之前选择用于格式化电子邮件的标准插件。该插件实现了<a href=\":interface\">@interface</a>，特别是<a href=\":format\">@format</a>功能。"

msgid "Select the standard plugin for sending an email after formatting it. This plugin implements <a href=\":interface\">@interface</a> and in special the <a href=\":mail\">@mail</a> function."
msgstr "选择用于格式化电子邮件后发送电子邮件的标准插件。该插件实现了<a href=\":interface\">@interface</a>，特别是<a href=\":mail\">@mail</a>功能。"

msgid "Theme to render the emails"
msgstr "呈现电子邮件的主题"

msgid "Select the theme that will be used to render emails which are configured for this. This can be either the current theme, the default theme, the domain theme or any active theme."
msgstr "选择将用于呈现为此配置的电子邮件的主题。这可以是当前主题、默认主题、域主题或任何活动主题。"

msgid "Default Mail System"
msgstr "默认邮件系统"

msgid "The key is used to identify specific mails if the module sends more than one. Leave empty to use the configuration for all mails sent by the selected module."
msgstr "如果模块发送多封邮件，则该密钥用于识别特定邮件。留空可对所选模块发送的所有邮件使用该配置。"

msgid "- Default -"
msgstr "- 默认 -"

msgid "Formatter plugin"
msgstr "格式化插件"

msgid "Sender plugin"
msgstr "发件人插件"

msgid "No specific configuration yet."
msgstr "目前还没有具体的配置。"

msgid "Module-specific configuration"
msgstr "模块特定配置"

msgid "Configure the Mail System"
msgstr "配置邮件系统"

msgid "The configuration has been added."
msgstr "配置已添加。"

msgid "Allow for site emails to be sent through an SMTP server of your choice."
msgstr "允许通过您选择的 SMTP 服务器发送站点电子邮件。"

msgid "SMTP module is managed by <a href=\":mailsystem\">the mail system module</a>"
msgstr "SMTP模块由<a href=\":mailsystem\">邮件系统模块</a>管理"

msgid "Log level"
msgstr "日志级别"

msgid "Choose the appropriate log level. When set to Debug, SMTP debugging will be enabled."
msgstr "选择适当的日志级别。当设置为“调试”时，将启用 SMTP 调试。"

msgid "Client (1) - Output messages sent by the client"
msgstr "客户端 (1) - 输出客户端发送的消息"

msgid "Server (2) - Client messages plus server responses (most useful)"
msgstr "服务器 (2) - 客户端消息加上服务器响应（最有用）"

msgid "Connection (3) - Server level plus connection details (helps diagnose STARTTLS failures)"
msgstr "连接 (3) - 服务器级别加上连接详细信息（帮助诊断 STARTTLS 故障）"

msgid "Low level (4) - Connection level plus very verbose low-level information (only for low-level problems)"
msgstr "低级 (4) - 连接级别加上非常详细的低级信息（仅适用于低级问题）"

msgid "Debug level"
msgstr "调试级别"

msgid "Choose the appropriate debug verbosity level. Higher numbers are more verbose. Level 2 is recommended for most debugging. This only applies when log level is set to Debug."
msgstr "选择适当的调试详细级别。数字越大越详细。对于大多数调试，建议使用级别 2。仅当日志级别设置为“调试”时才适用。"

msgid "The address of your outgoing SMTP backup server. If the primary server cannot be found this one will be tried. This is optional."
msgstr "您的发送 SMTP 备份服务器的地址。如果找不到主服务器，将尝试此服务器。这是可选的。"

msgid "The default SMTP port is 25, if that is being blocked try 80. Gmail uses 465. See :url for more information on configuring for use with Gmail."
msgstr "默认 SMTP 端口为 25，如果被阻止，请尝试 80。Gmail 使用 465。有关配置与 Gmail 一起使用的详细信息，请参阅 :url。"

msgid "Enable TLS encryption automatically"
msgstr "自动启用 TLS 加密"

msgid "Automatically enables TLS encryption if the server supports it, even when protocol is set to \"standard\". Enable this for modern email providers (Gmail, Office365). Disable this for basic mail relays on port 25 without encryption or authentication."
msgstr "如果服务器支持，即使协议设置为“标准”，也会自动启用 TLS 加密。为现代电子邮件提供商（Gmail、Office365）启用此功能。对于端口 25 上的基本邮件中继禁用此功能，无需加密或身份验证。"

msgid "Amount of seconds for the SMTP commands to timeout."
msgstr "SMTP 命令超时的秒数。"

msgid "Turn on the SMTP keep alive feature"
msgstr "打开 SMTP 保持活动功能"

msgid "Enabling this option will keep the SMTP connection open instead of it being openned and then closed for each mail"
msgstr "启用此选项将使 SMTP 连接保持打开状态，而不是为每封邮件先打开然后关闭"

msgid "SMTP password. If you have already entered your password before, you should leave this field blank, unless you want to change the stored password. Please note that this password will be stored as plain-text inside Drupal's core configuration variables."
msgstr "SMTP 密码。如果您之前已经输入过密码，则应将此字段留空，除非您想更改存储的密码。请注意，该密码将以纯文本形式存储在 Drupal 的核心配置变量中。"

msgid "The name that all e-mails will be from. If left blank will use a default of: @name . Some providers (such as Office365) may ignore this field. For more information, please check SMTP module documentation and your email provider documentation."
msgstr "所有电子邮件的发件人名称。如果留空，将使用默认值： @name 。某些提供商（例如 Office365）可能会忽略此字段。有关更多信息，请查看 SMTP 模块文档和您的电子邮件提供商文档。"

msgid "E-mail address to reroute all emails to"
msgstr "将所有电子邮件重新路由至的电子邮件地址"

msgid "All emails sent by the site will be rerouted to this email address; use with caution."
msgstr "该网站发送的所有电子邮件将被重新路由至该电子邮件地址；谨慎使用。"

msgid "Allow to send e-mails formatted as HTML"
msgstr "允许发送 HTML 格式的电子邮件"

msgid "Checking this box will allow HTML formatted e-mails to be sent with the SMTP protocol."
msgstr "选中此框将允许使用 SMTP 协议发送 HTML 格式的电子邮件。"

msgid "The hostname to use in the Message-Id and Received headers, and as the default HELO string. Leave blank for using %server_name."
msgstr "在 Message-Id 和 Received 标头中使用的主机名，并作为默认 HELO 字符串。留空以使用 %server_name。"

msgid "HELO"
msgstr "直升机"

msgid "The SMTP HELO/EHLO of the message. Defaults to hostname (see above)."
msgstr "邮件的 SMTP HELO/EHLO。默认为主机名（见上文）。"

msgid "SMTP client settings"
msgstr "SMTP 客户端设置"

msgid "All settings can be overridden in your settings.php file for environment-specific configurations. See <a href=\":settings-override\">Overriding SMTP configuration via settings.php</a> for details."
msgstr "对于特定于环境的配置，可以在 settings.php 文件中覆盖所有设置。有关详细信息，请参阅<a href=\":settings-override\">通过 settings.php 覆盖 SMTP 配置</a>。"

msgid "Test"
msgstr "测试"

msgid "The system.mail was overridden to use SMTPMailSystem for this request only."
msgstr "system.mail 已被覆盖，仅将 SMTPMailSystem 用于此请求。"

msgid "A test e-mail has been sent to @email via SMTP. You may want to check the log for any error messages."
msgstr "测试电子邮件已通过 SMTP 发送至 @email。您可能需要检查日志中是否有任何错误消息。"

msgid "SMTP Mailer"
msgstr "SMTP 邮件程序"

msgid "PHP documentation"
msgstr "PHP 文档"

msgid "Enable SMTP advanced settings"
msgstr "启用 SMTP 高级设置"

msgid "Peer name"
msgstr "同行姓名"

msgid "Peer name to be used. If this value is not set, then the name is guessed based on the hostname used when opening the stream."
msgstr "要使用的对等名称。如果未设置此值，则会根据打开流时使用的主机名猜测名称。"

msgid "Verify peer"
msgstr "验证对等点"

msgid "Require verification of SSL certificate used."
msgstr "需要验证所使用的 SSL 证书。"

msgid "Verify peer name"
msgstr "验证对等名称"

msgid "Require verification of peer name."
msgstr "需要验证对等名称。"

msgid "Allow self signed"
msgstr "允许自签名"

msgid "Allow self-signed certificates. Requires verify_peer."
msgstr "允许自签名证书。需要 verify_peer。"

msgid "CA file"
msgstr "CA文件"

msgid "Location of Certificate Authority file on local filesystem which should be used with the verify_peer context option to authenticate the identity of the remote peer."
msgstr "本地文件系统上的证书颁发机构文件的位置，应与 verify_peer 上下文选项一起使用来验证远程对等点的身份。"

msgid "CA path"
msgstr "CA路径"

msgid "If cafile is not specified or if the certificate is not found there, the directory pointed to by capath is searched for a suitable certificate. capath must be a correctly hashed certificate directory."
msgstr "如果未指定 cafile 或未在其中找到证书，则会在 capath 指向的目录中搜索合适的证书。 capath 必须是正确散列的证书目录。"

msgid "Local certificate"
msgstr "本地证书"

msgid "Path to local certificate file on filesystem. It must be a PEM encoded file which contains your certificate and private key. It can optionally contain the certificate chain of issuers. The private key also may be contained in a separate file specified by local_pk."
msgstr "文件系统上本地证书文件的路径。它必须是包含您的证书和私钥的 PEM 编码文件。它可以选择包含颁发者的证书链。私钥也可以包含在由 local_pk 指定的单独文件中。"

msgid "Local private key"
msgstr "本地私钥"

msgid "Path to local private key file on filesystem in case of separate files for certificate (local_cert) and private key."
msgstr "如果证书 (local_cert) 和私钥有单独的文件，则文件系统上本地私钥文件的路径。"

msgid "Passphrase"
msgstr "密码"

msgid "Passphrase with which your local_cert file was encoded."
msgstr "local_cert 文件编码所用的密码。"

msgid "Verify depth"
msgstr "验证深度"

msgid "Abort if the certificate chain is too deep."
msgstr "如果证书链太深则中止。"

msgid "SNI enabled"
msgstr "SNI 已启用"

msgid "If set to true server name indication will be enabled. Enabling SNI allows multiple certificates on the same IP address."
msgstr "如果设置为 true，将启用服务器名称指示。启用 SNI 允许同一 IP 地址上有多个证书。"

msgid "SSL"
msgstr "SSL协议"

msgid "More information can be found at @link."
msgstr "更多信息请访问 @link。"

msgid "Socket bind to"
msgstr "套接字绑定到"

msgid "Used to specify the IP address (either IPv4 or IPv6) and/or the port number that PHP will use to access the network. The syntax is ip:port for IPv4 addresses, and [ip]:port for IPv6 addresses. Setting the IP or the port to 0 will let the system choose the IP and/or port."
msgstr "用于指定 PHP 将用于访问网络的 IP 地址（IPv4 或 IPv6）和/或端口号。对于 IPv4 地址，语法为 ip:port；对于 IPv6 地址，语法为 [ip]:port。将 IP 或端口设置为 0 将让系统选择 IP 和/或端口。"

msgid "Socket"
msgstr "插座"

msgid "SMTP Advanced Settings"
msgstr "SMTP 高级设置"

msgid "For more informatien see <a href=\":settings-override\">Context options and parameters</a> for details."
msgstr "有关详细信息，请参阅 <a href=\":settings-override\">Context 选项和参数</a>。"

msgid "Execute the %action action on %type."
msgstr "在 %type 上执行 %action 操作。"

msgid "all entity types"
msgstr "所有实体类型"

msgid "Administer Mail System"
msgstr "管理邮件系统"

msgid "The list of available tokens that can be used in e-mails is provided below."
msgstr "下面提供了可在电子邮件中使用的可用令牌的列表。"

msgid "Disable <span class=\"visually-hidden\">(@view_mode)</span>"
msgstr "禁用<span class=\"visually-hidden\">(@view_mode)</span>"

msgid "The %view_mode view mode has been enabled."
msgstr "%view_mode 查看模式已启用。"

msgid "Let users register with a password on the registration form when verification mail is required."
msgstr "当需要验证邮件时，让用户使用注册表上的密码进行注册。"

msgid "[user:display-name],\r\n\r\nThank you for registering at [site:name]. You may now log in and verify your account by clicking this link or copying and pasting it to your browser:\r\n\r\n[user:registrationpassword-url]\r\n\r\nThis link can only be used once. You will be able to log in at [site:login-url] in the future using:\r\n\r\nusername: [user:name]\r\npassword: your password\r\n\r\n--  [site:name] team"
msgstr "[user:display-name],\r\n\r\n感谢您在 [site:name] 注册。您现在可以通过单击此链接或将其复制并粘贴到您的浏览器来登录并验证您的帐户：\r\n\r\n[user:registrationpassword-url]\r\n\r\n该链接只能使用一次。您将来将能够使用以下方式登录 [site:login-url]：\r\n\r\n用户名：[user:name]\r\n密码：您的密码\r\n\r\n——[site:name]团队"

msgid "Edit the welcome email messages sent to new members upon registering, when no administrator approval is required and password has already been set."
msgstr "当不需要管理员批准且密码已设置时，编辑注册时发送给新会员的欢迎电子邮件。"

msgid "Available variables are: [site:name], [site:url], [user:display-name], [user:account-name], [user:mail], [site:login-url], [site:url-brief], [user:edit-url], [user:one-time-login-url], [user:cancel-url], [user:registrationpassword-url]."
msgstr "可用变量有：[site:name]、[site:url]、[user:display-name]、[user:account-name]、[user:mail]、[site:login-url]、[site:url-brief]、[user:edit-url]、[user:one-time-login-url]、[user:cancel-url]、[user:registrationpassword-url]。"

msgid "Do not require a verification email, and let users set their password on the registration form."
msgstr "不需要验证电子邮件，并让用户在注册表上设置密码。"

msgid "Require a verification email, but wait for the approval email to let users set their password."
msgstr "需要验证电子邮件，但等待批准电子邮件让用户设置密码。"

msgid "Require a verification email, but let users set their password directly on the registration form."
msgstr "需要验证电子邮件，但让用户直接在注册表上设置密码。"

msgid "Choose whether new users can set their password directly on the registration form and login during registration (without email confirmation), or if they will be required to validate their email address prior to logging into the site, and will be assigned a system-generated password, or they can set a password during registration, but first have to confirm their account via the activation email sent after registration is complete, before they can log in to the site."
msgstr "选择新用户是否可以直接在注册表上设置密码并在注册期间登录（无需电子邮件确认），或者是否需要在登录网站之前验证其电子邮件地址，并分配一个系统生成的密码，或者他们可以在注册期间设置密码，但首先必须通过注册完成后发送的激活电子邮件确认其帐户，然后才能登录网站。"

msgid "Path to redirect the user to after confirming their account"
msgstr "确认帐户后将用户重定向到的路径"

msgid "The redirection path must be relative and start with a slash, it can include user tokens.  Example: /user/[user:uid]/edit"
msgstr "重定向路径必须是相对路径并以斜杠开头，它可以包含用户令牌。  示例：/user/[user:uid]/edit"

msgid "Enable Account activation link expiration"
msgstr "启用帐户激活链接过期"

msgid "This option enables site admins to expire activation links after the expiration time has passed. People are still able to request a new activation email via the password reset form after this time expires to activate their account via a new activation email."
msgstr "此选项使站点管理员能够在过期时间过后使激活链接失效。在此时间到期后，人们仍然可以通过密码重置表单请求新的激活电子邮件，以通过新的激活电子邮件激活其帐户。"

msgid "Account activation link expiration"
msgstr "帐户激活链接过期"

msgid "Enter the expiration time for the activation link (aka first time login link) sent in the activation email. The default is set to 86400 seconds (= 24 hours)."
msgstr "输入激活电子邮件中发送的激活链接（也称为首次登录链接）的过期时间。默认设置为 86400 秒（= 24 小时）。"

msgid "Welcome (no approval required, password is set)"
msgstr "欢迎（无需批准，已设置密码）"

msgid "Registration password URL"
msgstr "注册密码网址"

msgid "You have just used your one-time login link. Your account is now active and you are authenticated."
msgstr "您刚刚使用了一次性登录链接。您的帐户现已激活并且您已通过身份验证。"

msgid "You have used a one-time login link. You can set your new password now."
msgstr "您使用了一次性登录链接。您现在可以设置新密码。"

