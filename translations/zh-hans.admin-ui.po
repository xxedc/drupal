msgstr "隐藏主页"

msgid "@items disabled"
msgstr "@items 已禁用"

msgid "Universal web tracking opt-out enabled"
msgstr "启用通用网络跟踪选择退出"

msgid "Cookies disabled"
msgstr "禁用 Cookie"

